msgid "Close ZinTerm?"
msgstr "确定关闭 ZinTerm?"

msgid "There are active sessions. Closing will disconnect them."
msgstr "当前有活动会话,关闭将断开它们。"

msgid "Delete the checked items? This cannot be undone."
msgstr "删除选中的多个项目?此操作不可撤销。"

msgid "Delete this group? Nested groups and sessions inside will also be removed. This cannot be undone."
msgstr "确定删除该分组？其下的子分组和会话也会一并删除，此操作不可撤销。"

msgid "Delete this session? This cannot be undone."
msgstr "确定删除该会话？此操作不可撤销。"

msgid "Confirm multi-line paste"
msgstr "确认多行粘贴"

msgid "The clipboard contains line breaks and may execute multiple commands. Review it before pasting."
msgstr "剪贴板内容包含换行，粘贴后可能连续执行多个命令，请确认内容后再继续。"

msgid "Restore defaults"
msgstr "恢复默认设置"

msgid "Clear all remembered SSH host keys? The next connection to each host will ask you to trust the key again."
msgstr "确定清除所有已记住的 SSH 主机公钥？下次连接各主机时会再次要求确认信任。"

msgid "Clear every saved password, private-keys? This cannot be undone."
msgstr "确定清除所有已保存的密码、私钥？此操作不可撤销。"

msgid "Restore settings preferences to defaults? Saved sessions, commands, passwords, private-keys, and SSH known hosts which are not in the settings interface will be kept."
msgstr "确定将设置相关偏好恢复为默认值？设置界面以外的已保存连接、命令、密码、私钥和 SSH 已知主机公钥会保留。"

msgid "Delete every saved group and session? This cannot be undone. Open tabs stay open."
msgstr "确定删除全部已保存的分组和会话？此操作不可撤销。已打开的标签页不会关闭。"

msgid "Also clear saved passwords / private keys"
msgstr "同时清除已保存的密码/私钥"

