msgid "DATA"
msgstr "数据"

msgid "Save passwords / private-keys"
msgstr "保存密码/私钥"

msgid "Unavailable: OS keyring cannot store the vault master key."
msgstr "不可用：系统钥匙串无法保存凭证库主密钥。"

msgid "When on, passwords and private keys are stored in an encrypted vault (OS keyring master key). Turning this off does not clear credentials already saved."
msgstr "开启后密码与私钥写入加密凭证库(主密钥在系统钥匙串)。关闭此选项不会清除已保存的内容。"

msgid "Clear saved passwords / private-keys"
msgstr "清除所有保存的密码/私钥"

msgid "Remove every stored password, private-keys from saved sessions."
msgstr "清除所有已保存会话中的密码、私钥。"

msgid "Clear SSH known hosts"
msgstr "清除 SSH 已知主机公钥"

msgid "Forget remembered server host keys. The next connection to each host will ask you to trust the key again."
msgstr "清除已记住的服务器主机公钥。下次连接各主机时会再次要求确认信任。"

msgid "Clear all groups and sessions"
msgstr "清除所有分组和会话"

msgid "Permanently delete every saved Quick Connect group and session. Open tabs are not closed. You can choose whether to also clear saved passwords / private keys."
msgstr "永久删除全部已保存的快速连接分组和会话。已打开的标签页不会关闭。可选择是否同时清除已保存的密码/私钥。"

msgid "Restore default settings"
msgstr "恢复默认设置"

msgid "Reset settings preferences to defaults (including SSH/SFTP algorithms). Saved groups, sessions, commands, passwords, private-keys, and SSH known hosts are kept."
msgstr "将设置相关偏好恢复为默认值（含 SSH/SFTP 算法）。已保存的分组、会话、命令、密码、私钥和 SSH 已知主机公钥不会被清除。"

msgid "FONT"
msgstr "字体"

msgid "Terminal font"
msgstr "终端字体"

msgid "Terminal font size"
msgstr "终端字体大小"

msgid "Terminal line spacing"
msgstr "终端行距"

msgid "Adjust terminal row height from compact to loose."
msgstr "调整终端行高，可设置得更紧凑或更宽松。"

msgid "Installed fonts"
msgstr "已安装字体"

msgid "Install a TTF/OTF font in Windows, then restart ZinTerm to refresh this list."
msgstr "在 Windows 中安装 TTF/OTF 字体后，重启 ZinTerm 即可刷新字体列表。"

msgid "Bold terminal text"
msgstr "终端字体加粗"

msgid "Makes regular terminal output use a bold face."
msgstr "让普通终端输出使用加粗字重。"

msgid "Cursor shape"
msgstr "光标类型"

msgid "Choose the terminal insertion cursor shape."
msgstr "选择终端输入光标的形状。"

msgid "Block"
msgstr "块状"

msgid "Bar"
msgstr "竖线"

msgid "Line"
msgstr "下划线"

msgid "Cursor color"
msgstr "光标颜色"

msgid "Enter a hexadecimal RGB color."
msgstr "输入十六进制 RGB 颜色。"

msgid "UI scale"
msgstr "界面缩放"

msgid "Zooms the whole interface (not this panel)."
msgstr "缩放整个界面(不影响本面板)。"

msgid "Settings font size"
msgstr "界面字体大小"

msgid "Enlarges this settings panel (font + window)."
msgstr "放大本设置面板的字体和窗口。"

msgid "PREVIEW"
msgstr "预览"

msgid "INPUT"
msgstr "输入"

msgid "Confirm multiline paste"
msgstr "确认多行粘贴"

msgid "Show a review dialog before sending multiline content."
msgstr "发送多行内容前显示预览确认窗口。"

msgid "Select to copy / right-click paste"
msgstr "选中复制/右键粘贴"

msgid "Auto-copy selected text; right-click pastes. When off, the right-click context menu is used instead."
msgstr "选中文字自动复制到剪贴板；右键粘贴。关闭后恢复右键上下文菜单。"

msgid "Additional paste shortcuts"
msgstr "额外粘贴快捷键"

msgid "Enable Ctrl+Alt+V, Shift+Insert, and middle-click paste."
msgstr "启用 Ctrl+Alt+V、Shift+Insert 和鼠标中键粘贴。"

msgid "LANGUAGE"
msgstr "语言"

msgid "Interface language"
msgstr "界面语言"

msgid "Auto follows the system language. Systems that are neither Chinese nor English use English."
msgstr "自动跟随系统语言。系统既非中文也非英文时使用英文。"

msgid "Chinese"
msgstr "中文"

msgid "English"
msgstr "英文"

msgid "OUTPUT HIGHLIGHTING"
msgstr "输出高亮"

msgid "Highlight plain terminal output"
msgstr "高亮纯文本终端输出"

msgid "Adds client-side colours only when the program did not provide ANSI styling."
msgstr "仅在程序未提供 ANSI 样式时由客户端补充颜色。"

msgid "Built-in rule set"
msgstr "内置规则集"

msgid "Log levels is conservative; DevOps also recognises deployment and health states."
msgstr "日志级别更保守；DevOps 还识别部署与健康状态。"

msgid "Log levels"
msgstr "日志级别"

msgid "Format and colour JSON lines"
msgstr "格式化并着色 JSON 行"

msgid "Pretty-prints only complete JSON objects or arrays that occupy a whole terminal line. Other output is unchanged."
msgstr "仅美化占据完整一行且可正确解析的 JSON 对象或数组，其他终端输出保持原样。"

msgid "CUSTOM RULES"
msgstr "自定义规则"

msgid "Custom rules run before the built-in preset and never overwrite ANSI colours."
msgstr "自定义规则优先于内置规则，且不会覆盖程序输出的 ANSI 颜色。"

msgid "Timeout errors"
msgstr "超时错误"

msgid "Regex"
msgstr "正则"

msgid "Case sensitive"
msgstr "区分大小写"

msgid "Whole line"
msgstr "高亮整行"

msgid "Add rule"
msgstr "添加规则"

msgid "No custom rules yet."
msgstr "暂无自定义规则。"

msgid "Keyword"
msgstr "关键词"

msgid " · whole line"
msgstr " · 整行"

msgid "RENDERING"
msgstr "渲染"

msgid "Renderer"
msgstr "渲染器"

msgid "CPU is the compatibility default. FemtoVG and Skia use GPU acceleration."
msgstr "CPU 是兼容性默认渲染器；FemtoVG 和 Skia 使用 GPU 加速。"

msgid "Auto tries GPU acceleration and lets Slint fall back to software. Software is best for VMs and compatibility."
msgstr "自动模式会尝试 GPU 加速，并由 Slint 在初始化失败时回退到软件渲染；虚拟机或兼容性优先时请选择软件。"

msgid "Automatic"
msgstr "自动"

msgid "Software"
msgstr "软件"

msgid "Restart ZinTerm to apply the renderer change."
msgstr "重启 ZinTerm 后渲染器设置才会生效。"

msgid "SIDEBARS"
msgstr "侧栏"

msgid "Zen mode"
msgstr "专注模式"

msgid "Hide side panels and collapsed edge strips so the terminal fills the window."
msgstr "隐藏侧栏、底栏和收起图标，让终端填满窗口内容区。"

msgid "Collapse the SFTP panel by default"
msgstr "默认收起 SFTP 侧栏"

msgid "Takes effect on next launch; handy on low-spec jump hosts."
msgstr "下次启动生效;低配跳板机上可减少常驻面板开销。"

msgid "Quick commands as a sidebar"
msgstr "快捷命令作为侧栏"

msgid "Allows the quick-command popup to be dragged to a window edge. After docking, use the sidebar or its collapsed icon."
msgstr "允许把快捷命令弹窗拖到窗口边缘；停靠后通过侧栏或收起图标使用。"

msgid "WELCOME PAGE"
msgstr "欢迎页"

msgid "Show the welcome page as a sidebar"
msgstr "欢迎页设为侧栏"

msgid "Dock the session list on the left instead of a \"Welcome page\" tab; opened sessions fill the center."
msgstr "把会话列表停靠在左侧,不再用「欢迎页」标签;打开的会话占据中央区域。"

msgid "Confirm before deleting a group"
msgstr "删除分组前确认"

msgid "Ask before removing a group (also deletes nested groups and sessions inside)."
msgstr "删除分组前弹出确认（会一并删除其下的子分组和会话）。"

msgid "Confirm before deleting a session"
msgstr "删除会话前确认"

msgid "Ask before removing a saved session from the list."
msgstr "从列表删除已保存的会话前弹出确认。"

msgid "Single-click to connect"
msgstr "单击会话连接"

msgid "Connect with one click. When off, double-click a session to connect."
msgstr "开启后单击会话即可连接；关闭时需双击连接。"

msgid "Keepalive interval"
msgstr "保活间隔"

msgid "0 disables keepalive. A positive value is the interval in seconds. Some older switches drop OpenSSH keepalive packets — leave this at 0 for those devices. Applies to new connections."
msgstr "0 表示关闭。正整数为间隔秒数。部分老旧交换机可能因 OpenSSH keepalive 断开，此类设备请保持为 0。对新连接生效。"

msgid "SSH ALGORITHMS"
msgstr "SSH 算法"

msgid "Choose which algorithms are offered (order = preference). Leaving the built-in defaults enables an automatic compact retry for very old devices. Custom lists are applied strictly. Takes effect on new connections."
msgstr "勾选要协商的算法（顺序即优先级）。保持内置默认时，会对极老设备自动尝试精简兼容配置；自定义后严格按所选列表协商。对新连接生效。"

msgid "Category"
msgstr "算法类别"

msgid "Key exchange, host key, cipher, MAC, or compression."
msgstr "密钥交换、主机密钥、加密、消息认证码或压缩。"

msgid "Reset"
msgstr "重置"

msgid "Restore this category or every algorithm list to the built-in defaults."
msgstr "将当前类别或全部算法恢复为内置默认。"

msgid "This category"
msgstr "当前类别"

msgid "All defaults"
msgstr "全部默认"

msgid "weak"
msgstr "不安全"

msgid "SFTP follows terminal cd"
msgstr "SFTP 跟随 cd 更新"

msgid "A cd in the terminal switches the SFTP panel to the same directory."
msgstr "终端里执行 cd 时,SFTP 面板自动切到相同目录。"

msgid "Always ask where to save"
msgstr "总是询问保存去何处"

msgid "Every SFTP download prompts for a location instead of using the preset folder."
msgstr "每次 SFTP 下载都询问保存位置,而不是直接存到预设下载目录。"

msgid "UPDATE CHECK"
msgstr "新版本提示"

msgid "Check for new versions on startup"
msgstr "启动时检查新版本"

msgid "Off: ZinTerm no longer queries GitHub for releases and the update banner won't appear (takes effect next launch)."
msgstr "关闭后:不再向 GitHub 查询新版本,也不会弹出更新提示(下次启动生效)。"

msgid "WALLPAPER"
msgstr "壁纸"

msgid "Pick a wallpaper — the interface tints itself to match (accent, panels, light/dark)."
msgstr "选一张壁纸,界面会沉浸式地适配它的颜色(强调色、面板、深浅)。"

