import { Theme } from "theme.slint";
import { ScrollView, ComboBox } from "std-widgets.slint";

// --- TooltipSurface --------------------------------------------------------
// Opaque tooltip chrome (PopupWindow content). Uses `tooltip-bg`, not frosted
// `bg-elevated`, so text stays readable over busy UI underneath.
export component TooltipSurface inherits Rectangle {
    in property <string> text;
    in property <length> pad-x: 8px;

    width: tip-txt.preferred-width + root.pad-x * 2;
    height: 22px;
    background: Theme.tooltip-bg;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000088;

    tip-txt := Text {
        text: root.text;
        color: Theme.text-primary;
        font-family: Theme.ui-font-family;
        font-size: Theme.fs-xs;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: parent.width;
        height: parent.height;
    }
}

// --- TooltipPopup ----------------------------------------------------------
// PopupWindow tooltip — renders above all in-window layers. Prefers below the
// anchor; flips above only when the tooltip would extend past the window bottom.
export component TooltipPopup inherits PopupWindow {
    in property <string> text;
    in property <length> anchor-width;
    in property <length> anchor-height;
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <bool> align-right: true;
    // When set, left edge starts at cursor-x (relative to the anchor) and the
    // tip extends rightward; still clamped so it stays inside the window.
    in property <bool> from-cursor: false;
    in property <length> cursor-x: 0px;
    in property <length> gap: 4px;

    close-policy: no-auto-close;

    property <length> tip-h: 22px;
    property <bool> flip-above:
        root.anchor-y + root.anchor-height + root.gap + root.tip-h > Theme.window-height;

    width: surface.width;
    height: surface.height;
    property <length> x-preferred: root.from-cursor ? root.cursor-x
        : (root.align-right ? (root.anchor-width - self.width) : 0px);
    x: max(-root.anchor-x, min(root.x-preferred, Theme.window-width - self.width - root.anchor-x));
    y: root.flip-above ? (-self.height - root.gap) : (root.anchor-height + root.gap);

    surface := TooltipSurface {
        text: root.text;
        height: root.tip-h;
    }
}

// --- TooltipArea -----------------------------------------------------------
// Full-size TouchArea that owns a TooltipPopup. Opens after a short hover delay;
// closes immediately when the pointer leaves the anchor.
export component TooltipArea inherits TouchArea {
    in property <string> tooltip-text;
    in property <length> anchor-width;
    in property <length> anchor-height;
    in property <duration> show-delay: 400ms;
    // Anchor the tip at the pointer's x and grow it rightward (session rows).
    in property <bool> tip-from-cursor: false;
    callback activate();

    tip-popup := TooltipPopup {
        text: root.tooltip-text;
        anchor-width: root.anchor-width;
        anchor-height: root.anchor-height;
        anchor-x: parent.absolute-position.x;
        anchor-y: parent.absolute-position.y;
        from-cursor: root.tip-from-cursor;
        cursor-x: root.mouse-x;
    }

    show-timer := Timer {
        interval: root.show-delay;
        running: false;
        triggered => {
            if (root.has-hover && root.tooltip-text != "") {
                tip-popup.show();
            }
        }
    }

    changed has-hover => {
        if (self.has-hover && root.tooltip-text != "") {
            show-timer.start();
        } else {
            show-timer.stop();
            tip-popup.close();
        }
    }
    clicked => { root.activate(); }
}

// --- IconButton ------------------------------------------------------------
// A small square action button that accepts a single-character glyph (or short
// text). Set `font-family` to "Material Icons" for icon-font code points.
export component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <string> tooltip;
    in property <length> size: 28px;
    in property <brush> fg: Theme.text-secondary;
    in property <brush> fg-hover: Theme.text-primary;
    in property <string> font-family;
    callback clicked();

    width: size;
    height: size;
    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.bg-hover : transparent;
    animate background { duration: 120ms; }

    // Preferred-height + y offset (not height:100%) — same FemtoVG-safe
    // centering pattern as tab titles in tabs.slint.
    Text {
        width: 100%;
        y: (parent.height - self.preferred-height) / 2;
        text: glyph;
        color: touch.has-hover ? fg-hover : fg;
        font-family: root.font-family;
        font-size: Theme.fs-md;
        horizontal-alignment: center;
    }

    touch := TooltipArea {
        width: parent.width;
        height: parent.height;
        tooltip-text: root.tooltip;
        anchor-width: root.width;
        anchor-height: root.height;
        activate => { root.clicked(); }
    }
}

// --- PrimaryButton ---------------------------------------------------------
export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> disabled: false;
    callback clicked();

    height: 30px;
    min-width: 80px;
    border-radius: Theme.radius-sm;
    background: disabled
        ? Theme.bg-elevated
        : (touch.pressed ? Theme.accent-pressed
        : (touch.has-hover ? Theme.accent-hover : Theme.accent));
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: disabled ? Theme.text-muted : white;
            font-size: Theme.fs-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !disabled;
        mouse-cursor: disabled ? default : pointer;
        clicked => { root.clicked(); }
    }
}

// --- GhostButton -----------------------------------------------------------
export component GhostButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 30px;
    min-width: 80px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-strong : Theme.border-subtle;
    background: touch.pressed ? Theme.bg-active
        : (touch.has-hover ? Theme.bg-hover : Theme.bg-panel);
    animate background, border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: Theme.text-primary;
            font-size: Theme.fs-md;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// --- DangerButton ----------------------------------------------------------
// Destructive (red) action button, matching PrimaryButton's shape.
export component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked();

    height: 30px;
    min-width: 80px;
    border-radius: Theme.radius-sm;
    background: touch.pressed ? #c44a4a : (touch.has-hover ? #ec6a6a : Theme.danger);
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: white;
            font-size: Theme.fs-md;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// --- LabeledInput ----------------------------------------------------------
export component LabeledInput inherits HorizontalLayout {
    in property <string> label;
    // When > 0, reserves a fixed label column (for aligning a form's left labels).
    in property <length> label-width: 0px;
    in property <string> placeholder;
    in-out property <string> value;
    in property <bool> password: false;
    in property <bool> auto-focus: false;   // grab focus when shown (dialog fields)
    in property <brush> input-background: Theme.bg-root;
    in property <brush> idle-border: Theme.border-subtle;
    callback accepted();   // Enter pressed in the field
    callback canceled();   // Esc pressed in the field (#140-3)
    spacing: 10px;
    property <bool> focus-pending: false;
    public function focus-input() { input.focus(); }

    // A LabeledInput is often created inside a conditional dialog. Focusing its
    // TextInput during `init` asks Slint for IME geometry while the surrounding
    // layout binding is still being evaluated, which trips the runtime's
    // recursion guard. Defer focus until the next event-loop turn, after layout.
    init => { root.focus-pending = root.auto-focus; }
    focus-timer := Timer {
        interval: 0ms;
        running: root.focus-pending;
        triggered => {
            root.focus-pending = false;
            if (root.auto-focus) { input.focus(); }
        }
    }

    if root.label != "": Rectangle {
        width: root.label-width > 0px ? root.label-width : label-text.preferred-width;
        label-text := Text {
            width: 100%;
            height: 100%;
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Rectangle {
        height: 32px;
        horizontal-stretch: 1;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : root.idle-border;
        background: root.input-background;
        clip: true;

        // Viewport — same horizontal-scroll pattern as BorderedLineInput so
        // long values (paths, passwords, hostnames) are not clipped.
        Rectangle {
            x: 10px;
            width: parent.width - 20px;
            height: parent.height;
            clip: true;

            input := TextInput {
                property <length> computed-x;

                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: parent.height;
                text <=> root.value;
                color: Theme.text-primary;
                // A CJK-capable family — TextInput doesn't glyph-fallback reliably
                // across machines, so typed Chinese (incl. punctuation like 、) can
                // render as tofu without an explicit font (#54).
                font-family: Theme.ui-font-family;
                font-size: Theme.fs-md;
                vertical-alignment: center;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                accepted => { root.accepted(); }
                key-pressed(e) => {
                    if (e.text == Key.Escape) { root.canceled(); accept }
                    else { reject }   // let TextInput handle normal typing
                }
                cursor-position-changed(cursor-position) => {
                    if (cursor-position.x + self.computed_x < 0px) {
                        self.computed_x = -cursor-position.x;
                    } else if (cursor-position.x + self.computed_x > parent.width - self.text-cursor-width) {
                        self.computed_x = parent.width - cursor-position.x - self.text-cursor-width;
                    }
                }
            }
        }

        // Lightweight placeholder — shown when value is empty.
        if value == "": Text {
            x: 10px;
            y: 0px;
            height: parent.height;
            text: placeholder;
            color: Theme.text-muted;
            font-size: Theme.fs-md;
            vertical-alignment: center;
        }
    }
}

// --- EditableCombo ---------------------------------------------------------
// Labeled editable text field + dropdown of suggestions. Type a free value, or
// click ▼ to pick from `items`. Long text scrolls horizontally like BorderedLineInput.
export component EditableCombo inherits HorizontalLayout {
    in property <string> label;
    // When > 0, reserves a fixed label column (for aligning a form's left labels).
    in property <length> label-width: 0px;
    in property <string> placeholder;
    in-out property <string> value;
    in property <[string]> items;
    spacing: 10px;

    if root.label != "": Rectangle {
        width: root.label-width > 0px ? root.label-width : label-text.preferred-width;
        label-text := Text {
            width: 100%;
            height: 100%;
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Rectangle {
        height: 32px;
        horizontal-stretch: 1;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: combo-input.has-focus ? Theme.accent : Theme.border-strong;
        background: Theme.bg-elevated;
        clip: true;

        // Input viewport — leaves room for the ▼ button on the right.
        Rectangle {
            x: 10px;
            width: parent.width - 46px;
            height: parent.height;
            clip: true;

            combo-input := TextInput {
                property <length> computed-x;

                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: parent.height;
                text <=> root.value;
                color: Theme.text-primary;
                font-family: Theme.ui-font-family;
                font-size: Theme.fs-md;
                vertical-alignment: center;
                single-line: true;

                cursor-position-changed(cursor-position) => {
                    if (cursor-position.x + self.computed_x < 0px) {
                        self.computed_x = -cursor-position.x;
                    } else if (cursor-position.x + self.computed_x > parent.width - self.text-cursor-width) {
                        self.computed_x = parent.width - cursor-position.x - self.text-cursor-width;
                    }
                }
            }
        }

        if root.value == "": Text {
            x: 10px;
            width: parent.width - 46px;
            height: parent.height;
            text: root.placeholder;
            color: Theme.text-muted;
            font-size: Theme.fs-md;
            vertical-alignment: center;
        }

        // ▼ — opens the suggestion list (no-op when empty).
        drop-ta := TouchArea {
            x: parent.width - 36px;
            width: 36px;
            height: parent.height;
            mouse-cursor: root.items.length > 0 ? pointer : default;
            clicked => { if (root.items.length > 0) { items-popup.show(); } }
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: Theme.radius-sm;
                background: (drop-ta.has-hover && root.items.length > 0) ? Theme.bg-hover : transparent;
                Text {
                    // Plain Unicode caret — CJK UI fonts have this but not
                    // the Material icon range, which would tofu (#179).
                    text: "▼";
                    color: root.items.length > 0 ? Theme.text-secondary : Theme.border-strong;
                    font-size: Theme.fs-xs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        items-popup := PopupWindow {
            x: 0;
            y: parent.height + 3px;
            width: parent.width;
            Rectangle {
                background: Theme.popup-bg-alt;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-subtle;
                VerticalLayout {
                    padding: 4px;
                    spacing: 1px;
                    for item in root.items: Rectangle {
                        height: 28px;
                        border-radius: Theme.radius-sm;
                        background: item-ta.has-hover ? Theme.bg-hover : transparent;
                        item-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.value = item; items-popup.close(); }
                        }

                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            text: item;
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}

// --- LabeledCombo ----------------------------------------------------------
// Label + non-editable dropdown on one row. Height matched to EditableCombo / LabeledInput.
export component LabeledCombo inherits HorizontalLayout {
    in property <string> label;
    // When > 0, reserves a fixed label column (for aligning a form's left labels).
    in property <length> label-width: 0px;
    in property <[string]> model;
    in-out property <string> current-value;
    spacing: 10px;

    if root.label != "": Rectangle {
        width: root.label-width > 0px ? root.label-width : label-text.preferred-width;
        label-text := Text {
            width: 100%;
            height: 100%;
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    ComboBox {
        height: 32px;
        horizontal-stretch: 1;
        model: root.model;
        current-value: root.current-value;
        selected(value) => { root.current-value = value; }
    }
}

// --- BorderedLineInput -----------------------------------------------------
// Single-line input with themed border focus and horizontal scroll for long text.
export component BorderedLineInput inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    in property <length> pad-x: 10px;
    in property <length> font-size: Theme.fs-md;
    in property <string> font-family: Theme.ui-font-family;
    in property <brush> idle-border: Theme.border-subtle;
    in property <brush> text-color: Theme.text-primary;
    in property <string> leading-icon: "";   // Material Icons glyph shown inside the field
    in property <bool> auto-focus: false;
    in property <bool> read-only: false;
    callback edited(string);
    callback accepted(string);

    public function select-all() { input.select-all(); }
    public function copy() { input.copy(); }
    public function paste() { input.paste(); }
    public function clear-selection() { input.clear-selection(); }

    property <length> icon-gap: 4px;
    property <length> leading-inset: root.leading-icon != ""
        ? leading-icon.x + leading-icon.preferred-width + root.icon-gap
        : root.pad-x;
    property <bool> focus-pending: false;

    horizontal-stretch: 1;
    height: 32px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : root.idle-border;
    background: Theme.bg-root;
    clip: true;

    init => { root.focus-pending = root.auto-focus; }
    focus-timer := Timer {
        interval: 0ms;
        running: root.focus-pending;
        triggered => {
            root.focus-pending = false;
            if (root.auto-focus) { input.focus(); }
        }
    }

    leading-icon := Text {
        x: root.pad-x;
        height: parent.height;
        text: root.leading-icon;
        font-family: "Material Icons";
        color: Theme.text-muted;
        font-size: root.font-size;
        vertical-alignment: center;
        visible: root.leading-icon != "";
    }

    Rectangle {
        x: root.leading-inset;
        width: parent.width - root.leading-inset - root.pad-x;
        height: parent.height;
        clip: true;

        input := TextInput {
            property <length> computed-x;

            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: parent.height;
            text <=> root.text;
            color: root.text-color;
            font-family: root.font-family;
            font-size: root.font-size;
            vertical-alignment: center;
            single-line: true;
            read-only: root.read-only;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }

            cursor-position-changed(cursor-position) => {
                if (cursor-position.x + self.computed_x < 0px) {
                    self.computed_x = -cursor-position.x;
                } else if (cursor-position.x + self.computed_x > parent.width - self.text-cursor-width) {
                    self.computed_x = parent.width - cursor-position.x - self.text-cursor-width;
                }
            }
        }
    }

    if input.text == "": Text {
        x: root.leading-inset;
        width: parent.width - root.leading-inset - root.pad-x;
        height: parent.height;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: root.font-size;
        vertical-alignment: center;
    }
}

// --- BorderedTextArea ------------------------------------------------------
// Multiline input with themed border focus and scroll for overflowing content.
export component BorderedTextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <length> area-height: 100px;
    in property <length> font-size: Theme.fs-sm;
    in property <string> font-family: Theme.font-mono;
    in property <brush> idle-border: Theme.border-subtle;
    in property <brush> area-background: Theme.bg-root;
    callback edited(string);
    callback key-pressed(KeyEvent) -> EventResult;

    public function focus-input() { input.focus(); }
    public function set-selection-offsets(start: int, end: int) { input.set-selection-offsets(start, end); }
    public function cut() { input.cut(); }
    public function cursor-position-byte-offset() -> int { return input.cursor-position-byte-offset; }

    horizontal-stretch: 1;
    height: root.area-height;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : root.idle-border;
    background: root.area-background;
    clip: true;

    scroll := ScrollView {
        x: 10px;
        y: 8px;
        width: parent.width - 20px;
        height: parent.height - 16px;
        viewport-width: max(self.visible-width, input.preferred-width);
        viewport-height: max(self.visible-height, input.preferred-height);

        input := TextInput {
            text <=> root.text;
            color: Theme.text-primary;
            font-family: root.font-family;
            font-size: root.font-size;
            single-line: false;
            wrap: no-wrap;
            page-height: scroll.visible-height;
            edited => { root.edited(self.text); }
            key-pressed(e) => { root.key-pressed(e) }

            cursor-position-changed(cpos) => {
                if (cpos.x + scroll.viewport-x < 12px) {
                    scroll.viewport-x = min(0px, max(parent.visible-width - self.width, -cpos.x + 12px));
                } else if (cpos.x + scroll.viewport-x > parent.visible-width - 12px) {
                    scroll.viewport-x = min(0px, max(parent.visible-width - self.width, parent.visible-width - cpos.x - 12px));
                }
                if (cpos.y + scroll.viewport-y < 12px) {
                    scroll.viewport-y = min(0px, max(parent.visible-height - self.height, -cpos.y + 12px));
                } else if (cpos.y + scroll.viewport-y > parent.visible-height - 12px - 20px) {
                    scroll.viewport-y = min(0px, max(parent.visible-height - self.height, parent.visible-height - cpos.y - 12px - 20px));
                }
            }
        }
    }

    if input.text == "": Text {
        x: 10px;
        y: 8px;
        width: parent.width - 20px;
        height: parent.height - 16px;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: root.font-size;
        vertical-alignment: top;
    }
}

// --- DockExpandButton ------------------------------------------------------
// The little button shown when a dockable panel is collapsed, anchored to the
// edge it was docked on (chevron points toward where the panel reopens). Shared
// by the SFTP panel so they collapse/expand identically.
// The host is responsible for any reserved gap (e.g. the bottom edge) so this
// button never overlaps neighbouring chrome (#dock).
// IDEA-style collapsed tool strip (#v0.5 M5): when a dockable panel is collapsed
// the host renders this thin bar along the panel's docked edge instead of the
// panel. It shows the panel's tool icon; clicking re-expands. The host reserves
// the slot (≈36px) and fills this in; one reusable strip for welcome / SFTP
// so they all collapse the same way.
export component ToolStrip inherits Rectangle {
    in property <string> dock-edge;   // left | right | top | bottom
    in property <string> glyph;       // the panel's tool icon (Material Icons)
    in property <bool> show-second: false;
    in property <string> second-glyph;
    in property <bool> show-third: false;
    in property <string> third-glyph;
    in property <string> tooltip;
    in property <bool> enabled: true;
    // Icon-only overlay (SFTP collapsed on top/bottom): no fill/hairline so the
    // path field beside the icon stays visible and clickable.
    in property <bool> icon-only: false;
    callback expand();
    callback expand-second();
    callback expand-third();
    property <bool> horizontal: root.dock-edge == "top" || root.dock-edge == "bottom";

    background: root.icon-only ? transparent : Theme.bg-panel-alt;
    // Hairline on the inner edge (facing the central content).
    if !root.icon-only: Rectangle {
        x: root.dock-edge == "left" ? parent.width - self.width : 0px;
        y: root.dock-edge == "top" ? parent.height - self.height : 0px;
        width: root.horizontal ? parent.width : 1px;
        height: root.horizontal ? 1px : parent.height;
        background: Theme.border-subtle;
    }
    // Tool icon, hugging the strip's near corner.
    Rectangle {
        width: 30px;
        height: 30px;
        x: root.horizontal ? 4px : (parent.width - self.width) / 2;
        y: root.horizontal ? (parent.height - self.height) / 2 : 4px;
        border-radius: Theme.radius-sm;
        background: root.enabled && ta.has-hover ? Theme.bg-hover : transparent;
        Text {
            text: root.glyph;
            font-family: "Material Icons";
            font-size: 18px;
            color: !root.enabled ? Theme.text-muted.with-alpha(0.45)
                : ta.has-hover ? Theme.text-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }

        ta := TooltipArea {
            width: parent.width;
            height: parent.height;
            tooltip-text: root.tooltip;
            anchor-width: parent.width;
            anchor-height: parent.height;
            mouse-cursor: root.enabled ? pointer : default;
            activate => {
                if (root.enabled) {
                    root.expand();
                }
            }
        }
    }

    if root.show-second: Rectangle {
        width: 30px;
        height: 30px;
        x: root.horizontal ? 38px : (parent.width - self.width) / 2;
        y: root.horizontal ? (parent.height - self.height) / 2 : 38px;
        border-radius: Theme.radius-sm;
        background: ta2.has-hover ? Theme.bg-hover : transparent;
        Text {
            text: root.second-glyph;
            font-family: "Material Icons";
            font-size: 18px;
            color: ta2.has-hover ? Theme.text-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }

        ta2 := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expand-second(); }
        }
    }
    if root.show-third: Rectangle {
        width: 30px;
        height: 30px;
        x: root.horizontal ? 72px : (parent.width - self.width) / 2;
        y: root.horizontal ? (parent.height - self.height) / 2 : 72px;
        border-radius: Theme.radius-sm;
        background: ta3.has-hover ? Theme.bg-hover : transparent;
        Text {
            text: root.third-glyph;
            font-family: "Material Icons";
            font-size: 18px;
            color: ta3.has-hover ? Theme.text-primary : Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }

        ta3 := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expand-third(); }
        }
    }
}

export component DockExpandButton inherits Rectangle {
    in property <string> dock-edge;   // left | right | top | bottom
    // For top/bottom docks, hug the right corner instead of the left. SFTP uses
    // this so the expand button stays on the side its controls live on.
    in property <bool> hug-right: false;
    callback expand();
    // Root is a transparent overlay that fills the host area; the actual button
    // positions itself within it (a component's own root may not reference
    // `parent`, so the button anchors to this filled overlay instead).
    background: transparent;
    btn := Rectangle {
        width: 24px;
        height: 22px;
        x: root.dock-edge == "right" ? parent.width - self.width - 2px
            : (root.dock-edge == "top" || root.dock-edge == "bottom")
            ? (root.hug-right ? parent.width - self.width - 6px : 6px)
            : 2px;
        y: root.dock-edge == "bottom" ? parent.height - self.height - 1px : 8px;
        border-radius: Theme.radius-sm;
        background: ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
        border-width: 1px;
        border-color: Theme.border-subtle;
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.expand(); }
        }

        Text {
            text: root.dock-edge == "right" ? "\u{E5CB}"   // chevron_left
                : root.dock-edge == "top" ? "\u{E5CF}"   // expand_more
                : root.dock-edge == "bottom" ? "\u{E5CE}"   // expand_less
                : "\u{E5CC}";                                // chevron_right (left dock)
            font-family: "Material Icons";
            font-size: 16px;
            color: Theme.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }
}
