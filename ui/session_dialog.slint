import { Theme } from "theme.slint";
import { ComboBox, HorizontalBox } from "std-widgets.slint";
import { LabeledInput, PrimaryButton, GhostButton, EditableCombo, LabeledCombo, TooltipArea, BorderedTextArea } from "widgets.slint";

export struct SessionDraft {
    id: string,
    name: string,
    kind: string,      // "ssh" | "serial" | "telnet" | "local"
    host: string,
    port: int,
    user: string,
    auth: string,      // "password" | "key"
    password: string,
    private-key-path: string,
    private-key-inline: string,
    private-key-inline-mode: bool,
    group: string,     // folder/group name ("" = root / ungrouped)
    // Serial-only (ignored unless kind == "serial")
    serial-port: string,
    baud-rate: int,
    data-bits: int,
    stop-bits: int,
    parity: string,        // "none" | "odd" | "even" | "mark" | "space"
    flow-control: string,  // "none" | "xonxoff" | "rtscts" | "dsrdtr" (legacy: "software" | "hardware")
    encoding: string,
    // "auto" | "del" | "bs" — byte sent for Backspace (shared by all kinds).
    backspace-mode: string,
    // Local-only (ignored unless kind == "local")
    shell: string,              // "" = platform default
    working-directory: string,  // "" = user home
    // SSH only: show the SFTP panel when connected (default off for new sessions).
    enable-sftp: bool,
    // All connection kinds: show the bottom command panel (default off for new sessions).
    enable-command-panel: bool,
}

// A single segment in a segmented selector (auth toggle, baud presets, …).
component SegOption inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 30px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    background: active ? Theme.accent : Theme.bg-root;
    border-color: active ? Theme.accent : Theme.border-subtle;
    Text {
        text: root.label;
        color: active ? white : Theme.text-primary;
        font-size: Theme.fs-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Modal dialog for creating / editing a session (SSH / Serial / Telnet / Local).
// The dialog is purely presentational — it stores values in mutable
// properties and emits `submit(draft, persist, connect)` / `cancel` up to
// the main window.
export component SessionDialog inherits Rectangle {
    in-out property <bool> is-open: false;
    in-out property <bool> is-editing: false;
    in-out property <string> draft-id;
    in-out property <string> draft-name;
    in-out property <string> draft-kind: "ssh";
    in-out property <string> draft-host;
    in-out property <string> draft-port: "22";
    in-out property <string> draft-user;
    // Set when Create/Save is pressed with an empty host (SSH/Telnet) (#110).
    in-out property <bool> host-missing: false;
    // Set when Create/Save is pressed with an empty serial port.
    in-out property <bool> serial-port-missing: false;
    in-out property <string> draft-auth: "password";
    in-out property <string> draft-password;
    in-out property <string> draft-key-path;
    in-out property <string> draft-key-inline;
    in-out property <bool> draft-key-inline-mode: false;
    // True when editing a session that already has a pasted (encrypted) key —
    // blank input keeps that secret instead of clearing it.
    in-out property <bool> draft-key-saved-inline: false;
    in-out property <string> draft-group;
    in property <[string]> session-groups;   // existing groups for the dropdown (#179)
    in-out property <string> draft-serial-port;
    in property <[string]> serial-ports;     // OS-enumerated ports for the editable combo
    in-out property <string> draft-baud: "9600";
    in-out property <string> draft-data-bits: "8";
    in-out property <string> draft-stop-bits: "1";
    in-out property <string> draft-parity: "None";
    in-out property <string> draft-flow: "None";
    in-out property <string> draft-encoding: "UTF-8";
    // "auto" | "del" | "bs"
    in-out property <string> draft-backspace-mode: "auto";
    in-out property <string> draft-shell;
    in-out property <string> draft-working-directory;
    in-out property <bool> draft-enable-sftp: false;
    in-out property <bool> draft-enable-command-panel: false;
    // Set before opening (e.g. search-box Enter) so Host / IP is focused.
    in-out property <bool> focus-host-on-open: false;
    // Bumped when focus-host-on-open fires so the Host LabeledInput grabs focus.
    property <int> host-focus-seq: 0;

    // Shared left-column width = longest form label (locale-aware via @tr).
    property <length> form-label-width: max(m-conn.preferred-width,
        max(m-name.preferred-width,
        max(m-group.preferred-width,
        max(m-shell.preferred-width,
        max(m-cwd.preferred-width,
        max(m-enc.preferred-width,
        max(m-host.preferred-width,
        max(m-user.preferred-width,
        max(m-auth.preferred-width,
        max(m-pass.preferred-width,
        max(m-pkey.preferred-width,
        max(m-passphrase.preferred-width,
        max(m-sport.preferred-width,
        max(m-baud.preferred-width,
            m-bs.preferred-width))))))))))))));

    // persist / connect flags: Save/Create, Connect-without-saving, Save/Create-and-connect.
    callback submit(SessionDraft, bool /* persist */, bool /* connect */);
    callback cancel();
    callback pick-key-file();   // open a native file picker for the private key
    callback refresh-serial-ports();  // re-enumerate OS serial ports

    visible: is-open;
    background: #00000080;

    // Clear required-field flags each time the dialog opens (#110).
    // Host focus (search Enter) bumps host-focus-seq for the Host field.
    changed is-open => {
        if (self.is-open) {
            self.host-missing = false;
            self.serial-port-missing = false;
            if (self.focus-host-on-open
                && self.draft-kind != "serial"
                && self.draft-kind != "local") {
                self.host-focus-seq += 1;
            }
            self.focus-host-on-open = false;
        }
    }

    // Shared validation + draft packing for the footer actions.
    function emit-submit(persist: bool, connect: bool) {
        if (root.draft-kind != "serial" && root.draft-kind != "local" && root.draft-host == "") {
            root.host-missing = true;
            root.serial-port-missing = false;
            return;
        }
        if (root.draft-kind == "serial" && root.draft-serial-port == "") {
            root.serial-port-missing = true;
            root.host-missing = false;
            return;
        }
        root.host-missing = false;
        root.serial-port-missing = false;
        root.submit({
            id: root.draft-id,
            name: root.draft-name,
            kind: root.draft-kind,
            host: root.draft-host,
            port: root.draft-port.to-float(),
            user: root.draft-user,
            auth: root.draft-auth,
            password: root.draft-password,
            // Path vs inline is auto-detected in Rust from this text.
            private-key-path: "",
            private-key-inline: root.draft-key-inline,
            private-key-inline-mode: false,
            group: root.draft-group,
            serial-port: root.draft-serial-port,
            baud-rate: root.draft-baud.to-float(),
            data-bits: root.draft-data-bits.to-float(),
            stop-bits: root.draft-stop-bits.to-float(),
            parity: root.draft-parity,
            flow-control: root.draft-flow,
            encoding: root.draft-encoding,
            backspace-mode: root.draft-backspace-mode,
            shell: root.draft-shell,
            working-directory: root.draft-working-directory,
            enable-sftp: root.draft-enable-sftp,
            enable-command-panel: root.draft-enable-command-panel,
        }, persist, connect);
    }

    // Swallow clicks on the backdrop
    TouchArea {
        width: 100%;
        height: 100%;
    }

    // Off-screen label probes used only to compute `form-label-width`.
    Rectangle {
        x: -10000px;
        y: -10000px;
        width: 0px;
        height: 0px;
        clip: true;
        VerticalLayout {
            m-conn := Text { text: @tr("Connection type"); font-size: Theme.fs-sm; }
            m-name := Text { text: @tr("Name"); font-size: Theme.fs-sm; }
            m-group := Text { text: @tr("Group"); font-size: Theme.fs-sm; }
            m-shell := Text { text: @tr("Shell"); font-size: Theme.fs-sm; }
            m-cwd := Text { text: @tr("Working directory"); font-size: Theme.fs-sm; }
            m-enc := Text { text: @tr("Terminal encoding"); font-size: Theme.fs-sm; }
            m-host := Text { text: @tr("Host / IP"); font-size: Theme.fs-sm; }
            m-user := Text { text: @tr("Username"); font-size: Theme.fs-sm; }
            m-auth := Text { text: @tr("Authentication"); font-size: Theme.fs-sm; }
            m-pass := Text { text: @tr("Password"); font-size: Theme.fs-sm; }
            m-pkey := Text { text: @tr("Private key"); font-size: Theme.fs-sm; }
            m-passphrase := Text { text: @tr("Key passphrase"); font-size: Theme.fs-sm; }
            m-sport := Text { text: @tr("Serial port"); font-size: Theme.fs-sm; }
            m-baud := Text { text: @tr("Baud rate"); font-size: Theme.fs-sm; }
            m-bs := Text { text: @tr("Backspace mode"); font-size: Theme.fs-sm; }
        }
    }

    Rectangle {
        width: 580px;
        // Height follows the content, but never exceeds the window — past that
        // the body scrolls.
        height: min(body.preferred-height + 53px, parent.height - 40px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.popup-bg;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;

        // Prevent backdrop click from propagating when user clicks inside the card
        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            spacing: 0px;

            Rectangle {
                width: 100%;
                height: 52px;
                background: Theme.bg-panel-alt;
                border-top-left-radius: Theme.radius-lg;
                border-top-right-radius: Theme.radius-lg;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 10px;

                    Text {
                        text: is-editing ? @tr("Edit session") : @tr("New session");
                        color: Theme.text-primary;
                        font-size: Theme.fs-lg;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-sm;
                        background: close-ta.has-hover ? Theme.bg-hover : transparent;
                        close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.cancel(); }
                        }

                        Text {
                            text: "\u{E5CD}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                width: 100%;
                height: 1px;
                background: Theme.border-subtle;
            }

            Flickable {
                width: 100%;
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-height: body.preferred-height;
                body := VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    // Connection type selector (always shown).
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: root.form-label-width;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: @tr("Connection type");
                                color: Theme.text-secondary;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            SegOption {
                                label: "SSH";
                                active: root.draft-kind == "ssh";
                                clicked => {
                            // Switch protocol defaults while leaving non-default ports untouched (#303).
                            if (root.draft-kind != "ssh" && root.draft-port == "23") {
                                        root.draft-port = "22";
                                    }
                                    root.draft-kind = "ssh";
                                }
                            }

                            SegOption {
                                label: @tr("Serial");
                                active: root.draft-kind == "serial";
                                clicked => {
                                    root.draft-kind = "serial";
                                    root.refresh-serial-ports();
                                }
                            }

                            SegOption {
                                label: "Telnet";
                                active: root.draft-kind == "telnet";
                                clicked => {
                                    if (root.draft-kind != "telnet" && root.draft-port == "22") {
                                        root.draft-port = "23";
                                    }
                                    root.draft-kind = "telnet";
                                }
                            }

                            SegOption {
                                label: @tr("Local");
                                active: root.draft-kind == "local";
                                clicked => { root.draft-kind = "local"; }
                            }
                        }
                    }

                    LabeledInput {
                        input-background: Theme.bg-elevated;
                        idle-border: Theme.border-strong;
                        label: @tr("Name");
                        placeholder: @tr("optional, add number when repeated");
                        label-width: root.form-label-width;
                        value <=> root.draft-name;
                    }

                    // Optional group/folder to organize sessions by business (#41).
                    // Editable + dropdown of existing groups (#179). Blank = root.
                    EditableCombo {
                        label: @tr("Group");
                        label-width: root.form-label-width;
                        placeholder: @tr("leave empty → root");
                        value <=> root.draft-group;
                        items: root.session-groups;
                    }

                    // ── Local: shell / cwd / encoding ───────────────────────────────
                    if root.draft-kind == "local": LabeledInput {
                        input-background: Theme.bg-elevated;
                        idle-border: Theme.border-strong;
                        label: @tr("Shell");
                        label-width: root.form-label-width;
                        placeholder: @tr("leave empty → system default");
                        value <=> root.draft-shell;
                    }

                    if root.draft-kind == "local": LabeledInput {
                        input-background: Theme.bg-elevated;
                        idle-border: Theme.border-strong;
                        label: @tr("Working directory");
                        label-width: root.form-label-width;
                        placeholder: @tr("leave empty → home directory");
                        value <=> root.draft-working-directory;
                    }

                    // ── SSH / Telnet share host + port ──────────────────────────────
                    if root.draft-kind != "serial" && root.draft-kind != "local": HorizontalLayout {
                        spacing: 10px;
                        LabeledInput {
                            input-background: Theme.bg-elevated;
                            idle-border: Theme.border-strong;
                            label: @tr("Host / IP");
                            label-width: root.form-label-width;
                            placeholder: "192.168.1.10";
                            value <=> root.draft-host;
                            horizontal-stretch: 2;
                            // Bumped when the dialog opens from search Enter.
                            focus-request: root.host-focus-seq;
                        }

                        LabeledInput {
                            input-background: Theme.bg-elevated;
                            idle-border: Theme.border-strong;
                            label: @tr("Port");
                            placeholder: root.draft-kind == "telnet" ? "23" : "22";
                            value <=> root.draft-port;
                            horizontal-stretch: 1;
                        }
                    }

                    // Inline error when a host-less SSH/Telnet session is submitted (#110).
                    if root.host-missing && root.draft-host == "" && root.draft-kind != "serial" && root.draft-kind != "local": HorizontalLayout {
                        spacing: 10px;
                        Text { width: root.form-label-width; }
                        Text {
                            text: @tr("Please enter a host / IP address.");
                            color: Theme.danger;
                            font-size: Theme.fs-sm;
                        }
                    }

                    // ── SSH-only: user + auth ───────────────────────────────────────
                    if root.draft-kind == "ssh": LabeledInput {
                        input-background: Theme.bg-elevated;
                        idle-border: Theme.border-strong;
                        label: @tr("Username");
                        label-width: root.form-label-width;
                        placeholder: @tr("Prompted on connect if blank");
                        value <=> root.draft-user;
                    }

                    if root.draft-kind == "ssh": HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: root.form-label-width;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: @tr("Authentication");
                                color: Theme.text-secondary;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            horizontal-stretch: 1;
                            SegOption {
                                label: @tr("Password");
                                active: root.draft-auth == "password";
                                clicked => { root.draft-auth = "password"; }
                            }

                            SegOption {
                                label: @tr("Private key");
                                active: root.draft-auth == "key";
                                clicked => { root.draft-auth = "key"; }
                            }
                        }
                    }

                    if root.draft-kind == "ssh" && root.draft-auth == "password": LabeledInput {
                        input-background: Theme.bg-elevated;
                        idle-border: Theme.border-strong;
                        label: @tr("Password");
                        label-width: root.form-label-width;
                        placeholder: @tr("Prompted on connect if blank");
                        password: true;
                        value <=> root.draft-password;
                    }

                    // Path vs pasted PEM/PPK is detected automatically from the text (#auto-key).
                    if root.draft-kind == "ssh" && root.draft-auth == "key": HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: root.form-label-width;
                            height: key-label.preferred-height;
                            y: 8px;
                            key-label := Text {
                                width: 100%;
                                text: @tr("Private key");
                                color: Theme.text-secondary;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: right;
                            }
                            TooltipArea {
                                width: parent.width;
                                height: parent.height;
                                tooltip-text: @tr("Enter a key file path or paste the private key. Pasted keys are encrypted before saving.");
                                anchor-width: parent.width;
                                anchor-height: parent.height;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            horizontal-stretch: 1;
                            BorderedTextArea {
                                horizontal-stretch: 1;
                                area-height: 96px;
                                idle-border: Theme.border-strong;
                                area-background: Theme.bg-elevated;
                                // Unified field: file path or key body (classified on submit).
                                text <=> root.draft-key-inline;
                                font-family: Theme.font-mono;
                                font-size: Theme.fs-sm;
                                placeholder: root.draft-key-saved-inline
                                    ? @tr("Leave blank to keep the current key")
                                    : "~/.ssh/id_ed25519\nor -----BEGIN OPENSSH PRIVATE KEY-----";
                            }

                            Rectangle {
                                width: 64px;
                                height: 32px;
                                y: 0px;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                background: browse-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                                Text {
                                    text: @tr("Browse…");
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                browse-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.pick-key-file(); }
                                }
                            }
                        }
                    }

                    // Passphrase for an *encrypted* private key (#90). Reuses the
                    // password field; blank means the key isn't encrypted (or, when
                    // editing, keep the saved passphrase).
                    if root.draft-kind == "ssh" && root.draft-auth == "key": LabeledInput {
                        input-background: Theme.bg-elevated;
                        idle-border: Theme.border-strong;
                        label: @tr("Key passphrase");
                        label-width: root.form-label-width;
                        placeholder: root.is-editing
                            ? @tr("Leave blank to keep the current passphrase")
                            : @tr("Leave blank if the key isn't encrypted");
                        password: true;
                        value <=> root.draft-password;
                    }

                    // ── Serial-only fields ──────────────────────────────────────────
                    if root.draft-kind == "serial": HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: root.form-label-width;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: @tr("Serial port");
                                color: Theme.text-secondary;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            horizontal-stretch: 1;
                            EditableCombo {
                                horizontal-stretch: 1;
                                placeholder: "COM3  /  /dev/ttyUSB0";
                                value <=> root.draft-serial-port;
                                items: root.serial-ports;
                            }

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                background: refresh-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                                refresh-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.refresh-serial-ports(); }
                                }

                                Text {
                                    text: "\u{E5D5}";
                                    font-family: "Material Icons";
                                    color: Theme.text-secondary;
                                    font-size: 18px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Inline error when a serial session is submitted without a port.
                    if root.serial-port-missing && root.draft-serial-port == "" && root.draft-kind == "serial": HorizontalLayout {
                        spacing: 10px;
                        Text { width: root.form-label-width; }
                        Text {
                            text: @tr("Please enter a serial port.");
                            color: Theme.danger;
                            font-size: Theme.fs-sm;
                        }
                    }

                    if root.draft-kind == "serial": EditableCombo {
                        label: @tr("Baud rate");
                        label-width: root.form-label-width;
                        placeholder: "9600";
                        value <=> root.draft-baud;
                        items: [
                            "110", "300", "600", "1200", "2400", "4800", "9600",
                            "14400", "19200", "38400", "56000", "57600", "115200",
                            "128000", "230400", "256000", "460800", "921600"
                        ];
                    }

                    if root.draft-kind == "serial": HorizontalLayout {
                        spacing: 10px;
                        EditableCombo {
                            horizontal-stretch: 1;
                            label: @tr("Data bits");
                            label-width: root.form-label-width;
                            value <=> root.draft-data-bits;
                            items: ["5", "6", "7", "8"];
                        }

                        EditableCombo {
                            horizontal-stretch: 1;
                            label: @tr("Stop bits");
                            value <=> root.draft-stop-bits;
                            items: ["1", "2"];
                        }
                    }

                    if root.draft-kind == "serial": HorizontalLayout {
                        spacing: 10px;
                        LabeledCombo {
                            horizontal-stretch: 1;
                            label: @tr("Parity");
                            label-width: root.form-label-width;
                            current-value <=> root.draft-parity;
                            model: ["None", "Odd", "Even", "Mark", "Space"];
                        }

                        LabeledCombo {
                            horizontal-stretch: 1;
                            label: @tr("Flow control");
                            current-value <=> root.draft-flow;
                            model: ["None", "Xon/Xoff", "Rts/Cts", "Dsr/Dtr"];
                        }
                    }

                    // ── Backspace mode + terminal encoding (all connection kinds) ──
                    HorizontalLayout {
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 10px;
                            horizontal-stretch: 1;
                            Rectangle {
                                height: 32px;
                                width: root.form-label-width;
                                bs-label := Text {
                                    text: @tr("Backspace mode");
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-sm;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                TooltipArea {
                                    width: parent.width;
                                    height: parent.height;
                                    tip-from-cursor: true;
                                    tooltip-text: @tr("Byte sent for Backspace. Auto: BS for SSH/Telnet/Serial, DEL for Local.");
                                    anchor-width: parent.width;
                                    anchor-height: parent.height;
                                }
                            }

                            ComboBox {
                                height: 32px;
                                horizontal-stretch: 1;
                                model: [@tr("Auto"), @tr("DEL (0x7F)"), @tr("BS (0x08)")];
                                current-value: root.draft-backspace-mode == "del"
                                    ? @tr("DEL (0x7F)")
                                    : (root.draft-backspace-mode == "bs"
                                        ? @tr("BS (0x08)")
                                        : @tr("Auto"));
                                selected(value) => {
                                    if (value == @tr("DEL (0x7F)")) {
                                        root.draft-backspace-mode = "del";
                                    } else if (value == @tr("BS (0x08)")) {
                                        root.draft-backspace-mode = "bs";
                                    } else {
                                        root.draft-backspace-mode = "auto";
                                    }
                                }
                            }
                        }

                        LabeledCombo {
                            horizontal-stretch: 1;
                            label: @tr("Terminal encoding");
                            current-value <=> root.draft-encoding;
                            model: ["UTF-8", "GBK", "Big5", "Shift_JIS", "EUC-KR", "Windows-1252"];
                        }
                    }

                    // ── Optional panels (SFTP for SSH; quick commands for all kinds) ─
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        cross-axis-alignment: center;
                        Rectangle {
                            width: root.form-label-width;
                        }

                        if root.draft-kind == "ssh": HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            cross-axis-alignment: center;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.draft-enable-sftp ? Theme.accent : Theme.border-strong;
                                background: root.draft-enable-sftp ? Theme.accent : transparent;
                                Text {
                                    text: root.draft-enable-sftp ? "\u{E5CA}" : "";
                                    font-family: "Material Icons";
                                    color: white;
                                    font-size: 14px;
                                    width: 100%;
                                    height: 100%;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.draft-enable-sftp = !root.draft-enable-sftp; }
                                }
                            }

                            Rectangle {
                                width: sftp-label.preferred-width;
                                height: 18px;
                                sftp-label := Text {
                                    text: @tr("Enable SFTP panel");
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                    height: 100%;
                                }
                                TooltipArea {
                                    width: parent.width;
                                    height: parent.height;
                                    mouse-cursor: pointer;
                                    tip-from-cursor: true;
                                    tooltip-text: @tr("When off, the SFTP side panel is hidden for this session.");
                                    anchor-width: parent.width;
                                    anchor-height: parent.height;
                                    activate => { root.draft-enable-sftp = !root.draft-enable-sftp; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            cross-axis-alignment: center;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.draft-enable-command-panel ? Theme.accent : Theme.border-strong;
                                background: root.draft-enable-command-panel ? Theme.accent : transparent;
                                Text {
                                    text: root.draft-enable-command-panel ? "\u{E5CA}" : "";
                                    font-family: "Material Icons";
                                    color: white;
                                    font-size: 14px;
                                    width: 100%;
                                    height: 100%;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.draft-enable-command-panel = !root.draft-enable-command-panel; }
                                }
                            }

                            Rectangle {
                                width: cmd-panel-label.preferred-width;
                                height: 18px;
                                cmd-panel-label := Text {
                                    text: @tr("Enable command panel");
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                    height: 100%;
                                }
                                TooltipArea {
                                    width: parent.width;
                                    height: parent.height;
                                    mouse-cursor: pointer;
                                    tip-from-cursor: true;
                                    tooltip-text: @tr("When off, the command panel (quick commands, input box, and history) is hidden for this session.");
                                    anchor-width: parent.width;
                                    anchor-height: parent.height;
                                    activate => { root.draft-enable-command-panel = !root.draft-enable-command-panel; }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        GhostButton {
                            text: @tr("Cancel");
                            clicked => { root.cancel(); }
                        }

                        GhostButton {
                            text: is-editing ? @tr("Save") : @tr("Create");
                            clicked => { root.emit-submit(true, false); }
                        }

                        GhostButton {
                            text: @tr("Connect without saving");
                            clicked => { root.emit-submit(false, true); }
                        }

                        PrimaryButton {
                            text: is-editing ? @tr("Save and connect") : @tr("Create and connect");
                            clicked => { root.emit-submit(true, true); }
                        }
                    }
                }
            }
        }
    }
}
