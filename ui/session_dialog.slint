import { Theme } from "theme.slint";
import { ComboBox } from "std-widgets.slint";
import { LabeledInput, PrimaryButton, GhostButton, EditableCombo } from "widgets.slint";

export struct SessionDraft {
    id: string,
    name: string,
    kind: string,      // "ssh" | "serial" | "telnet" | "local"
    host: string,
    port: int,
    user: string,
    auth: string,      // "password" | "key"
    password: string,
    private-key-path: string,
    private-key-inline: string,
    private-key-inline-mode: bool,
    group: string,     // folder/group name ("" = root / ungrouped)
    // Serial-only (ignored unless kind == "serial")
    serial-port: string,
    baud-rate: int,
    data-bits: int,
    stop-bits: int,
    parity: string,        // "none" | "odd" | "even" | "mark" | "space"
    flow-control: string,  // "none" | "xonxoff" | "rtscts" | "dsrdtr" (legacy: "software" | "hardware")
    encoding: string,
    // "auto" | "del" | "bs" — byte sent for Backspace (shared by all kinds).
    backspace-mode: string,
    // Local-only (ignored unless kind == "local")
    shell: string,              // "" = platform default
    working-directory: string,  // "" = user home
    // SSH only: show the SFTP panel when connected (default off for new sessions).
    enable-sftp: bool,
    // All connection kinds: show the bottom command panel (default off for new sessions).
    enable-command-panel: bool,
}

// A single segment in a segmented selector (auth toggle, baud presets, …).
component SegOption inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 30px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    background: active ? Theme.accent : Theme.bg-root;
    border-color: active ? Theme.accent : Theme.border-subtle;
    Text {
        text: root.label;
        color: active ? white : Theme.text-primary;
        font-size: Theme.fs-md;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Modal dialog for creating / editing a session (SSH / Serial / Telnet / Local).
// The dialog is purely presentational — it stores values in mutable
// properties and emits `submit` / `cancel` callbacks up to the main window.
export component SessionDialog inherits Rectangle {
    in-out property <bool> is-open: false;
    in-out property <bool> is-editing: false;
    in-out property <string> draft-id;
    in-out property <string> draft-name;
    in-out property <string> draft-kind: "ssh";
    in-out property <string> draft-host;
    in-out property <string> draft-port: "22";
    in-out property <string> draft-user;
    // Set when Create/Save is pressed with an empty host (SSH/Telnet) (#110).
    in-out property <bool> host-missing: false;
    in-out property <string> draft-auth: "password";
    in-out property <string> draft-password;
    in-out property <string> draft-key-path;
    in-out property <string> draft-key-inline;
    in-out property <bool> draft-key-inline-mode: false;
    in-out property <string> draft-group;
    in property <[string]> session-groups;   // existing groups for the dropdown (#179)
    in-out property <string> draft-serial-port;
    in property <[string]> serial-ports;     // OS-enumerated ports for the editable combo
    in-out property <string> draft-baud: "9600";
    in-out property <string> draft-data-bits: "8";
    in-out property <string> draft-stop-bits: "1";
    in-out property <string> draft-parity: "none";
    in-out property <string> draft-flow: "none";
    in-out property <string> draft-encoding: "UTF-8";
    // "auto" | "del" | "bs"
    in-out property <string> draft-backspace-mode: "auto";
    in-out property <string> draft-shell;
    in-out property <string> draft-working-directory;
    in-out property <bool> draft-enable-sftp: false;
    in-out property <bool> draft-enable-command-panel: false;

    callback submit(SessionDraft);
    callback cancel();
    callback pick-key-file();   // open a native file picker for the private key
    callback refresh-serial-ports();  // re-enumerate OS serial ports

    visible: is-open;
    background: #00000080;

    // Clear the host-required flag each time the dialog opens (#110).
    changed is-open => {
        if (self.is-open) {
            self.host-missing = false;
        }
    }

    // Swallow clicks on the backdrop
    TouchArea {
        width: 100%;
        height: 100%;
    }

    Rectangle {
        width: 440px;
        // Height follows the content, but never exceeds the window — past that
        // the body scrolls.
        height: min(body.preferred-height + 53px, parent.height - 40px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.popup-bg;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;

        // Prevent backdrop click from propagating when user clicks inside the card
        TouchArea {
            width: 100%;
            height: 100%;
        }

        VerticalLayout {
            spacing: 0px;

            Rectangle {
                width: 100%;
                height: 52px;
                background: Theme.bg-panel-alt;
                border-top-left-radius: Theme.radius-lg;
                border-top-right-radius: Theme.radius-lg;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 10px;
                    spacing: 10px;

                    Text {
                        text: is-editing ? @tr("Edit session") : @tr("New session");
                        color: Theme.text-primary;
                        font-size: Theme.fs-lg;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-sm;
                        background: close-ta.has-hover ? Theme.bg-hover : transparent;
                        close-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.cancel(); }
                        }

                        Text {
                            text: "\u{E5CD}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: 18px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                width: 100%;
                height: 1px;
                background: Theme.border-subtle;
            }

            Flickable {
                width: 100%;
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-height: body.preferred-height;
                body := VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    // Connection type selector (always shown).
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Connection type");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            SegOption {
                                label: "SSH";
                                active: root.draft-kind == "ssh";
                                clicked => {
                            // Switch protocol defaults while leaving non-default ports untouched (#303).
                            if (root.draft-kind != "ssh" && root.draft-port == "23") {
                                        root.draft-port = "22";
                                    }
                                    root.draft-kind = "ssh";
                                }
                            }

                            SegOption {
                                label: @tr("Serial");
                                active: root.draft-kind == "serial";
                                clicked => {
                                    root.draft-kind = "serial";
                                    root.refresh-serial-ports();
                                }
                            }

                            SegOption {
                                label: "Telnet";
                                active: root.draft-kind == "telnet";
                                clicked => {
                                    if (root.draft-kind != "telnet" && root.draft-port == "22") {
                                        root.draft-port = "23";
                                    }
                                    root.draft-kind = "telnet";
                                }
                            }

                            SegOption {
                                label: @tr("Local");
                                active: root.draft-kind == "local";
                                clicked => { root.draft-kind = "local"; }
                            }
                        }
                    }

                    LabeledInput {
                        input-background: Theme.bg-elevated;
                        idle-border: Theme.border-strong;
                        label: @tr("Name");
                        placeholder: @tr("e.g. production web-01");
                        value <=> root.draft-name;
                    }

                    // Optional group/folder to organize sessions by business (#41).
                    // Editable + dropdown of existing groups (#179). Blank = root.
                    EditableCombo {
                        label: @tr("Group");
                        placeholder: @tr("leave empty → root");
                        value <=> root.draft-group;
                        items: root.session-groups;
                    }

                    // ── Local: shell / cwd / encoding ───────────────────────────────
                    if root.draft-kind == "local": LabeledInput {
                        input-background: Theme.bg-elevated;
                        idle-border: Theme.border-strong;
                        label: @tr("Shell");
                        placeholder: @tr("leave empty → system default");
                        value <=> root.draft-shell;
                    }

                    if root.draft-kind == "local": LabeledInput {
                        input-background: Theme.bg-elevated;
                        idle-border: Theme.border-strong;
                        label: @tr("Working directory");
                        placeholder: @tr("leave empty → home directory");
                        value <=> root.draft-working-directory;
                    }

                    if root.draft-kind == "local": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Terminal character encoding");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                        }

                        ComboBox {
                            model: ["UTF-8", "GBK", "Big5", "Shift_JIS", "EUC-KR", "Windows-1252"];
                            current-value: root.draft-encoding;
                            selected(value) => { root.draft-encoding = value; }
                        }
                    }

                    // ── SSH / Telnet share host + port ──────────────────────────────
                    if root.draft-kind != "serial" && root.draft-kind != "local": HorizontalLayout {
                        spacing: 10px;
                        LabeledInput {
                            input-background: Theme.bg-elevated;
                            idle-border: Theme.border-strong;
                            label: @tr("Host / IP");
                            placeholder: "192.168.1.10";
                            value <=> root.draft-host;
                            horizontal-stretch: 2;
                        }

                        LabeledInput {
                            input-background: Theme.bg-elevated;
                            idle-border: Theme.border-strong;
                            label: @tr("Port");
                            placeholder: root.draft-kind == "telnet" ? "23" : "22";
                            value <=> root.draft-port;
                            horizontal-stretch: 1;
                        }
                    }

                    // Inline error when a host-less SSH/Telnet session is submitted (#110).
                    if root.host-missing && root.draft-host == "" && root.draft-kind != "serial" && root.draft-kind != "local": Text {
                        text: @tr("Please enter a host / IP address.");
                        color: Theme.danger;
                        font-size: Theme.fs-sm;
                    }

                    // ── SSH-only: user + auth ───────────────────────────────────────
                    if root.draft-kind == "ssh": LabeledInput {
                        input-background: Theme.bg-elevated;
                        idle-border: Theme.border-strong;
                        label: @tr("Username");
                        placeholder: @tr("Prompted on connect if blank");
                        value <=> root.draft-user;
                    }

                    if root.draft-kind == "ssh": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Authentication");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            SegOption {
                                label: @tr("Password");
                                active: root.draft-auth == "password";
                                clicked => { root.draft-auth = "password"; }
                            }

                            SegOption {
                                label: @tr("Private key");
                                active: root.draft-auth == "key";
                                clicked => { root.draft-auth = "key"; }
                            }
                        }
                    }

                    if root.draft-kind == "ssh" && root.draft-auth == "password": LabeledInput {
                        input-background: Theme.bg-elevated;
                        idle-border: Theme.border-strong;
                        label: @tr("Password");
                        placeholder: root.is-editing ? @tr("Leave blank to keep the current password") : "••••••••";
                        password: true;
                        value <=> root.draft-password;
                    }

                    if root.draft-kind == "ssh" && root.draft-auth == "key": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Private key");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            SegOption {
                                label: @tr("Private key file");
                                active: !root.draft-key-inline-mode;
                                clicked => { root.draft-key-inline-mode = false; }
                            }

                            SegOption {
                                label: @tr("Paste private key");
                                active: root.draft-key-inline-mode;
                                clicked => { root.draft-key-inline-mode = true; }
                            }
                        }

                        if !root.draft-key-inline-mode: VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                Rectangle {
                                    height: 32px;
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: keyin.has-focus ? Theme.accent : Theme.border-strong;
                                    background: Theme.bg-elevated;
                                    keyin := TextInput {
                                        x: 10px;
                                        y: 0px;
                                        width: parent.width - 20px;
                                        height: parent.height;
                                        text <=> root.draft-key-path;
                                        color: Theme.text-primary;
                                        font-family: Theme.ui-font-family; // CJK-capable (#54)
                                        font-size: Theme.fs-md;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }

                                    if root.draft-key-path == "": Text {
                                        x: 10px;
                                        y: 0px;
                                        height: parent.height;
                                        text: "/home/you/.ssh/id_ed25519";
                                        color: Theme.text-muted;
                                        font-size: Theme.fs-md;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    width: 64px;
                                    height: 32px;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    background: browse-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                                    Text {
                                        text: @tr("Browse…");
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-sm;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    browse-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.pick-key-file(); }
                                    }
                                }
                            }

                            Text {
                                text: @tr("Pick the private key itself (not the .pub public key)");
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                            }
                        }
                        if root.draft-key-inline-mode: VerticalLayout {
                            spacing: 4px;
                            Rectangle {
                                height: 118px;
                                horizontal-stretch: 1;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: keytext.has-focus ? Theme.accent : Theme.border-strong;
                                background: Theme.bg-elevated;
                                keytext := TextInput {
                                    x: 10px;
                                    y: 8px;
                                    width: parent.width - 20px;
                                    height: parent.height - 16px;
                                    text <=> root.draft-key-inline;
                                    color: Theme.text-primary;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.fs-sm;
                                    single-line: false;
                                    wrap: word-wrap;
                                }

                                if root.draft-key-inline == "": Text {
                                    x: 10px;
                                    y: 8px;
                                    width: parent.width - 20px;
                                    text: "-----BEGIN OPENSSH PRIVATE KEY-----";
                                    color: Theme.text-muted;
                                    font-family: Theme.font-mono;
                                    font-size: Theme.fs-sm;
                                }
                            }

                            Text {
                                text: @tr("Private key content is encrypted before saving.");
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                            }
                        }
                    }

                    // Passphrase for an *encrypted* private key (#90). Reuses the
                    // password field; blank means the key isn't encrypted (or, when
                    // editing, keep the saved passphrase).
                    if root.draft-kind == "ssh" && root.draft-auth == "key": LabeledInput {
                        input-background: Theme.bg-elevated;
                        idle-border: Theme.border-strong;
                        label: @tr("Key passphrase");
                        placeholder: root.is-editing
                            ? @tr("Leave blank to keep the current passphrase")
                            : @tr("Leave blank if the key isn't encrypted");
                        password: true;
                        value <=> root.draft-password;
                    }

                    // ── Serial-only fields ──────────────────────────────────────────
                    if root.draft-kind == "serial": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Serial port");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            EditableCombo {
                                horizontal-stretch: 1;
                                placeholder: "COM3  /  /dev/ttyUSB0";
                                value <=> root.draft-serial-port;
                                items: root.serial-ports;
                            }

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                background: refresh-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                                refresh-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.refresh-serial-ports(); }
                                }

                                Text {
                                    text: "\u{E5D5}";
                                    font-family: "Material Icons";
                                    color: Theme.text-secondary;
                                    font-size: 18px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    if root.draft-kind == "serial": EditableCombo {
                        label: @tr("Baud rate");
                        placeholder: "9600";
                        value <=> root.draft-baud;
                        items: [
                            "110", "300", "600", "1200", "2400", "4800", "9600",
                            "14400", "19200", "38400", "56000", "57600", "115200",
                            "128000", "230400", "256000", "460800", "921600"
                        ];
                    }

                    if root.draft-kind == "serial": HorizontalLayout {
                        spacing: 8px;
                        EditableCombo {
                            horizontal-stretch: 1;
                            label: @tr("Data bits");
                            value <=> root.draft-data-bits;
                            items: ["5", "6", "7", "8"];
                        }

                        EditableCombo {
                            horizontal-stretch: 1;
                            label: @tr("Stop bits");
                            value <=> root.draft-stop-bits;
                            items: ["1", "2"];
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            Text {
                                text: @tr("Parity");
                                color: Theme.text-secondary;
                                font-size: Theme.fs-sm;
                            }

                            ComboBox {
                                model: ["none", "odd", "even", "mark", "space"];
                                current-value: root.draft-parity;
                                selected(value) => { root.draft-parity = value; }
                            }
                        }
                    }

                    if root.draft-kind == "serial": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Flow control");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                        }

                        ComboBox {
                            model: [@tr("None"), "Xon/Xoff", "Rts/Cts", "Dsr/Dtr"];
                            current-value: root.draft-flow == "xonxoff" || root.draft-flow == "software"
                                ? "Xon/Xoff"
                                : (root.draft-flow == "rtscts" || root.draft-flow == "hardware"
                                    ? "Rts/Cts"
                                    : (root.draft-flow == "dsrdtr"
                                        ? "Dsr/Dtr"
                                        : @tr("None")));
                            selected(value) => {
                                if (value == "Xon/Xoff") {
                                    root.draft-flow = "xonxoff";
                                } else if (value == "Rts/Cts") {
                                    root.draft-flow = "rtscts";
                                } else if (value == "Dsr/Dtr") {
                                    root.draft-flow = "dsrdtr";
                                } else {
                                    root.draft-flow = "none";
                                }
                            }
                        }
                    }

                    if root.draft-kind == "serial": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Terminal character encoding");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                        }

                        ComboBox {
                            model: ["UTF-8", "GBK", "Big5", "Shift_JIS", "EUC-KR", "Windows-1252"];
                            current-value: root.draft-encoding;
                            selected(value) => { root.draft-encoding = value; }
                        }
                    }

                    // ── Telnet: encoding ────────────────────────────────────────────
                    if root.draft-kind == "telnet": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Terminal character encoding");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                        }

                        ComboBox {
                            model: ["UTF-8", "GBK", "Big5", "Shift_JIS", "EUC-KR", "Windows-1252"];
                            current-value: root.draft-encoding;
                            selected(value) => { root.draft-encoding = value; }
                        }
                    }

                    // ── Backspace mode (all connection kinds) ───────────────────────
                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Backspace mode");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                        }

                        ComboBox {
                            model: [@tr("Auto"), @tr("DEL (0x7F)"), @tr("BS (0x08)")];
                            current-value: root.draft-backspace-mode == "del"
                                ? @tr("DEL (0x7F)")
                                : (root.draft-backspace-mode == "bs"
                                    ? @tr("BS (0x08)")
                                    : @tr("Auto"));
                            selected(value) => {
                                if (value == @tr("DEL (0x7F)")) {
                                    root.draft-backspace-mode = "del";
                                } else if (value == @tr("BS (0x08)")) {
                                    root.draft-backspace-mode = "bs";
                                } else {
                                    root.draft-backspace-mode = "auto";
                                }
                            }
                        }

                        Text {
                            text: @tr("Byte sent for Backspace. Auto: DEL for SSH/Local, BS for Telnet/Serial.");
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                            wrap: word-wrap;
                        }
                    }

                    // ── Optional panels (SFTP for SSH; quick commands for all kinds) ─
                    if root.draft-kind == "ssh": VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                y: 1px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.draft-enable-sftp ? Theme.accent : Theme.border-strong;
                                background: root.draft-enable-sftp ? Theme.accent : transparent;
                                Text {
                                    text: root.draft-enable-sftp ? "\u{E5CA}" : "";
                                    font-family: "Material Icons";
                                    color: white;
                                    font-size: 14px;
                                    width: 100%;
                                    height: 100%;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.draft-enable-sftp = !root.draft-enable-sftp; }
                                }
                            }

                            Text {
                                text: @tr("Enable SFTP panel");
                                color: Theme.text-primary;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        Text {
                            text: @tr("When off, the SFTP side panel is hidden for this session.");
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                            wrap: word-wrap;
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;

                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                y: 1px;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: root.draft-enable-command-panel ? Theme.accent : Theme.border-strong;
                                background: root.draft-enable-command-panel ? Theme.accent : transparent;
                                Text {
                                    text: root.draft-enable-command-panel ? "\u{E5CA}" : "";
                                    font-family: "Material Icons";
                                    color: white;
                                    font-size: 14px;
                                    width: 100%;
                                    height: 100%;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.draft-enable-command-panel = !root.draft-enable-command-panel; }
                                }
                            }

                            Text {
                                text: @tr("Enable command panel");
                                color: Theme.text-primary;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }

                        Text {
                            text: @tr("When off, the command panel (quick commands, input box, and history) is hidden for this session.");
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                            wrap: word-wrap;
                        }
                    }

                    // ── Terminal character encoding (SSH only) (#338) ───────────────
                    if root.draft-kind == "ssh": VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: @tr("Terminal character encoding");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                        }

                        ComboBox {
                            model: ["UTF-8", "GBK", "Big5", "Shift_JIS", "EUC-KR", "Windows-1252"];
                            current-value: root.draft-encoding;
                            selected(value) => { root.draft-encoding = value; }
                        }

                        Text {
                            text: @tr("Use GBK for servers configured for GB2312 or GBK output.");
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                        }

                        Rectangle {
                            height: 6px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        GhostButton {
                            text: @tr("Cancel");
                            clicked => { root.cancel(); }
                        }

                        PrimaryButton {
                            text: is-editing ? @tr("Save") : @tr("Create");
                            clicked => {
                                // SSH/Telnet need a host; block submit and flag it (#110).
                                if (root.draft-kind != "serial" && root.draft-kind != "local" && root.draft-host == "") {
                                    root.host-missing = true;
                                    return;
                                }
                                root.host-missing = false;
                                root.submit({
                                    id: root.draft-id,
                                    name: root.draft-name,
                                    kind: root.draft-kind,
                                    host: root.draft-host,
                                    port: root.draft-port.to-float(),
                                    user: root.draft-user,
                                    auth: root.draft-auth,
                                    password: root.draft-password,
                                    private-key-path: root.draft-key-path,
                                    private-key-inline: root.draft-key-inline,
                                    private-key-inline-mode: root.draft-key-inline-mode,
                                    group: root.draft-group,
                                    serial-port: root.draft-serial-port,
                                    baud-rate: root.draft-baud.to-float(),
                                    data-bits: root.draft-data-bits.to-float(),
                                    stop-bits: root.draft-stop-bits.to-float(),
                                    parity: root.draft-parity,
                                    flow-control: root.draft-flow,
                                    encoding: root.draft-encoding,
                                    backspace-mode: root.draft-backspace-mode,
                                    shell: root.draft-shell,
                                    working-directory: root.draft-working-directory,
                                    enable-sftp: root.draft-enable-sftp,
                                    enable-command-panel: root.draft-enable-command-panel,
                                });
                            }
                        }
                    }
                }
            }
        }
    }
}
