// Interface settings content (#23 follow-up).
//
// Embedded panel (not a window): it lives inside AppWindow's modal overlay, so
// the settings can't be dragged out of the parent and block input while open —
// while keeping the clean, minimal "label-left · control-right" design.
// Typography is fixed (literal px in the chrome) so it stays compact regardless
// of the global UI scale; only the font-preview reflects the real terminal size.

import { Theme } from "theme.slint";
import { ComboBox, Slider, ScrollView } from "std-widgets.slint";
import { LabeledInput, PrimaryButton, DangerButton, BorderedLineInput, GhostButton, CompactCheckBox } from "widgets.slint";

export struct OutputRuleItem {
    name: string,
    pattern: string,
    regex: bool,
    case-sensitive: bool,
    whole-line: bool,
    color: string,
    swatch: color,
    enabled: bool,
}

export struct AlgorithmOptionRow {
    name: string,
    checked: bool,
    weak: bool,
    can-move-up: bool,
    can-move-down: bool,
}

// One left-nav row (icon + label).
component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 30px;
    border-radius: 6px;
    background: root.active ? Theme.bg-active : (ta.has-hover ? Theme.bg-hover : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        spacing: 9px;
        Text {
            text: root.icon;
            font-family: "Material Icons";
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: 15px * Theme.panel-font;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: 13px * Theme.panel-font;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// Small muted group heading (字体 / 预览 / SFTP …).
// Fixed height leaves CJK ascent room on macOS (Heiti/Songti metrics, #129).
component SectionHeader inherits Text {
    font-size: 11px * Theme.panel-font;
    font-weight: 700;
    color: Theme.text-muted;
    vertical-alignment: center;
    height: 26px * Theme.panel-font;
}

// Muted page-level hint under a section / setting (same metrics as SettingRow.desc).
// Extra height: Slint preferred-height undershoots CJK descent on macOS (#129).
component SettingHint inherits Text {
    color: Theme.text-muted;
    font-size: 11px * Theme.panel-font;
    wrap: word-wrap;
    height: max(15px * Theme.panel-font, self.preferred-height + 8px * Theme.panel-font);
}

// A settings row: label (+ optional description) on the left, a control slot on
// the right via @children. Right-aligned and vertically centered.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> desc;
    in property <bool> show-divider: true;
    VerticalLayout {
        HorizontalLayout {
            spacing: 14px;
            padding-top: 9px;
            padding-bottom: 9px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                // 5px (was 3) so CJK desc ascent doesn't collide with the label.
                spacing: 5px;
                Text {
                    text: root.label;
                    font-size: 13px * Theme.panel-font;
                    color: Theme.text-primary;
                }

                // Pad height: preferred-height undershoots CJK ink on macOS (#129),
                // so wrapped desc (e.g. keepalive) loses the last line's descent.
                if root.desc != "": Rectangle {
                    height: max(15px * Theme.panel-font, desc-text.preferred-height + 8px * Theme.panel-font);
                    desc-text := Text {
                        width: 100%;
                        text: root.desc;
                        font-size: 11px * Theme.panel-font;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                @children
            }
        }

        if root.show-divider: Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }
    }
}

// iOS-style toggle switch. Display-only `on` (driven by the parent); a tap emits
// the intended new value so the parent owns the state (avoids Slint's
// binding-break-on-self-assign gotcha).
component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.on ? Theme.accent : Theme.bg-active;
    animate background { duration: 120ms; }
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        y: 3px;
        x: root.on ? parent.width - self.width - 3px : 3px;
        background: white;
        animate x {
            duration: 120ms;
            easing: ease-out;
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.toggled(!root.on); }
    }
}

// [- value +] stepper. Display-only `value`; emits the clamped new value.
component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> unit;
    callback changed(int);
    width: 112px;
    height: 26px;
    border-radius: 6px;
    background: Theme.bg-elevated;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;
    HorizontalLayout {
        Rectangle {
            width: 30px;
            background: minus-ta.has-hover ? Theme.bg-hover : transparent;
            minus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(max(root.minimum, root.value - root.step)); }
            }

            Text {
                text: "\u{E15B}";
                font-family: "Material Icons";
                font-size: 14px * Theme.panel-font;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border-subtle;
        }

        Text {
            text: root.value + root.unit;
            horizontal-stretch: 1;
            font-size: 12px * Theme.panel-font;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            width: 1px;
            background: Theme.border-subtle;
        }

        Rectangle {
            width: 30px;
            background: plus-ta.has-hover ? Theme.bg-hover : transparent;
            plus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(min(root.maximum, root.value + root.step)); }
            }

            Text {
                text: "\u{E145}";
                font-family: "Material Icons";
                font-size: 14px * Theme.panel-font;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// Compact cursor-shape choice with a live visual sample (#275).
component CursorStyleButton inherits Rectangle {
    in property <string> label;
    in property <string> cursor-kind;
    in property <bool> selected;
    callback clicked();
    width: 74px;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.selected ? Theme.accent : Theme.border-subtle;
    background: root.selected ? Theme.bg-active : (cursor-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated);
    cursor-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 6px;
        alignment: center;
        Rectangle {
            width: 14px;
            height: 100%;
            background: transparent;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 18px;
                background: Theme.term-bg;
                Rectangle {
                    x: 2px;
                    y: root.cursor-kind == "underline" ? parent.height - 3px : 2px;
                    width: root.cursor-kind == "bar" ? 2px : 10px;
                    height: root.cursor-kind == "underline" ? 2px : 14px;
                    background: Theme.term-fg;
                }
            }
        }

        Text {
            text: root.label;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 11px * Theme.panel-font;
            vertical-alignment: center;
        }
    }
}

component CursorPaletteSwatch inherits Rectangle {
    in property <string> hex;
    in property <color> swatch-color;
    in property <bool> selected;
    callback chosen(string);
    width: 26px;
    height: 26px;
    border-radius: 5px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border-strong;
    background: root.swatch-color;
    swatch-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(root.hex); }
    }
}

// Hex RGB editor with a live swatch. Incomplete/invalid input remains editable
// but is marked red and is not applied or persisted.
component CursorColorInput inherits Rectangle {
    in-out property <string> value;
    in property <color> preview-color;
    in property <length> input-height: 29px;
    property <bool> valid: true;
    callback apply-color(string) -> bool;
    width: 160px;
    height: root.input-height;

    HorizontalLayout {
        spacing: 6px;
        Rectangle {
            width: root.input-height;
            height: root.input-height;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: root.preview-color;
            color-button := TouchArea {
                mouse-cursor: pointer;
                clicked => { color-picker.show(); }
            }
        }

        color-input := BorderedLineInput {
            horizontal-stretch: 1;
            height: root.input-height;
            pad-x: 8px;
            text <=> root.value;
            font-family: Theme.term-font-family;
            font-size: 12px * Theme.panel-font;
            idle-border: root.valid ? Theme.border-subtle : #e05252;
            edited => { root.valid = root.apply-color(self.text); }
        }
    }

    color-picker := PopupWindow {
        x: parent.width - self.width;
        y: parent.height + 4px;
        width: 210px;
        height: 160px;
        Rectangle {
            background: Theme.popup-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 10px;
                spacing: 7px;
                Text {
                    text: root.value;
                    color: Theme.text-secondary;
                    font-family: Theme.term-font-family;
                    font-size: 11px * Theme.panel-font;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 6px;
                    CursorPaletteSwatch {
                        hex: "#D4D4D4";
                        swatch-color: #D4D4D4;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#FFFFFF";
                        swatch-color: #FFFFFF;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#FF5252";
                        swatch-color: #FF5252;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#FF9800";
                        swatch-color: #FF9800;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#FFD740";
                        swatch-color: #FFD740;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#69F0AE";
                        swatch-color: #69F0AE;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    CursorPaletteSwatch {
                        hex: "#00E676";
                        swatch-color: #00E676;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#00E5FF";
                        swatch-color: #00E5FF;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#40C4FF";
                        swatch-color: #40C4FF;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#448AFF";
                        swatch-color: #448AFF;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#7C4DFF";
                        swatch-color: #7C4DFF;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#E040FB";
                        swatch-color: #E040FB;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    CursorPaletteSwatch {
                        hex: "#F48FB1";
                        swatch-color: #F48FB1;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#FF8A65";
                        swatch-color: #FF8A65;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#FFF176";
                        swatch-color: #FFF176;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#A5D6A7";
                        swatch-color: #A5D6A7;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#80CBC4";
                        swatch-color: #80CBC4;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#90CAF9";
                        swatch-color: #90CAF9;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    CursorPaletteSwatch {
                        hex: "#B39DDB";
                        swatch-color: #B39DDB;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#CE93D8";
                        swatch-color: #CE93D8;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#BCAAA4";
                        swatch-color: #BCAAA4;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#9E9E9E";
                        swatch-color: #9E9E9E;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#607D8B";
                        swatch-color: #607D8B;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#2D2D2F";
                        swatch-color: #2D2D2F;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }
                }
            }
        }
    }
}

// A macOS-style wallpaper thumbnail: a rounded, clipped preview (passed via
// @children) with a selection ring + check badge. The label sits below it in
// the page, not inside.
component WallpaperSwatch inherits Rectangle {
    in property <bool> selected;
    callback clicked();
    width: 120px;
    height: 74px;
    border-radius: 8px;
    border-width: root.selected ? 3px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border-strong;
    clip: true;
    @children
    if root.selected: Rectangle {
        x: parent.width - self.width - 5px;
        y: 5px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: Theme.accent;
        Text {
            text: "\u{E5CA}"; // check
            font-family: "Material Icons";
            color: white;
            font-size: 13px * Theme.panel-font;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The settings content (nav + pages). Embedded in AppWindow's modal overlay.
export component InterfacePanel inherits Rectangle {
    in property <bool> lang-en;
    // Language preference: "auto" | "zh" | "en".
    in-out property <string> language-pref: "auto";
    in property <bool> is-windows;
    in-out property <string> renderer-mode: "software";
    in property <[string]> term-fonts;
    in property <string> term-font-family;
    in property <length> term-font-size;
    in-out property <float> terminal-line-spacing: 1.0;
    in-out property <bool> term-font-bold;
    in-out property <string> term-cursor-style: "bar";
    in-out property <string> term-cursor-color-hex: "#D4D4D4";
    in property <color> term-cursor-color: #D4D4D4;
    in-out property <bool> output-highlight-enabled;
    in-out property <bool> json-format-output: true;
    in-out property <string> output-highlight-preset;
    in property <[OutputRuleItem]> output-highlight-rules;
    in-out property <string> output-highlight-rule-status;
    // Draft colour for the add/edit form (validated hex + live swatch).
    in-out property <string> highlight-draft-color-hex: "#F14C4C";
    in-out property <color> highlight-draft-swatch: #F14C4C;
    in property <float> ui-scale;
    in-out property <bool> sftp-follow-cd;
    in-out property <bool> collapse-sftp-default;
    in-out property <bool> download-always-ask;
    in-out property <bool> paste-confirm-enabled: true;
    in-out property <bool> extra-paste-shortcuts-enabled: true;
    in-out property <bool> select-copy-right-paste-enabled: true;
    in-out property <bool> zen-mode: false;
    in-out property <bool> welcome-as-sidebar;
    in-out property <bool> confirm-delete-group-enabled: true;
    in-out property <bool> confirm-delete-session-enabled: false;
    in-out property <bool> welcome-single-click-connect: true;
    in-out property <bool> quick-commands-as-sidebar;
    in-out property <bool> update-check-enabled: false;
    in-out property <int> ssh-keepalive-secs: 0;
    in-out property <string> ssh-algorithm-category: "kex";
    in property <[AlgorithmOptionRow]> ssh-algorithm-rows;
    in-out property <bool> save-passwords: false;
    in-out property <bool> credentials-vault-available: true;
    in-out property <float> wallpaper-overlay;   // frosted-panel opacity 0.30-1.00
    // Active wallpaper id: "" / "builtin:light" / "builtin:dark" / a file path.
    in property <string> current-wallpaper;
    in property <string> custom-wallpaper-name;   // basename for the file row

    // Styling mock can open directly on the Output page (see app.slint flag).
    in property <string> ifd-start-page: "font";
    property <string> ifd-page: root.ifd-start-page;
    property <int> rule-edit-index: -1;   // -1 = add, >=0 = edit that rule
    property <string> new-rule-name;
    property <string> new-rule-pattern;
    property <bool> new-rule-regex;
    property <bool> new-rule-case-sensitive;
    property <bool> new-rule-whole-line;
    property <bool> renderer-restart-required;
    property <bool> wp-is-custom:
        root.current-wallpaper != "" && root.current-wallpaper != "builtin:light"
        && root.current-wallpaper != "builtin:dark" && root.current-wallpaper != "builtin:tech"
        && root.current-wallpaper != "builtin:miku" && root.current-wallpaper != "builtin:ms";

    // Shared left-column width for the custom-rule form (locale-aware).
    property <string> rule-name-label: root.lang-en ? "Rule name" : "规则名称";
    property <string> rule-pattern-label: root.lang-en
        ? "Keyword or regular expression" : "关键词或正则表达式";
    property <length> rule-form-label-width:
        max(m-rule-name.preferred-width, m-rule-pattern.preferred-width);

    callback set-term-font(string);
    callback set-term-font-size(int);
    callback set-terminal-line-spacing(float);
    callback set-term-font-bold(bool);
    callback set-term-cursor-style(string);
    callback set-term-cursor-color(string) -> bool;
    callback set-output-highlight(bool, string);
    callback set-json-format-output(bool);
    callback set-highlight-draft-color(string) -> bool;
    // name, pattern, regex, case-sensitive, whole-line, color
    callback add-output-highlight-rule(string, string, bool, bool, bool, string) -> bool;
    callback update-output-highlight-rule(int, string, string, bool, bool, bool, string) -> bool;
    callback remove-output-highlight-rule(int);
    callback set-output-highlight-rule-enabled(int, bool);

    function reset-rule-form() {
        root.rule-edit-index = -1;
        root.new-rule-name = "";
        root.new-rule-pattern = "";
        root.new-rule-regex = false;
        root.new-rule-case-sensitive = false;
        root.new-rule-whole-line = false;
        root.highlight-draft-color-hex = "#F14C4C";
        root.highlight-draft-swatch = #F14C4C;
        root.output-highlight-rule-status = "";
    }

    function load-rule-into-form(index: int) {
        if (index < 0 || index >= root.output-highlight-rules.length) {
            return;
        }
        root.rule-edit-index = index;
        root.new-rule-name = root.output-highlight-rules[index].name;
        root.new-rule-pattern = root.output-highlight-rules[index].pattern;
        root.new-rule-regex = root.output-highlight-rules[index].regex;
        root.new-rule-case-sensitive = root.output-highlight-rules[index].case-sensitive;
        root.new-rule-whole-line = root.output-highlight-rules[index].whole-line;
        root.highlight-draft-color-hex = root.output-highlight-rules[index].color;
        root.highlight-draft-swatch = root.output-highlight-rules[index].swatch;
        root.output-highlight-rule-status = "";
    }

    function save-rule-form() -> bool {
        if (root.rule-edit-index >= 0) {
            return root.update-output-highlight-rule(
                root.rule-edit-index,
                root.new-rule-name,
                root.new-rule-pattern,
                root.new-rule-regex,
                root.new-rule-case-sensitive,
                root.new-rule-whole-line,
                root.highlight-draft-color-hex);
        }
        return root.add-output-highlight-rule(
            root.new-rule-name,
            root.new-rule-pattern,
            root.new-rule-regex,
            root.new-rule-case-sensitive,
            root.new-rule-whole-line,
            root.highlight-draft-color-hex);
    }
    callback set-ui-scale(int);
    callback set-panel-font(int);   // settings-panel font scale, percent
    callback set-renderer-mode(string);
    callback set-sftp-follow-cd(bool);
    callback set-collapse-sftp-default(bool);
    callback set-download-always-ask(bool);
    callback set-paste-confirm-enabled(bool);
    callback set-extra-paste-shortcuts-enabled(bool);
    callback set-select-copy-right-paste-enabled(bool);
    callback set-zen-mode(bool);
    callback set-welcome-as-sidebar(bool);
    callback set-confirm-delete-group-enabled(bool);
    callback set-confirm-delete-session-enabled(bool);
    callback set-welcome-single-click-connect(bool);
    callback set-quick-commands-as-sidebar(bool);
    callback set-update-check-enabled(bool);   // startup new-version check (#184)
    callback set-ssh-keepalive-secs(int);
    callback set-ssh-algorithm-category(string);
    callback toggle-ssh-algorithm(string);
    callback move-ssh-algorithm(string, int);
    callback reset-ssh-algorithm-section();
    callback reset-ssh-algorithms();
    callback set-language(string);             // "auto" / "zh" / "en"
    callback persist-wallpaper-overlay(float);   // save the overlay opacity
    callback set-wallpaper(string);    // none / builtin selection
    callback pick-wallpaper-file();    // open the OS file dialog (Rust)
    callback set-save-passwords(bool);
    callback request-clear-known-hosts();
    callback request-clear-sessions();
    callback request-clear-passwords();
    callback request-restore-settings();

    // Off-screen label probes used only to compute `rule-form-label-width`.
    Rectangle {
        x: -10000px;
        y: -10000px;
        width: 0px;
        height: 0px;
        clip: true;
        VerticalLayout {
            m-rule-name := Text {
                text: root.rule-name-label;
                font-size: Theme.fs-sm;
            }
            m-rule-pattern := Text {
                text: root.rule-pattern-label;
                font-size: Theme.fs-sm;
            }
        }
    }

    HorizontalLayout {
        // --- Left nav ------------------------------------------------------
        Rectangle {
            width: 168px;
            // Transparent so the whole dialog is one frosted layer (the card's
            // bg-panel); a 1px divider keeps the nav/content separation (items 6/7).
            background: transparent;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: Theme.border-subtle;
            }

            nav-scroll := ScrollView {
                width: 100%;
                height: 100%;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, nav-items.preferred-height);
                nav-items := VerticalLayout {
                    width: nav-scroll.visible-width;
                    padding: 8px;
                    spacing: 2px;
                    alignment: start;
                    NavItem {
                        icon: "\u{E167}";
                        label: root.lang-en ? "Font" : "字体";
                        active: root.ifd-page == "font";
                        clicked => { root.ifd-page = "font"; }
                    }

                    NavItem {
                        icon: "\u{E312}";
                        label: root.lang-en ? "Input" : "输入";
                        active: root.ifd-page == "input";
                        clicked => { root.ifd-page = "input"; }
                    }

                    NavItem {
                        icon: "\u{E1B1}";
                        label: root.lang-en ? "Rendering" : "渲染";
                        active: root.ifd-page == "renderer";
                        clicked => { root.ifd-page = "renderer"; }
                    }

                    NavItem {
                        icon: "\u{E8D4}";
                        label: root.lang-en ? "Output" : "输出高亮";
                        active: root.ifd-page == "output";
                        clicked => { root.ifd-page = "output"; }
                    }

                    NavItem {
                        icon: "\u{E1BC}";
                        label: root.lang-en ? "Wallpaper" : "壁纸";
                        active: root.ifd-page == "wallpaper";
                        clicked => { root.ifd-page = "wallpaper"; }
                    }

                    NavItem {
                        icon: "\u{F013}";
                        label: "SSH / SFTP";
                        active: root.ifd-page == "ssh";
                        clicked => { root.ifd-page = "ssh"; }
                    }

                    NavItem {
                        icon: "\u{E314}";
                        label: root.lang-en ? "Sidebars" : "侧栏";
                        active: root.ifd-page == "sidebar";
                        clicked => { root.ifd-page = "sidebar"; }
                    }

                    NavItem {
                        icon: "\u{E88A}";
                        label: root.lang-en ? "Welcome page" : "欢迎页";
                        active: root.ifd-page == "welcome";
                        clicked => { root.ifd-page = "welcome"; }
                    }

                    NavItem {
                        icon: "\u{E1DB}";
                        label: root.lang-en ? "Data" : "数据";
                        active: root.ifd-page == "data";
                        clicked => { root.ifd-page = "data"; }
                    }

                    NavItem {
                        icon: "\u{E894}";
                        label: root.lang-en ? "Language" : "语言";
                        active: root.ifd-page == "language";
                        clicked => { root.ifd-page = "language"; }
                    }

                    NavItem {
                        icon: "\u{E923}";
                        label: root.lang-en ? "Update check" : "新版本提示";
                        active: root.ifd-page == "update";
                        clicked => { root.ifd-page = "update"; }
                    }
                }
            }
        }

        // --- Right content -------------------------------------------------
        Rectangle {
            horizontal-stretch: 1;
            // Transparent: the card's single bg-panel frost shows through, so the
            // settings panel matches the welcome panel and tracks the
            // wallpaper-opacity slider (items 6/7).
            background: transparent;

            settings-scroll := ScrollView {
                width: 100%;
                height: 100%;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, settings-pages.preferred-height);

                settings-pages := VerticalLayout {
                    width: settings-scroll.visible-width;

                    // --- Font page ---------------------------------------------
                    if root.ifd-page == "font": VerticalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 15px;
                        spacing: 0;
                        alignment: start;

                        SectionHeader {
                            text: root.lang-en ? "FONT" : "字体";
                        }

                        SettingRow {
                            label: root.lang-en ? "Terminal font" : "终端字体";
                            ComboBox {
                                width: 150px;
                                height: 30px;
                                model: root.term-fonts;
                                current-value: root.term-font-family;
                                selected(v) => { root.set-term-font(v); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Terminal font size" : "终端字体大小";
                            Stepper {
                                value: root.term-font-size / 1px;
                                minimum: 8;
                                maximum: 32;
                                step: 1;
                                unit: "px";
                                changed(v) => { root.set-term-font-size(v); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Terminal line spacing" : "终端行距";
                            desc: root.lang-en ? "Adjust terminal row height from compact to loose."
                                : "调整终端行高，可设置得更紧凑或更宽松。";
                            Stepper {
                                value: round(root.terminal-line-spacing * 100);
                                minimum: 80;
                                maximum: 150;
                                step: 5;
                                unit: "%";
                                changed(v) => { root.terminal-line-spacing = v / 100; root.set-terminal-line-spacing(root.terminal-line-spacing); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Installed fonts" : "已安装字体";
                            desc: root.lang-en
                                ? "Install a TTF/OTF font in Windows, then restart ZinTerm to refresh this list."
                                : "在 Windows 中安装 TTF/OTF 字体后，重启 ZinTerm 即可刷新字体列表。";
                            show-divider: false;
                            Rectangle {
                                width: 1px;
                                height: 1px;
                                background: transparent;
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Bold terminal text" : "终端字体加粗";
                            desc: root.lang-en ? "Makes regular terminal output use a bold face."
                                : "让普通终端输出使用加粗字重。";
                            Switch {
                                on: root.term-font-bold;
                                toggled(v) => { root.term-font-bold = v; root.set-term-font-bold(v); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Cursor shape" : "光标类型";
                            desc: root.lang-en ? "Choose the terminal insertion cursor shape."
                                : "选择终端输入光标的形状。";
                            HorizontalLayout {
                                spacing: 5px;
                                CursorStyleButton {
                                    label: root.lang-en ? "Block" : "块状";
                                    cursor-kind: "block";
                                    selected: root.term-cursor-style == "block";
                                    clicked => { root.term-cursor-style = "block"; root.set-term-cursor-style("block"); }
                                }

                                CursorStyleButton {
                                    label: root.lang-en ? "Bar" : "竖线";
                                    cursor-kind: "bar";
                                    selected: root.term-cursor-style == "bar";
                                    clicked => { root.term-cursor-style = "bar"; root.set-term-cursor-style("bar"); }
                                }

                                CursorStyleButton {
                                    label: root.lang-en ? "Line" : "下划线";
                                    cursor-kind: "underline";
                                    selected: root.term-cursor-style == "underline";
                                    clicked => { root.term-cursor-style = "underline"; root.set-term-cursor-style("underline"); }
                                }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Cursor color" : "光标颜色";
                            desc: root.lang-en ? "Enter a hexadecimal RGB color."
                                : "输入十六进制 RGB 颜色。";
                            CursorColorInput {
                                width: 100px;
                                value <=> root.term-cursor-color-hex;
                                preview-color: root.term-cursor-color;
                                apply-color(v) => { root.set-term-cursor-color(v) }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "UI scale" : "界面缩放";
                            desc: root.lang-en ? "Zooms the whole interface (not this panel)."
                                : "缩放整个界面(不影响本面板)。";
                            Stepper {
                                value: round(root.ui-scale * 100);
                                minimum: 80;
                                maximum: 200;
                                step: 10;
                                unit: "%";
                                changed(v) => { root.set-ui-scale(v); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Settings font size" : "界面字体大小";
                            desc: root.lang-en ? "Enlarges this settings panel (font + window)."
                                : "放大本设置面板的字体和窗口。";
                            show-divider: false;
                            Stepper {
                                value: round(Theme.panel-font * 100);
                                minimum: 80;
                                maximum: 160;
                                step: 10;
                                unit: "%";
                                changed(v) => { root.set-panel-font(v); }
                            }
                        }

                        Rectangle {
                            height: 14px;
                        }

                        SectionHeader {
                            text: root.lang-en ? "PREVIEW" : "预览";
                        }

                        Rectangle {
                            height: 52px;
                            background: Theme.term-bg;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            Text {
                                x: 12px;
                                text: "ZinTerm ~$ echo preview 0123";
                                font-family: Theme.term-font-family;
                                font-size: Theme.term-font-size;
                                font-weight: Theme.term-font-bold ? 700 : 400;
                                color: Theme.term-fg;
                                vertical-alignment: center;
                                height: parent.height;
                            }
                        }
                    }

                    // --- Input page -------------------------------------------
                    if root.ifd-page == "input": VerticalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 15px;
                        spacing: 0;
                        alignment: start;

                        SectionHeader {
                            text: root.lang-en ? "INPUT" : "输入";
                        }

                        SettingRow {
                            label: root.lang-en ? "Confirm multiline paste" : "确认多行粘贴";
                            desc: root.lang-en ? "Show a review dialog before sending multiline content."
                                : "发送多行内容前显示预览确认窗口。";
                            Switch {
                                on: root.paste-confirm-enabled;
                                toggled(v) => { root.paste-confirm-enabled = v; root.set-paste-confirm-enabled(v); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Select to copy / right-click paste" : "选中复制/右键粘贴";
                            desc: root.lang-en
                                ? "Auto-copy selected text; right-click pastes. When off, the right-click context menu is used instead."
                                : "选中文字自动复制到剪贴板；右键粘贴。关闭后恢复右键上下文菜单。";
                            Switch {
                                on: root.select-copy-right-paste-enabled;
                                toggled(v) => {
                                    root.select-copy-right-paste-enabled = v;
                                    root.set-select-copy-right-paste-enabled(v);
                                }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Additional paste shortcuts" : "额外粘贴快捷键";
                            desc: root.lang-en ? "Enable Ctrl+Alt+V, Shift+Insert, and middle-click paste."
                                : "启用 Ctrl+Alt+V、Shift+Insert 和鼠标中键粘贴。";
                            show-divider: false;
                            Switch {
                                on: root.extra-paste-shortcuts-enabled;
                                toggled(v) => { root.extra-paste-shortcuts-enabled = v; root.set-extra-paste-shortcuts-enabled(v); }
                            }
                        }
                    }

                    // --- Renderer page (#280) ---------------------------------
                    if root.ifd-page == "renderer": VerticalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 15px;
                        spacing: 0;
                        alignment: start;

                        SectionHeader {
                            text: root.lang-en ? "RENDERING" : "渲染";
                        }

                        SettingRow {
                            label: root.lang-en ? "Renderer" : "渲染器";
                            desc: Theme.is-mac
                                ? (root.lang-en
                                ? "CPU is the compatibility default. FemtoVG and Skia use GPU acceleration."
                                : "CPU 是兼容性默认渲染器；FemtoVG 和 Skia 使用 GPU 加速。")
                                : (root.lang-en
                                ? "Auto tries GPU acceleration and lets Slint fall back to software. Software is best for VMs and compatibility."
                                : "自动模式会尝试 GPU 加速，并由 Slint 在初始化失败时回退到软件渲染；虚拟机或兼容性优先时请选择软件。");
                            show-divider: false;
                            ComboBox {
                                width: 150px;
                                height: 30px;
                                model: Theme.is-mac
                                    ? ["CPU", "FemtoVG", "Skia"]
                                    : (root.lang-en
                                    ? ["Automatic", "GPU", "Software"]
                                    : ["自动", "GPU", "软件"]);
                                current-value: Theme.is-mac
                                    ? (root.renderer-mode == "skia"
                                    ? "Skia"
                                    : root.renderer-mode == "femtovg" ? "FemtoVG" : "CPU")
                                    : (root.renderer-mode == "auto"
                                    ? (root.lang-en ? "Automatic" : "自动")
                                    : root.renderer-mode == "gpu"
                                    ? "GPU"
                                    : (root.lang-en ? "Software" : "软件"));
                                selected(v) => {
                                    if (Theme.is-mac && v == "CPU"
                                        && root.renderer-mode != "software") {
                                        root.renderer-mode = "software";
                                        root.set-renderer-mode("software");
                                        root.renderer-restart-required = true;
                                    } else if (Theme.is-mac && v == "FemtoVG"
                                        && root.renderer-mode != "femtovg") {
                                        root.renderer-mode = "femtovg";
                                        root.set-renderer-mode("femtovg");
                                        root.renderer-restart-required = true;
                                    } else if (Theme.is-mac && v == "Skia"
                                        && root.renderer-mode != "skia") {
                                        root.renderer-mode = "skia";
                                        root.set-renderer-mode("skia");
                                        root.renderer-restart-required = true;
                                    } else if (!Theme.is-mac && (v == "Automatic" || v == "自动")
                                        && root.renderer-mode != "auto") {
                                        root.renderer-mode = "auto";
                                        root.set-renderer-mode("auto");
                                        root.renderer-restart-required = true;
                                    } else if (!Theme.is-mac && v == "GPU" && root.renderer-mode != "gpu") {
                                        root.renderer-mode = "gpu";
                                        root.set-renderer-mode("gpu");
                                        root.renderer-restart-required = true;
                                    } else if (!Theme.is-mac && (v == "Software" || v == "软件")
                                        && root.renderer-mode != "software") {
                                        root.renderer-mode = "software";
                                        root.set-renderer-mode("software");
                                        root.renderer-restart-required = true;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 10px;
                        }

                        SettingHint {
                            text: root.renderer-restart-required
                                ? (root.lang-en
                                ? "Restart ZinTerm to apply the renderer change."
                                : "重启 ZinTerm 后渲染器设置才会生效。")
                                : (root.lang-en
                                ? (Theme.is-mac
                                ? "CPU is the default renderer on macOS."
                                : (root.is-windows
                                ? "Software remains the compatibility default for existing installations."
                                : "Automatic remains the default renderer on Linux."))
                                : (Theme.is-mac
                                ? "macOS 默认使用 CPU 渲染器。"
                                : (root.is-windows
                                ? "现有安装继续默认使用兼容性更好的软件渲染。"
                                : "Linux 默认继续使用自动渲染器。")));
                            color: root.renderer-restart-required ? Theme.accent : Theme.text-muted;
                        }
                    }

                    // --- Output highlighting page -----------------------------
                    if root.ifd-page == "output": VerticalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 15px;
                        spacing: 0;
                        alignment: start;

                        SectionHeader {
                            text: root.lang-en ? "OUTPUT HIGHLIGHTING" : "输出高亮";
                        }

                        SettingRow {
                            label: root.lang-en ? "Highlight plain terminal output" : "高亮纯文本终端输出";
                            desc: root.lang-en
                                ? "Adds client-side colours only when the program did not provide ANSI styling."
                                : "仅在程序未提供 ANSI 样式时由客户端补充颜色。";
                            Switch {
                                on: root.output-highlight-enabled;
                                toggled(v) => {
                                    root.output-highlight-enabled = v;
                                    root.set-output-highlight(v, root.output-highlight-preset);
                                }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Built-in rule set" : "内置规则集";
                            desc: root.lang-en
                                ? "Log levels is conservative; DevOps also recognises deployment and health states."
                                : "日志级别更保守；DevOps 还识别部署与健康状态。";
                            show-divider: false;
                            ComboBox {
                                width: 150px;
                                height: 30px;
                                enabled: root.output-highlight-enabled;
                                model: [root.lang-en ? "Log levels" : "日志级别", "DevOps"];
                                current-value: root.output-highlight-preset == "devops"
                                    ? "DevOps"
                                    : (root.lang-en ? "Log levels" : "日志级别");
                                selected(v) => {
                                    root.output-highlight-preset = v == "DevOps" ? "devops" : "log";
                                    root.set-output-highlight(
                                root.output-highlight-enabled,
                                root.output-highlight-preset);
                                }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Format and colour JSON lines" : "格式化并着色 JSON 行";
                            desc: root.lang-en
                                ? "Pretty-prints only complete JSON objects or arrays that occupy a whole terminal line. Other output is unchanged."
                                : "仅美化占据完整一行且可正确解析的 JSON 对象或数组，其他终端输出保持原样。";
                            show-divider: false;
                            Switch {
                                on: root.json-format-output;
                                toggled(v) => {
                                    root.json-format-output = v;
                                    root.set-json-format-output(v);
                                }
                            }
                        }

                        Rectangle {
                            height: 18px;
                        }

                        SectionHeader {
                            text: root.lang-en ? "PREVIEW" : "预览";
                        }

                        Rectangle {
                            height: root.output-highlight-preset == "devops" ? 116px : 92px;
                            background: Theme.term-bg;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 5px;
                                Text {
                                    text: "DEBUG cache lookup";
                                    color: root.output-highlight-enabled ? Theme.text-muted : Theme.term-fg;
                                    font-family: Theme.term-font-family;
                                    font-size: 12px;
                                }

                                Text {
                                    text: "INFO server ready";
                                    color: root.output-highlight-enabled ? Theme.accent : Theme.term-fg;
                                    font-family: Theme.term-font-family;
                                    font-size: 12px;
                                }

                                Text {
                                    text: "WARN disk nearly full";
                                    color: root.output-highlight-enabled ? Theme.warning : Theme.term-fg;
                                    font-family: Theme.term-font-family;
                                    font-size: 12px;
                                }

                                Text {
                                    text: "ERROR connection failed";
                                    color: root.output-highlight-enabled ? Theme.danger : Theme.term-fg;
                                    font-family: Theme.term-font-family;
                                    font-size: 12px;
                                }

                                if root.output-highlight-preset == "devops": Text {
                                    text: "SUCCESS deployment completed";
                                    color: root.output-highlight-enabled ? Theme.success : Theme.term-fg;
                                    font-family: Theme.term-font-family;
                                    font-size: 12px;
                                }
                            }
                        }

                        Rectangle {
                            height: 18px;
                        }

                        SectionHeader {
                            text: root.lang-en ? "CUSTOM RULES" : "自定义规则";
                        }

                        SettingHint {
                            text: root.lang-en
                                ? "Custom rules run before the built-in preset and never overwrite ANSI colours."
                                : "自定义规则优先于内置规则，且不会覆盖程序输出的 ANSI 颜色。";
                        }

                        Rectangle {
                            height: 10px;
                        }

                        LabeledInput {
                            label: root.rule-name-label;
                            label-width: root.rule-form-label-width;
                            placeholder: root.lang-en ? "Timeout errors" : "超时错误";
                            value <=> root.new-rule-name;
                            accepted => {
                                if root.new-rule-name != "" && root.new-rule-pattern != ""
                                    && root.save-rule-form() {
                                    root.reset-rule-form();
                                }
                            }
                        }

                        Rectangle {
                            height: 8px;
                        }

                        LabeledInput {
                            label: root.rule-pattern-label;
                            label-width: root.rule-form-label-width;
                            placeholder: root.new-rule-regex ? "timeout|connection refused" : "connection refused";
                            value <=> root.new-rule-pattern;
                            accepted => {
                                if root.new-rule-name != "" && root.new-rule-pattern != ""
                                    && root.save-rule-form() {
                                    root.reset-rule-form();
                                }
                            }
                        }

                        Rectangle {
                            height: 8px;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            CompactCheckBox {
                                text: root.lang-en ? "Regex" : "正则";
                                gap: 4px;
                                checked: root.new-rule-regex;
                                toggled => { root.new-rule-regex = self.checked; }
                            }

                            CompactCheckBox {
                                text: root.lang-en ? "Case sensitive" : "区分大小写";
                                gap: 4px;
                                checked: root.new-rule-case-sensitive;
                                toggled => { root.new-rule-case-sensitive = self.checked; }
                            }

                            CompactCheckBox {
                                text: root.lang-en ? "Whole line" : "高亮整行";
                                gap: 4px;
                                checked: root.new-rule-whole-line;
                                toggled => { root.new-rule-whole-line = self.checked; }
                            }

                            CursorColorInput {
                                input-height: 20px;
                                width: 100px;
                                value <=> root.highlight-draft-color-hex;
                                preview-color: root.highlight-draft-swatch;
                                apply-color(v) => { root.set-highlight-draft-color(v) }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            if root.rule-edit-index >= 0: GhostButton {
                                text: root.lang-en ? "Cancel" : "取消";
                                clicked => { root.reset-rule-form(); }
                            }

                            PrimaryButton {
                                text: root.rule-edit-index >= 0
                                    ? (root.lang-en ? "Save" : "保存")
                                    : (root.lang-en ? "Add rule" : "添加规则");
                                disabled: root.new-rule-name == "" || root.new-rule-pattern == "";
                                clicked => {
                                    if root.save-rule-form() {
                                        root.reset-rule-form();
                                    }
                                }
                            }
                        }

                        if root.output-highlight-rule-status != "": SettingHint {
                            text: root.output-highlight-rule-status;
                            color: Theme.danger;
                        }

                        if root.output-highlight-rules.length == 0: SettingHint {
                            text: root.lang-en ? "No custom rules yet." : "暂无自定义规则。";
                            height: 34px;
                            vertical-alignment: center;
                        }

                        if root.output-highlight-rules.length > 0: Rectangle {
                            height: 8px;
                        }
                        for rule[index] in root.output-highlight-rules: Rectangle {
                            height: 44px;
                            background: root.rule-edit-index == index
                                ? Theme.bg-active : transparent;
                            border-radius: Theme.radius-md;
                            Rectangle {
                                y: 0px;
                                width: 100%;
                                height: 1px;
                                background: Theme.border-subtle;
                            }

                            HorizontalLayout {
                                spacing: 9px;
                                cross-axis-alignment: center;

                                Text{}

                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: rule.swatch;
                                    vertical-stretch: 0;
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: rule.name;
                                        color: rule.enabled ? Theme.text-primary : Theme.text-muted;
                                        font-family: Theme.term-font-family;
                                        font-size: 12px * Theme.panel-font;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: rule.pattern + " · "
                                            + (rule.regex ? "Regex" : (root.lang-en ? "Keyword" : "关键词"))
                                            + (rule.case-sensitive ? " · Aa" : "")
                                            + (rule.whole-line ? (root.lang-en ? " · whole line" : " · 整行") : "");
                                        color: Theme.text-muted;
                                        font-size: 10px * Theme.panel-font;
                                        overflow: elide;
                                    }
                                }

                                Switch {
                                    on: rule.enabled;
                                    toggled(v) => { root.set-output-highlight-rule-enabled(index, v); }
                                }

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 5px;
                                    background: edit-ta.has-hover ? Theme.bg-hover : transparent;
                                    edit-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.load-rule-into-form(index); }
                                    }

                                    Text {
                                        text: "\u{E3C9}";
                                        font-family: "Material Icons";
                                        color: Theme.text-muted;
                                        font-size: 15px * Theme.panel-font;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 5px;
                                    background: delete-ta.has-hover ? Theme.bg-hover : transparent;
                                    delete-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (root.rule-edit-index == index) {
                                                root.reset-rule-form();
                                            } else if (root.rule-edit-index > index) {
                                                root.rule-edit-index = root.rule-edit-index - 1;
                                            }
                                            root.remove-output-highlight-rule(index);
                                        }
                                    }

                                    Text {
                                        text: "\u{E872}";
                                        font-family: "Material Icons";
                                        color: Theme.text-muted;
                                        font-size: 15px * Theme.panel-font;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // --- Wallpaper page ----------------------------------------
                    if root.ifd-page == "wallpaper": VerticalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 15px;
                        spacing: 0;
                        alignment: start;

                        SectionHeader {
                            text: root.lang-en ? "WALLPAPER" : "壁纸";
                        }

                        SettingHint {
                            text: root.lang-en
                                ? "Pick a wallpaper — the interface tints itself to match (accent, panels, light/dark)."
                                : "选一张壁纸,界面会沉浸式地适配它的颜色(强调色、面板、深浅)。";
                        }

                        Rectangle {
                            height: 12px;
                        }

                        // Built-in choices: keep this row horizontally scrollable as
                        // bundled wallpapers grow.
                        builtin-wallpapers-scroll := ScrollView {
                            height: 106px;
                            width: 100%;
                            viewport-width: max(self.visible-width, builtin-wallpapers-row.preferred-width);
                            viewport-height: self.visible-height;

                            builtin-wallpapers-row := HorizontalLayout {
                                spacing: 11px;
                                alignment: start;
                                VerticalLayout {
                                    spacing: 5px;
                                    WallpaperSwatch {
                                        width: 100px;
                                        selected: root.current-wallpaper == "";
                                        clicked => { root.set-wallpaper(""); }
                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            background: Theme.window-base;
                                            Text {
                                                text: "\u{E14C}"; // clear / none
                                    font-family: "Material Icons";
                                                color: Theme.text-muted;
                                                font-size: 22px * Theme.panel-font;
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.lang-en ? "None" : "无";
                                        font-size: 11px * Theme.panel-font;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 5px;
                                    WallpaperSwatch {
                                        width: 100px;
                                        selected: root.current-wallpaper == "builtin:light";
                                        clicked => { root.set-wallpaper("builtin:light"); }
                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            background: @linear-gradient(135deg, #eff3fb 0%, #d5e1f2 100%);
                                            Rectangle {
                                                x: parent.width * 0.66;
                                                y: -parent.height * 0.2;
                                                width: 56px;
                                                height: 56px;
                                                border-radius: 28px;
                                                background: #4a90e2;
                                                opacity: 0.30;
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.lang-en ? "Meat Light" : "简约·浅";
                                        font-size: 11px * Theme.panel-font;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 5px;
                                    WallpaperSwatch {
                                        width: 100px;
                                        selected: root.current-wallpaper == "builtin:dark";
                                        clicked => { root.set-wallpaper("builtin:dark"); }
                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            background: @linear-gradient(135deg, #10131a 0%, #1b2233 100%);
                                            Rectangle {
                                                x: parent.width * 0.66;
                                                y: -parent.height * 0.2;
                                                width: 56px;
                                                height: 56px;
                                                border-radius: 28px;
                                                background: #4a6ce0;
                                                opacity: 0.40;
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.lang-en ? "Meat Dark" : "简约·暗";
                                        font-size: 11px * Theme.panel-font;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 5px;
                                    WallpaperSwatch {
                                        width: 100px;
                                        selected: root.current-wallpaper == "builtin:tech";
                                        clicked => { root.set-wallpaper("builtin:tech"); }
                                        Rectangle {
                                            width: 100%;
                                            height: 100%;
                                            background: @linear-gradient(180deg, #05060f 0%, #0b1430 55%, #1a0a2e 100%);
                                            clip: true;
                                            // glowing planet
                                            Rectangle {
                                                x: parent.width * 0.5 - 16px;
                                                y: parent.height * 0.22;
                                                width: 32px;
                                                height: 32px;
                                                border-radius: 16px;
                                                background: @radial-gradient(circle, #ff5ea8 0%, #ff5ea800 70%);
                                            }
                                            // neon horizon line
                                            Rectangle {
                                                y: parent.height * 0.58;
                                                width: parent.width;
                                                height: 2px;
                                                background: #19e6ff;
                                                opacity: 0.85;
                                            }
                                        }
                                    }

                                    Text {
                                        text: root.lang-en ? "Fantasy 3048" : "幻想3048";
                                        font-size: 11px * Theme.panel-font;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 5px;
                                    WallpaperSwatch {
                                        width: 100px;
                                        selected: root.current-wallpaper == "builtin:ms";
                                        clicked => { root.set-wallpaper("builtin:ms"); }
                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            source: @image-url("../assets/ms.jpg");
                                            image-fit: cover;
                                        }
                                    }

                                    Text {
                                        text: "MS";
                                        font-size: 11px * Theme.panel-font;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 5px;
                                    WallpaperSwatch {
                                        width: 100px;
                                        selected: root.current-wallpaper == "builtin:miku";
                                        clicked => { root.set-wallpaper("builtin:miku"); }
                                        Image {
                                            width: 100%;
                                            height: 100%;
                                            source: @image-url("../assets/miku.jpg");
                                            image-fit: cover;
                                        }
                                    }

                                    Text {
                                        text: "Miku";
                                        font-size: 11px * Theme.panel-font;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            height: 16px;
                        }

                        SectionHeader {
                            text: root.lang-en ? "CUSTOM" : "自定义";
                        }

                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;
                            WallpaperSwatch {
                                selected: root.wp-is-custom;
                                clicked => { root.pick-wallpaper-file(); }
                                // Show the real image when a custom one is active, else a
                                // "choose a file" placeholder.
                                if root.wp-is-custom: Image {
                                    width: 100%;
                                    height: 100%;
                                    source: Theme.wallpaper;
                                    image-fit: cover;
                                }
                                if !root.wp-is-custom: Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    background: Theme.bg-elevated;
                                    Text {
                                        text: "\u{E2C6}"; // folder-open
                                font-family: "Material Icons";
                                        color: Theme.text-secondary;
                                        font-size: 22px * Theme.panel-font;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Rectangle {
                                    width: 130px;
                                    height: 30px;
                                    border-radius: 6px;
                                    background: pick-ta.has-hover ? Theme.accent-hover : Theme.accent;
                                    pick-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.pick-wallpaper-file(); }
                                    }

                                    Text {
                                        text: root.lang-en ? "Choose file…" : "选择文件…";
                                        color: white;
                                        font-size: 12px * Theme.panel-font;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.wp-is-custom: Text {
                                    text: root.custom-wallpaper-name;
                                    color: Theme.text-muted;
                                    font-size: 11px * Theme.panel-font;
                                    width: 150px;
                                    overflow: elide;
                                }
                            }
                        }

                        Rectangle {
                            height: 16px;
                        }

                        SectionHeader {
                            text: root.lang-en ? "OVERLAY" : "遮罩";
                        }

                        SettingRow {
                            label: root.lang-en ? "Wallpaper transparency" : "壁纸遮罩透明度";
                            desc: root.lang-en
                                ? "How much the wallpaper shows through panels and the terminal (no effect without a wallpaper)."
                                : "壁纸透过面板 / 终端背景的程度,越往右越透;没设壁纸时不生效。";
                            show-divider: false;
                            HorizontalLayout {
                                spacing: 8px;
                                Slider {
                                    width: 150px;
                                    minimum: 0;
                                    // Up to 70% transparency (overlay floor 0.30).
                                    maximum: 70;
                                    value: (1.0 - root.wallpaper-overlay) * 100;
                                    changed(v) => { root.wallpaper-overlay = 1.0 - v / 100; }
                                    released(v) => { root.persist-wallpaper-overlay(1.0 - v / 100); }
                                }

                                Text {
                                    text: "\{round((1.0 - root.wallpaper-overlay) * 100)}%";
                                    color: Theme.text-secondary;
                                    font-size: 12px * Theme.panel-font;
                                    vertical-alignment: center;
                                    width: 34px;
                                }
                            }
                        }
                    }

                    // --- SSH / SFTP page ----------------------------------------
                    if root.ifd-page == "ssh": VerticalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 15px;
                        spacing: 0;
                        alignment: start;
                        SectionHeader {
                            text: "SSH";
                        }

                        SettingRow {
                            label: root.lang-en ? "Keepalive interval" : "保活间隔";
                            desc: root.lang-en
                                ? "0 disables keepalive. A positive value is the interval in seconds. Some older switches drop OpenSSH keepalive packets — leave this at 0 for those devices. Applies to new connections."
                                : "0 表示关闭。正整数为间隔秒数。部分老旧交换机可能因 OpenSSH keepalive 断开，此类设备请保持为 0。对新连接生效。";
                            Stepper {
                                value: root.ssh-keepalive-secs;
                                minimum: 0;
                                maximum: 3600;
                                step: 5;
                                unit: "s";
                                changed(v) => {
                                    root.ssh-keepalive-secs = v;
                                    root.set-ssh-keepalive-secs(v);
                                }
                            }
                        }

                        SectionHeader {
                            text: root.lang-en ? "SSH ALGORITHMS" : "SSH 算法";
                        }

                        SettingHint {
                            text: root.lang-en
                                ? "Choose which algorithms are offered (order = preference). Leaving the built-in defaults enables an automatic compact retry for very old devices. Custom lists are applied strictly. Takes effect on new connections."
                                : "勾选要协商的算法（顺序即优先级）。保持内置默认时，会对极老设备自动尝试精简兼容配置；自定义后严格按所选列表协商。对新连接生效。";
                        }

                        SettingRow {
                            label: root.lang-en ? "Category" : "算法类别";
                            desc: root.lang-en
                                ? "Key exchange, host key, cipher, MAC, or compression."
                                : "密钥交换、主机密钥、加密、消息认证码或压缩。";
                            ComboBox {
                                width: 150px;
                                height: 30px;
                                model: root.lang-en
                                    ? ["Key exchange", "Host key", "Cipher", "MAC", "Compression"]
                                    : ["密钥交换", "主机密钥", "加密算法", "消息认证码", "压缩算法"];
                                current-index: root.ssh-algorithm-category == "serverHostKey" ? 1
                                    : (root.ssh-algorithm-category == "cipher" ? 2
                                    : (root.ssh-algorithm-category == "hmac" ? 3
                                    : (root.ssh-algorithm-category == "compress" ? 4 : 0)));
                                selected(v) => {
                                    root.ssh-algorithm-category = v == "Host key" || v == "主机密钥" ? "serverHostKey"
                                        : (v == "Cipher" || v == "加密算法" ? "cipher"
                                        : (v == "MAC" || v == "消息认证码" ? "hmac"
                                        : (v == "Compression" || v == "压缩算法" ? "compress" : "kex")));
                                    root.set-ssh-algorithm-category(root.ssh-algorithm-category);
                                }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Reset" : "重置";
                            desc: root.lang-en
                                ? "Restore this category or every algorithm list to the built-in defaults."
                                : "将当前类别或全部算法恢复为内置默认。";
                            show-divider: false;
                            HorizontalLayout {
                                spacing: 8px;
                                GhostButton {
                                    text: root.lang-en ? "This category" : "当前类别";
                                    clicked => { root.reset-ssh-algorithm-section(); }
                                }
                                GhostButton {
                                    text: root.lang-en ? "All defaults" : "全部默认";
                                    clicked => { root.reset-ssh-algorithms(); }
                                }
                            }
                        }

                        for algo[index] in root.ssh-algorithm-rows: Rectangle {
                            height: 34px * Theme.panel-font;
                            HorizontalLayout {
                                spacing: 8px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                cross-axis-alignment: center;

                                CompactCheckBox {
                                    horizontal-stretch: 1;
                                    text: algo.name;
                                    checked: algo.checked;
                                    toggled => { root.toggle-ssh-algorithm(algo.name); }
                                }

                                if algo.weak: Rectangle {
                                    border-radius: 4px;
                                    background: Theme.danger.with-alpha(0.18);
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        padding-top: 2px;
                                        padding-bottom: 2px;
                                        Text {
                                            text: root.lang-en ? "weak" : "不安全";
                                            color: Theme.danger;
                                            font-size: 10px * Theme.panel-font;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                }

                                if algo.checked: HorizontalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 5px;
                                        opacity: algo.can-move-up ? 1.0 : 0.35;
                                        background: up-ta.has-hover && algo.can-move-up ? Theme.bg-hover : transparent;
                                        up-ta := TouchArea {
                                            mouse-cursor: algo.can-move-up ? pointer : default;
                                            clicked => {
                                                if (algo.can-move-up) {
                                                    root.move-ssh-algorithm(algo.name, -1);
                                                }
                                            }
                                        }
                                        Text {
                                            text: "↑";
                                            color: Theme.text-secondary;
                                            font-size: 12px * Theme.panel-font;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }
                                    }
                                    Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 5px;
                                        opacity: algo.can-move-down ? 1.0 : 0.35;
                                        background: down-ta.has-hover && algo.can-move-down ? Theme.bg-hover : transparent;
                                        down-ta := TouchArea {
                                            mouse-cursor: algo.can-move-down ? pointer : default;
                                            clicked => {
                                                if (algo.can-move-down) {
                                                    root.move-ssh-algorithm(algo.name, 1);
                                                }
                                            }
                                        }
                                        Text {
                                            text: "↓";
                                            color: Theme.text-secondary;
                                            font-size: 12px * Theme.panel-font;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            width: 100%;
                                            height: 100%;
                                        }
                                    }
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                width: 100%;
                                height: 1px;
                                background: Theme.border-subtle;
                            }
                        }

                        SectionHeader {
                            text: "SFTP";
                        }

                        SettingRow {
                            label: root.lang-en ? "SFTP follows terminal cd" : "SFTP 跟随 cd 更新";
                            desc: root.lang-en
                                ? "A cd in the terminal switches the SFTP panel to the same directory."
                                : "终端里执行 cd 时,SFTP 面板自动切到相同目录。";
                            Switch {
                                on: root.sftp-follow-cd;
                                toggled(v) => { root.sftp-follow-cd = v; root.set-sftp-follow-cd(v); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Always ask where to save" : "总是询问保存去何处";
                            desc: root.lang-en
                                ? "Every SFTP download prompts for a location instead of using the preset folder."
                                : "每次 SFTP 下载都询问保存位置,而不是直接存到预设下载目录。";
                            show-divider: false;
                            Switch {
                                on: root.download-always-ask;
                                toggled(v) => { root.download-always-ask = v; root.set-download-always-ask(v); }
                            }
                        }
                    }

                    // --- Sidebars page -----------------------------------------
                    if root.ifd-page == "sidebar": VerticalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 15px;
                        spacing: 0;
                        alignment: start;
                        SectionHeader {
                            text: root.lang-en ? "SIDEBARS" : "侧栏";
                        }

                        SettingRow {
                            label: root.lang-en ? "Zen mode" : "专注模式";
                            desc: root.lang-en
                                ? "Hide side panels and collapsed edge strips so the terminal fills the window."
                                : "隐藏侧栏、底栏和收起图标，让终端填满窗口内容区。";
                            Switch {
                                on: root.zen-mode;
                                toggled(v) => { root.zen-mode = v; root.set-zen-mode(v); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Collapse the SFTP panel by default" : "默认收起 SFTP 侧栏";
                            desc: root.lang-en
                                ? "Takes effect on next launch; handy on low-spec jump hosts."
                                : "下次启动生效;低配跳板机上可减少常驻面板开销。";
                            Switch {
                                on: root.collapse-sftp-default;
                                toggled(v) => { root.collapse-sftp-default = v; root.set-collapse-sftp-default(v); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Quick commands as a sidebar" : "快捷命令作为侧栏";
                            desc: root.lang-en
                                ? "Allows the quick-command popup to be dragged to a window edge. After docking, use the sidebar or its collapsed icon."
                                : "允许把快捷命令弹窗拖到窗口边缘；停靠后通过侧栏或收起图标使用。";
                            show-divider: false;
                            Switch {
                                on: root.quick-commands-as-sidebar;
                                toggled(v) => {
                                    root.quick-commands-as-sidebar = v;
                                    root.set-quick-commands-as-sidebar(v);
                                }
                            }
                        }
                    }

                    // --- Welcome page ------------------------------------------
                    if (root.ifd-page == "welcome"): VerticalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 15px;
                        spacing: 0;
                        alignment: start;
                        SectionHeader {
                            text: root.lang-en ? "WELCOME PAGE" : "欢迎页";
                        }

                        SettingRow {
                            label: root.lang-en ? "Show the welcome page as a sidebar" : "欢迎页设为侧栏";
                            desc: root.lang-en
                                ? "Dock the session list on the left instead of a \"Welcome page\" tab; opened sessions fill the center."
                                : "把会话列表停靠在左侧,不再用「欢迎页」标签;打开的会话占据中央区域。";
                            Switch {
                                on: root.welcome-as-sidebar;
                        // Applying this binding destroys/recreates the Welcome
                        // subtree. Rust defers that work until this Switch
                        // callback has returned, so do not mutate it here (#323).
                        toggled(v) => { root.set-welcome-as-sidebar(v); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Confirm before deleting a group" : "删除分组前确认";
                            desc: root.lang-en
                                ? "Ask before removing a group (also deletes nested groups and sessions inside)."
                                : "删除分组前弹出确认（会一并删除其下的子分组和会话）。";
                            Switch {
                                on: root.confirm-delete-group-enabled;
                                toggled(v) => {
                                    root.confirm-delete-group-enabled = v;
                                    root.set-confirm-delete-group-enabled(v);
                                }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Confirm before deleting a session" : "删除会话前确认";
                            desc: root.lang-en
                                ? "Ask before removing a saved session from the list."
                                : "从列表删除已保存的会话前弹出确认。";
                            Switch {
                                on: root.confirm-delete-session-enabled;
                                toggled(v) => {
                                    root.confirm-delete-session-enabled = v;
                                    root.set-confirm-delete-session-enabled(v);
                                }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Single-click to connect" : "单击会话连接";
                            desc: root.lang-en
                                ? "Connect with one click. When off, double-click a session to connect."
                                : "开启后单击会话即可连接；关闭时需双击连接。";
                            show-divider: false;
                            Switch {
                                on: root.welcome-single-click-connect;
                                toggled(v) => {
                                    root.welcome-single-click-connect = v;
                                    root.set-welcome-single-click-connect(v);
                                }
                            }
                        }
                    }

                    // --- Data page ---------------------------------------------
                    if root.ifd-page == "data": VerticalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 15px;
                        spacing: 0;
                        alignment: start;
                        SectionHeader {
                            text: root.lang-en ? "DATA" : "数据";
                        }

                        SettingRow {
                            label: root.lang-en ? "Save passwords / private-keys" : "保存密码/私钥";
                            desc: !root.credentials-vault-available
                                ? (root.lang-en
                                    ? "Unavailable: OS keyring cannot store the vault master key."
                                    : "不可用：系统钥匙串无法保存凭证库主密钥。")
                                : (root.lang-en
                                    ? "When on, passwords and private keys are stored in an encrypted vault (OS keyring master key). Turning this off does not clear credentials already saved."
                                    : "开启后密码与私钥写入加密凭证库(主密钥在系统钥匙串)。关闭此选项不会清除已保存的内容。");
                            Switch {
                                enabled: root.credentials-vault-available;
                                on: root.save-passwords;
                                toggled(v) => { root.save-passwords = v; root.set-save-passwords(v); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Clear saved passwords / private-keys" : "清除所有保存的密码/私钥";
                            desc: root.lang-en
                                ? "Remove every stored password, private-keys from saved sessions."
                                : "清除所有已保存会话中的密码、私钥。";
                            DangerButton {
                                text: root.lang-en ? "Clear" : "清除";
                                clicked => { root.request-clear-passwords(); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Clear SSH known hosts" : "清除 SSH 已知主机公钥";
                            desc: root.lang-en
                                ? "Forget remembered server host keys. The next connection to each host will ask you to trust the key again."
                                : "清除已记住的服务器主机公钥。下次连接各主机时会再次要求确认信任。";
                            DangerButton {
                                text: root.lang-en ? "Clear" : "清除";
                                clicked => { root.request-clear-known-hosts(); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Clear all groups and sessions" : "清除所有分组和会话";
                            desc: root.lang-en
                                ? "Permanently delete every saved Quick Connect group and session. Open tabs are not closed. You can choose whether to also clear saved passwords / private keys."
                                : "永久删除全部已保存的快速连接分组和会话。已打开的标签页不会关闭。可选择是否同时清除已保存的密码/私钥。";
                            DangerButton {
                                text: root.lang-en ? "Clear" : "清除";
                                clicked => { root.request-clear-sessions(); }
                            }
                        }

                        SettingRow {
                            label: root.lang-en ? "Restore default settings" : "恢复默认设置";
                            desc: root.lang-en
                                ? "Reset settings preferences to defaults (including SSH/SFTP algorithms). Saved groups, sessions, commands, passwords, private-keys, and SSH known hosts are kept."
                                : "将设置相关偏好恢复为默认值（含 SSH/SFTP 算法）。已保存的分组、会话、命令、密码、私钥和 SSH 已知主机公钥不会被清除。";
                            show-divider: false;
                            PrimaryButton {
                                text: root.lang-en ? "Restore" : "恢复";
                                clicked => { root.request-restore-settings(); }
                            }
                        }
                    }

                    // --- Language page -----------------------------------------
                    if root.ifd-page == "language": VerticalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 15px;
                        spacing: 0;
                        alignment: start;
                        SectionHeader {
                            text: root.lang-en ? "LANGUAGE" : "语言";
                        }

                        SettingRow {
                            label: root.lang-en ? "Interface language" : "界面语言";
                            desc: root.lang-en
                                ? "Auto follows the system language. Systems that are neither Chinese nor English use English."
                                : "自动跟随系统语言。系统既非中文也非英文时使用英文。";
                            show-divider: false;
                            ComboBox {
                                width: 150px;
                                height: 30px;
                                model: root.lang-en
                                    ? ["Auto", "Chinese", "English"]
                                    : ["自动", "中文", "英文"];
                                current-value: root.language-pref == "zh"
                                    ? (root.lang-en ? "Chinese" : "中文")
                                    : root.language-pref == "en"
                                    ? (root.lang-en ? "English" : "英文")
                                    : (root.lang-en ? "Auto" : "自动");
                                selected(v) => {
                                    if (v == "Chinese" || v == "中文") {
                                        root.language-pref = "zh";
                                        root.set-language("zh");
                                    } else if (v == "English" || v == "英文") {
                                        root.language-pref = "en";
                                        root.set-language("en");
                                    } else {
                                        root.language-pref = "auto";
                                        root.set-language("auto");
                                    }
                                }
                            }
                        }
                    }

                    // --- Update check page (#184) ------------------------------
                    if root.ifd-page == "update": VerticalLayout {
                        padding-left: 15px;
                        padding-right: 15px;
                        padding-top: 15px;
                        spacing: 0;
                        alignment: start;
                        SectionHeader {
                            text: root.lang-en ? "UPDATE CHECK" : "新版本提示";
                        }

                        SettingRow {
                            label: root.lang-en ? "Check for new versions on startup" : "启动时检查新版本";
                            desc: root.lang-en
                                ? "Off: ZinTerm no longer queries GitHub for releases and the update banner won't appear (takes effect next launch)."
                                : "关闭后:不再向 GitHub 查询新版本,也不会弹出更新提示(下次启动生效)。";
                            show-divider: false;
                            Switch {
                                on: root.update-check-enabled;
                                toggled(v) => { root.update-check-enabled = v; root.set-update-check-enabled(v); }
                            }
                        }
                    }
                }
            }
        }
    }
}
