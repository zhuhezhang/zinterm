import { Theme } from "../../shared/theme.slint";
import { ComboBox } from "std-widgets.slint";
import {
    SectionHeader,
    SettingRow,
    Switch,
    Stepper,
    CursorStyleButton,
    CursorColorInput,
} from "../widgets.slint";

export component FontSettingsPage inherits Rectangle {
    height: self.preferred-height;
    callback set-panel-font(int);
    callback set-term-cursor-color(string) -> bool;
    callback set-term-cursor-style(string);
    callback set-term-font(string);
    callback set-term-font-bold(bool);
    callback set-term-font-size(int);
    callback set-terminal-line-spacing(float);
    callback set-ui-scale(int);
    in property <color> term-cursor-color: #D4D4D4;
    in-out property <string> term-cursor-color-hex: "#D4D4D4";
    in-out property <string> term-cursor-style: "bar";
    in-out property <bool> term-font-bold;
    in property <string> term-font-family;
    in property <length> term-font-size;
    in property <[string]> term-fonts;
    in-out property <float> terminal-line-spacing: 1.0;
    in property <float> ui-scale;

    VerticalLayout {
        padding-left: 15px;
        padding-right: 15px;
        padding-top: 15px;
        spacing: 0;
        alignment: start;

        SectionHeader {
            text: @tr("FONT");
        }

        SettingRow {
            label: @tr("Terminal font");
            ComboBox {
                width: 150px;
                height: 30px;
                model: root.term-fonts;
                current-value: root.term-font-family;
                selected(v) => { root.set-term-font(v); }
            }
        }

        SettingRow {
            label: @tr("Terminal font size");
            Stepper {
                value: root.term-font-size / 1px;
                minimum: 8;
                maximum: 32;
                step: 1;
                unit: "px";
                changed(v) => { root.set-term-font-size(v); }
            }
        }

        SettingRow {
            label: @tr("Terminal line spacing");
            desc: @tr("Adjust terminal row height from compact to loose");
            Stepper {
                value: round(root.terminal-line-spacing * 100);
                minimum: 80;
                maximum: 150;
                step: 5;
                unit: "%";
                changed(v) => { root.terminal-line-spacing = v / 100; root.set-terminal-line-spacing(root.terminal-line-spacing); }
            }
        }

        SettingRow {
            label: @tr("Installed fonts");
            desc: @tr("Install a TTF/OTF font in Windows, then restart ZinTerm to refresh this list");
            show-divider: false;
            Rectangle {
                width: 1px;
                height: 1px;
                background: transparent;
            }
        }

        SettingRow {
            label: @tr("Bold terminal text");
            desc: @tr("Makes regular terminal output use a bold face");
            Switch {
                on: root.term-font-bold;
                toggled(v) => { root.term-font-bold = v; root.set-term-font-bold(v); }
            }
        }

        SettingRow {
            label: @tr("Cursor shape");
            desc: @tr("Choose the terminal insertion cursor shape");
            HorizontalLayout {
                spacing: 5px;
                CursorStyleButton {
                    label: @tr("Block");
                    cursor-kind: "block";
                    selected: root.term-cursor-style == "block";
                    clicked => { root.term-cursor-style = "block"; root.set-term-cursor-style("block"); }
                }

                CursorStyleButton {
                    label: @tr("Bar");
                    cursor-kind: "bar";
                    selected: root.term-cursor-style == "bar";
                    clicked => { root.term-cursor-style = "bar"; root.set-term-cursor-style("bar"); }
                }

                CursorStyleButton {
                    label: @tr("Line");
                    cursor-kind: "underline";
                    selected: root.term-cursor-style == "underline";
                    clicked => { root.term-cursor-style = "underline"; root.set-term-cursor-style("underline"); }
                }
            }
        }

        SettingRow {
            label: @tr("Cursor color");
            desc: @tr("Enter a hexadecimal RGB color");
            CursorColorInput {
                width: 100px;
                value <=> root.term-cursor-color-hex;
                preview-color: root.term-cursor-color;
                apply-color(v) => { return root.set-term-cursor-color(v); }
            }
        }

        SettingRow {
            label: @tr("UI scale");
            desc: @tr("Zooms the whole interface (not this panel)");
            Stepper {
                value: round(root.ui-scale * 100);
                minimum: 80;
                maximum: 200;
                step: 10;
                unit: "%";
                changed(v) => { root.set-ui-scale(v); }
            }
        }

        SettingRow {
            label: @tr("Settings font size");
            desc: @tr("Enlarges this settings panel (font + window)");
            show-divider: false;
            Stepper {
                value: round(Theme.panel-font * 100);
                minimum: 80;
                maximum: 160;
                step: 10;
                unit: "%";
                changed(v) => { root.set-panel-font(v); }
            }
        }

        SectionHeader {
            text: @tr("PREVIEW");
        }

        Rectangle {
            height: 52px;
            background: Theme.term-bg;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border-subtle;
            Text {
                x: 12px;
                text: "ZinTerm ~$ echo preview 0123";
                font-family: Theme.term-font-family;
                font-size: Theme.term-font-size;
                font-weight: Theme.term-font-bold ? 700 : 400;
                color: Theme.term-fg;
                vertical-alignment: center;
                height: parent.height;
            }
        }

        Rectangle {
            height: 10px;
        }
    }
}
