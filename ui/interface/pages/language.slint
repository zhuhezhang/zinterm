import { ComboBox } from "std-widgets.slint";
import { SectionHeader, SettingRow } from "../widgets.slint";

export component LanguageSettingsPage inherits Rectangle {
    height: self.preferred-height;
    in-out property <string> language-pref: "auto";
    callback set-language(string);

    VerticalLayout {
        padding-left: 15px;
        padding-right: 15px;
        padding-top: 15px;
        spacing: 0;
        alignment: start;
        SectionHeader {
            text: @tr("LANGUAGE");
        }

        SettingRow {
            label: @tr("Interface language");
            desc: @tr("Auto follows the system language. Systems that are neither Chinese nor English use English");
            show-divider: false;
            ComboBox {
                width: 150px;
                height: 30px;
                model: [@tr("Auto"), @tr("Chinese"), @tr("English")];
                current-value: root.language-pref == "zh"
                    ? @tr("Chinese")
                    : root.language-pref == "en"
                    ? @tr("English")
                    : @tr("Auto");
                selected(v) => {
                    if (v == @tr("Chinese") || v == "Chinese" || v == "中文") {
                        root.language-pref = "zh";
                        root.set-language("zh");
                    } else if (v == @tr("English") || v == "English" || v == "英文") {
                        root.language-pref = "en";
                        root.set-language("en");
                    } else {
                        root.language-pref = "auto";
                        root.set-language("auto");
                    }
                }
            }
        }
    }
}
