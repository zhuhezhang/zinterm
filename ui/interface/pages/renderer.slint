import { Theme } from "../../shared/theme.slint";
import { ComboBox } from "std-widgets.slint";
import { SectionHeader, SettingHint, SettingRow } from "../widgets.slint";

export component RendererSettingsPage inherits Rectangle {
    height: self.preferred-height;
    in property <bool> is-windows;
    in-out property <string> renderer-mode: "software";
    in-out property <bool> renderer-restart-required;
    callback set-renderer-mode(string);

    VerticalLayout {
        padding-left: 15px;
        padding-right: 15px;
        padding-top: 15px;
        spacing: 0;
        alignment: start;

        SectionHeader {
            text: @tr("RENDERING");
        }

        SettingRow {
            label: @tr("Renderer");
            desc: Theme.is-mac
                ? (@tr("CPU is the compatibility default. FemtoVG and Skia use GPU acceleration."))
                : (@tr("Auto tries GPU acceleration and lets Slint fall back to software. Software is best for VMs and compatibility."));
            show-divider: false;
            ComboBox {
                width: 150px;
                height: 30px;
                model: Theme.is-mac
                    ? ["CPU", "FemtoVG", "Skia"]
                    : [@tr("Automatic"), "GPU", @tr("Software")];
                current-value: Theme.is-mac
                    ? (root.renderer-mode == "skia"
                    ? "Skia"
                    : root.renderer-mode == "femtovg" ? "FemtoVG" : "CPU")
                    : (root.renderer-mode == "auto"
                    ? @tr("Automatic")
                    : root.renderer-mode == "gpu"
                    ? "GPU"
                    : @tr("Software"));
                selected(v) => {
                    if (Theme.is-mac && v == "CPU"
                        && root.renderer-mode != "software") {
                        root.renderer-mode = "software";
                        root.set-renderer-mode("software");
                        root.renderer-restart-required = true;
                    } else if (Theme.is-mac && v == "FemtoVG"
                        && root.renderer-mode != "femtovg") {
                        root.renderer-mode = "femtovg";
                        root.set-renderer-mode("femtovg");
                        root.renderer-restart-required = true;
                    } else if (Theme.is-mac && v == "Skia"
                        && root.renderer-mode != "skia") {
                        root.renderer-mode = "skia";
                        root.set-renderer-mode("skia");
                        root.renderer-restart-required = true;
                    } else if (!Theme.is-mac && (v == @tr("Automatic") || v == "Automatic" || v == "自动")
                        && root.renderer-mode != "auto") {
                        root.renderer-mode = "auto";
                        root.set-renderer-mode("auto");
                        root.renderer-restart-required = true;
                    } else if (!Theme.is-mac && v == "GPU" && root.renderer-mode != "gpu") {
                        root.renderer-mode = "gpu";
                        root.set-renderer-mode("gpu");
                        root.renderer-restart-required = true;
                    } else if (!Theme.is-mac && (v == @tr("Software") || v == "Software" || v == "软件")
                        && root.renderer-mode != "software") {
                        root.renderer-mode = "software";
                        root.set-renderer-mode("software");
                        root.renderer-restart-required = true;
                    }
                }
            }
        }

        Rectangle {
            height: 10px;
        }

        SettingHint {
            text: root.renderer-restart-required
                ? @tr("Restart ZinTerm to apply the renderer change.")
                : (Theme.is-mac
                ? @tr("CPU is the default renderer on macOS.")
                : (root.is-windows
                ? @tr("Software remains the compatibility default for existing installations.")
                : @tr("Automatic remains the default renderer on Linux.")));
            color: root.renderer-restart-required ? Theme.accent : Theme.text-muted;
        }
    }
}
