import { Theme } from "../../shared/theme.slint";
import { Slider, ScrollView } from "std-widgets.slint";
import {
    SectionHeader,
    SettingHint,
    SettingRow,
    WallpaperSwatch,
} from "../widgets.slint";

export component WallpaperSettingsPage inherits Rectangle {
    height: self.preferred-height;
    in-out property <string> current-wallpaper;
    in property <string> custom-wallpaper-name;   // basename for the file row;
    callback persist-wallpaper-overlay(float);
    callback pick-wallpaper-file();
    callback set-wallpaper(string);
    in-out property <float> wallpaper-overlay;   // frosted-panel opacity 0.30-1.00;
    property <bool> wp-is-custom:
        root.current-wallpaper != "" && root.current-wallpaper != "builtin:light"
        && root.current-wallpaper != "builtin:dark" && root.current-wallpaper != "builtin:tech"
        && root.current-wallpaper != "builtin:miku" && root.current-wallpaper != "builtin:ms";

    VerticalLayout {
        padding-left: 15px * Theme.ui-scale;
        padding-right: 15px * Theme.ui-scale;
        padding-top: 15px * Theme.ui-scale;
        spacing: 0;
        alignment: start;

        SectionHeader {
            text: @tr("WALLPAPER");
        }

        SettingHint {
            text: @tr("Pick a wallpaper — the interface tints itself to match (accent, panels, light/dark)");
        }

        Rectangle {
            height: 12px * Theme.ui-scale;
        }

        // Built-in choices: keep this row horizontally scrollable as
                        // bundled wallpapers grow.
                        builtin-wallpapers-scroll := ScrollView {
            height: 106px * Theme.ui-scale;
            width: 100%;
            viewport-width: max(self.visible-width, builtin-wallpapers-row.preferred-width);
            viewport-height: self.visible-height;

            builtin-wallpapers-row := HorizontalLayout {
                spacing: 11px * Theme.ui-scale;
                alignment: start;
                VerticalLayout {
                    spacing: 5px * Theme.ui-scale;
                    WallpaperSwatch {
                        width: 100px * Theme.ui-scale;
                        selected: root.current-wallpaper == "";
                        clicked => { root.set-wallpaper(""); }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: Theme.window-base;
                            Text {
                                text: "\u{E14C}"; // clear / none
                                    font-family: "Material Icons";
                                color: Theme.text-muted;
                                font-size: 22px * Theme.ui-scale;
                                width: 100%;
                                height: 100%;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Text {
                        text: @tr("None");
                        font-size: 11px * Theme.ui-scale;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 5px * Theme.ui-scale;
                    WallpaperSwatch {
                        width: 100px * Theme.ui-scale;
                        selected: root.current-wallpaper == "builtin:light";
                        clicked => { root.set-wallpaper("builtin:light"); }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: @linear-gradient(135deg, #eff3fb 0%, #d5e1f2 100%);
                            Rectangle {
                                x: parent.width * 0.66;
                                y: -parent.height * 0.2;
                                width: 56px * Theme.ui-scale;
                                height: 56px * Theme.ui-scale;
                                border-radius: 28px * Theme.ui-scale;
                                background: #4a90e2;
                                opacity: 0.30;
                            }
                        }
                    }

                    Text {
                        text: @tr("Meat Light");
                        font-size: 11px * Theme.ui-scale;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 5px * Theme.ui-scale;
                    WallpaperSwatch {
                        width: 100px * Theme.ui-scale;
                        selected: root.current-wallpaper == "builtin:dark";
                        clicked => { root.set-wallpaper("builtin:dark"); }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: @linear-gradient(135deg, #10131a 0%, #1b2233 100%);
                            Rectangle {
                                x: parent.width * 0.66;
                                y: -parent.height * 0.2;
                                width: 56px * Theme.ui-scale;
                                height: 56px * Theme.ui-scale;
                                border-radius: 28px * Theme.ui-scale;
                                background: #4a6ce0;
                                opacity: 0.40;
                            }
                        }
                    }

                    Text {
                        text: @tr("Meat Dark");
                        font-size: 11px * Theme.ui-scale;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 5px * Theme.ui-scale;
                    WallpaperSwatch {
                        width: 100px * Theme.ui-scale;
                        selected: root.current-wallpaper == "builtin:tech";
                        clicked => { root.set-wallpaper("builtin:tech"); }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: @linear-gradient(180deg, #05060f 0%, #0b1430 55%, #1a0a2e 100%);
                            clip: true;
                                            // glowing planet
                                            Rectangle {
                                x: parent.width * 0.5 - 16px * Theme.ui-scale;
                                y: parent.height * 0.22;
                                width: 32px * Theme.ui-scale;
                                height: 32px * Theme.ui-scale;
                                border-radius: 16px * Theme.ui-scale;
                                background: @radial-gradient(circle, #ff5ea8 0%, #ff5ea800 70%);
                            }
                                            // neon horizon line
                                            Rectangle {
                                y: parent.height * 0.58;
                                width: parent.width;
                                height: 2px * Theme.ui-scale;
                                background: #19e6ff;
                                opacity: 0.85;
                            }
                        }
                    }

                    Text {
                        text: @tr("Fantasy 3048");
                        font-size: 11px * Theme.ui-scale;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 5px * Theme.ui-scale;
                    WallpaperSwatch {
                        width: 100px * Theme.ui-scale;
                        selected: root.current-wallpaper == "builtin:ms";
                        clicked => { root.set-wallpaper("builtin:ms"); }
                        Image {
                            width: 100%;
                            height: 100%;
                            source: @image-url("../../../assets/ms.jpg");
                            image-fit: cover;
                        }
                    }

                    Text {
                        text: "MS";
                        font-size: 11px * Theme.ui-scale;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }

                VerticalLayout {
                    spacing: 5px * Theme.ui-scale;
                    WallpaperSwatch {
                        width: 100px * Theme.ui-scale;
                        selected: root.current-wallpaper == "builtin:miku";
                        clicked => { root.set-wallpaper("builtin:miku"); }
                        Image {
                            width: 100%;
                            height: 100%;
                            source: @image-url("../../../assets/miku.jpg");
                            image-fit: cover;
                        }
                    }

                    Text {
                        text: "Miku";
                        font-size: 11px * Theme.ui-scale;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        Rectangle {
            height: 16px * Theme.ui-scale;
        }

        SectionHeader {
            text: @tr("CUSTOM");
        }

        HorizontalLayout {
            spacing: 14px * Theme.ui-scale;
            alignment: start;
            WallpaperSwatch {
                selected: root.wp-is-custom;
                clicked => { root.pick-wallpaper-file(); }
                // Show the real image when a custom one is active, else a
                // "choose a file" placeholder.
                if root.wp-is-custom: Image {
                    width: 100%;
                    height: 100%;
                    source: Theme.wallpaper;
                    image-fit: cover;
                }
                if !root.wp-is-custom: Rectangle {
                    width: 100%;
                    height: 100%;
                    background: Theme.bg-elevated;
                    Text {
                        text: "\u{E2C6}"; // folder-open
                                font-family: "Material Icons";
                        color: Theme.text-secondary;
                        font-size: 22px * Theme.ui-scale;
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 6px * Theme.ui-scale;
                Rectangle {
                    width: 130px * Theme.ui-scale;
                    height: 30px * Theme.ui-scale;
                    border-radius: 6px * Theme.ui-scale;
                    background: pick-ta.has-hover ? Theme.accent-hover : Theme.accent;
                    pick-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick-wallpaper-file(); }
                    }

                    Text {
                        text: @tr("Choose file…");
                        color: white;
                        font-size: 12px * Theme.ui-scale;
                        width: 100%;
                        height: 100%;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.wp-is-custom: Text {
                    text: root.custom-wallpaper-name;
                    color: Theme.text-muted;
                    font-size: 11px * Theme.ui-scale;
                    width: 150px * Theme.ui-scale;
                    overflow: elide;
                }
            }
        }

        Rectangle {
            height: 16px * Theme.ui-scale;
        }

        SectionHeader {
            text: @tr("OVERLAY");
        }

        SettingRow {
            label: @tr("Wallpaper transparency");
            desc: @tr("How much the wallpaper shows through panels and the terminal (no effect without a wallpaper)");
            show-divider: false;
            HorizontalLayout {
                spacing: 8px * Theme.ui-scale;
                Slider {
                    width: 150px * Theme.ui-scale;
                    minimum: 0;
                    // Up to 70% transparency (overlay floor 0.30).
                    maximum: 70;
                    value: (1.0 - root.wallpaper-overlay) * 100;
                    changed(v) => { root.wallpaper-overlay = 1.0 - v / 100; }
                    released(v) => { root.persist-wallpaper-overlay(1.0 - v / 100); }
                }

                Text {
                    text: "\{round((1.0 - root.wallpaper-overlay) * 100)}%";
                    color: Theme.text-secondary;
                    font-size: 12px * Theme.ui-scale;
                    vertical-alignment: center;
                    width: 34px * Theme.ui-scale;
                }
            }
        }
    }
}
