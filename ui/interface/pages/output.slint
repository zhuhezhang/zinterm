import { Theme } from "../../shared/theme.slint";
import { ComboBox } from "std-widgets.slint";
import {
    LabeledInput,
    PrimaryButton,
    GhostButton,
    CompactCheckBox,
    TooltipArea,
} from "../../shared/widgets.slint";
import {
    SectionHeader,
    SettingHint,
    SettingRow,
    Switch,
    CursorColorInput,
} from "../widgets.slint";
import { OutputRuleItem } from "../../types/settings.slint";
import { MenuItem } from "../../terminal/helpers.slint";

export component OutputSettingsPage inherits Rectangle {
    height: self.preferred-height;
    in-out property <string> highlight-draft-color-hex: "#F14C4C";
    in-out property <color> highlight-draft-swatch: #F14C4C;
    in-out property <bool> json-format-output: true;
    in-out property <bool> session-log-enabled: false;
    in property <string> session-log-dir;
    in-out property <bool> new-rule-case-sensitive;
    in-out property <string> new-rule-name;
    in-out property <string> new-rule-pattern;
    in-out property <bool> new-rule-regex;
    in-out property <bool> new-rule-whole-line;
    in-out property <bool> output-highlight-enabled;
    in-out property <string> output-highlight-preset;
    in-out property <string> output-highlight-rule-status;
    in property <[OutputRuleItem]> output-highlight-rules;
    callback remove-output-highlight-rule(int);
    callback add-output-highlight-rule(string, string, bool, bool, bool, string) -> bool;
    callback update-output-highlight-rule(int, string, string, bool, bool, bool, string) -> bool;
    in-out property <int> rule-edit-index: -1;   // -1 = add, >=0 = edit that rule;
    property <string> rule-name-label: @tr("Rule name");
    property <string> rule-pattern-label: @tr("Keyword or regular expression");
    // Locale-aware: match the wider of the two form labels.
    property <length> rule-form-label-width:
        max(m-rule-name.preferred-width, m-rule-pattern.preferred-width);
    callback set-highlight-draft-color(string) -> bool;
    callback set-json-format-output(bool);
    callback set-session-log-enabled(bool);
    callback pick-session-log-dir();
    callback open-session-log-dir();
    callback restore-session-log-dir();
    callback set-output-highlight(bool, string);
    callback set-output-highlight-rule-enabled(int, bool);
    callback move-output-highlight-rule(int, int);
    callback reorder-output-highlight-rule(int, int);
    callback move-output-highlight-rule-to-top(int);
    callback move-output-highlight-rule-to-bottom(int);
    callback select-only-output-highlight-rule(int);
    callback select-all-output-highlight-rules();
    callback invert-output-highlight-rule-selection();
    callback reset-output-highlight-rules();

    // Drag-reorder state for the custom highlight-rule list.
    property <int> rule-drag-from: -1;
    property <int> rule-drop-before: -1;
    property <bool> rule-dragging: false;
    property <length> rule-row-h: 44px * Theme.ui-scale;

    function reset-rule-form() {
        root.rule-edit-index = -1;
        root.new-rule-name = "";
        root.new-rule-pattern = "";
        root.new-rule-regex = false;
        root.new-rule-case-sensitive = false;
        root.new-rule-whole-line = false;
        root.highlight-draft-color-hex = "#F14C4C";
        root.highlight-draft-swatch = #F14C4C;
        root.output-highlight-rule-status = "";
    }

    function load-rule-into-form(index: int) {
        if (index < 0 || index >= root.output-highlight-rules.length) {
            return;
        }
        root.rule-edit-index = index;
        root.new-rule-name = root.output-highlight-rules[index].name;
        root.new-rule-pattern = root.output-highlight-rules[index].pattern;
        root.new-rule-regex = root.output-highlight-rules[index].regex;
        root.new-rule-case-sensitive = root.output-highlight-rules[index].case-sensitive;
        root.new-rule-whole-line = root.output-highlight-rules[index].whole-line;
        root.highlight-draft-color-hex = root.output-highlight-rules[index].color;
        root.highlight-draft-swatch = root.output-highlight-rules[index].swatch;
        root.output-highlight-rule-status = "";
    }

    function save-rule-form() -> bool {
        if (root.rule-edit-index >= 0) {
            return root.update-output-highlight-rule(
                root.rule-edit-index,
                root.new-rule-name,
                root.new-rule-pattern,
                root.new-rule-regex,
                root.new-rule-case-sensitive,
                root.new-rule-whole-line,
                root.highlight-draft-color-hex);
        }
        return root.add-output-highlight-rule(
            root.new-rule-name,
            root.new-rule-pattern,
            root.new-rule-regex,
            root.new-rule-case-sensitive,
            root.new-rule-whole-line,
            root.highlight-draft-color-hex);
    }

    // Keep the edit-form selection pointed at the same rule after a reorder.
    function adjust-edit-index-after-move(from: int, to: int) {
        if (root.rule-edit-index < 0 || from == to) {
            return;
        }
        if (root.rule-edit-index == from) {
            root.rule-edit-index = to;
        } else if (from < root.rule-edit-index && to >= root.rule-edit-index) {
            root.rule-edit-index = root.rule-edit-index - 1;
        } else if (from > root.rule-edit-index && to <= root.rule-edit-index) {
            root.rule-edit-index = root.rule-edit-index + 1;
        }
    }

    function update-rule-drop(pointer-y: length) {
        if (!root.rule-dragging || root.rule-drag-from < 0) {
            return;
        }
        let count = root.output-highlight-rules.length;
        if (count <= 0) {
            return;
        }
        let rel = pointer-y - rule-list.absolute-position.y;
        if (rel < 0px) {
            root.rule-drop-before = 0;
            return;
        }
        let idx = floor(rel / root.rule-row-h);
        let local-y = rel - idx * root.rule-row-h;
        let before = local-y < root.rule-row-h / 2 ? idx : idx + 1;
        root.rule-drop-before = before < 0 ? 0 : (before > count ? count : before);
    }

    function finish-rule-drag() {
        if (root.rule-dragging
            && root.rule-drag-from >= 0
            && root.rule-drop-before >= 0) {
            let to = root.rule-drop-before > root.rule-drag-from
                ? root.rule-drop-before - 1
                : root.rule-drop-before;
            if (to != root.rule-drag-from
                && to >= 0
                && to < root.output-highlight-rules.length) {
                root.adjust-edit-index-after-move(root.rule-drag-from, to);
                root.reorder-output-highlight-rule(root.rule-drag-from, to);
            }
        }
        root.rule-dragging = false;
        root.rule-drag-from = -1;
        root.rule-drop-before = -1;
    }

    // Off-screen label probes used only to compute `rule-form-label-width`.
    Rectangle {
        x: -10000px;
        y: -10000px;
        width: 0px;
        height: 0px;
        clip: true;
        VerticalLayout {
            m-rule-name := Text {
                text: root.rule-name-label;
                font-size: Theme.fs-sm;
            }

            m-rule-pattern := Text {
                text: root.rule-pattern-label;
                font-size: Theme.fs-sm;
            }
        }
    }

    VerticalLayout {
        padding-left: 15px * Theme.ui-scale;
        padding-right: 15px * Theme.ui-scale;
        padding-top: 15px * Theme.ui-scale;
        spacing: 0;
        alignment: start;

        SectionHeader {
            text: @tr("TERMINAL OUTPUT LOG");
        }

        SettingRow {
            label: @tr("Record terminal output log");
            desc: @tr("Writes each tab's screen as plain text (what you see). Same tab reuses one file across reconnect; full-screen TUIs like vim are skipped");
            show-divider: false;
            Switch {
                on: root.session-log-enabled;
                toggled(v) => {
                    root.session-log-enabled = v;
                    root.set-session-log-enabled(v);
                }
            }
        }

        HorizontalLayout {
            width: 100%;
            spacing: 8px * Theme.ui-scale;
            padding-top: 9px * Theme.ui-scale;
            padding-bottom: 9px * Theme.ui-scale;

            Rectangle {
                height: 28px * Theme.ui-scale;
                horizontal-stretch: 1;
                background: Theme.bg-elevated;
                border-radius: Theme.radius-sm;
                border-width: 1px * Theme.ui-scale;
                border-color: Theme.border-subtle;
                HorizontalLayout {
                    padding-left: 8px * Theme.ui-scale;
                    padding-right: 8px * Theme.ui-scale;
                    Text {
                        width: 100%;
                        text: root.session-log-dir;
                        color: Theme.text-primary;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                // Full path on hover when the label is elided.
                TooltipArea {
                    width: 100%;
                    height: 100%;
                    tooltip-text: root.session-log-dir;
                }
            }

            Rectangle {
                width: 28px * Theme.ui-scale;
                height: 28px * Theme.ui-scale;
                border-radius: Theme.radius-sm;
                border-width: 1px * Theme.ui-scale;
                border-color: Theme.border-subtle;
                background: restore-log-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                restore-log-ta := TooltipArea {
                    mouse-cursor: pointer;
                    tooltip-text: @tr("Restore default path");
                    activate => { root.restore-session-log-dir(); }
                }

                Text {
                    text: "\u{E5D5}";
                    font-family: "Material Icons";
                    color: Theme.text-secondary;
                    font-size: 18px * Theme.ui-scale;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 28px * Theme.ui-scale;
                border-radius: Theme.radius-sm;
                background: pick-log-ta.has-hover ? Theme.accent-hover : Theme.accent;
                HorizontalLayout {
                    padding-left: 10px * Theme.ui-scale;
                    padding-right: 10px * Theme.ui-scale;
                    Text {
                        text: @tr("Choose save path");
                        color: #ffffff;
                        font-size: Theme.fs-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                pick-log-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.pick-session-log-dir(); }
                }
            }

            Rectangle {
                height: 28px * Theme.ui-scale;
                border-radius: Theme.radius-sm;
                background: open-log-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                border-width: 1px * Theme.ui-scale;
                border-color: Theme.border-subtle;
                HorizontalLayout {
                    padding-left: 10px * Theme.ui-scale;
                    padding-right: 10px * Theme.ui-scale;
                    Text {
                        text: @tr("Open folder");
                        color: Theme.text-primary;
                        font-size: Theme.fs-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                open-log-ta := TouchArea {
                    width: 100%;
                    height: 100%;
                    mouse-cursor: pointer;
                    clicked => { root.open-session-log-dir(); }
                }
            }
        }

        Rectangle {
            height: 1px * Theme.ui-scale;
            background: Theme.border-subtle;
        }

        Rectangle {
            height: 18px * Theme.ui-scale;
        }

        SectionHeader {
            text: @tr("OUTPUT HIGHLIGHTING");
        }

        SettingRow {
            label: @tr("Highlight plain terminal output");
            desc: @tr("Adds client-side colours only when the program did not provide ANSI styling");
            Switch {
                on: root.output-highlight-enabled;
                toggled(v) => {
                    root.output-highlight-enabled = v;
                    root.set-output-highlight(v, root.output-highlight-preset);
                }
            }
        }

        SettingRow {
            label: @tr("Built-in rule set");
            desc: @tr("Log levels is conservative; DevOps also recognises deployment and health states");
            show-divider: false;
            ComboBox {
                width: 150px * Theme.ui-scale;
                height: 30px * Theme.ui-scale;
                enabled: root.output-highlight-enabled;
                model: [@tr("Log levels"), "DevOps"];
                current-value: root.output-highlight-preset == "devops"
                    ? "DevOps"
                    : (@tr("Log levels"));
                selected(v) => {
                    root.output-highlight-preset = v == "DevOps" ? "devops" : "log";
                    root.set-output-highlight(
                                root.output-highlight-enabled,
                                root.output-highlight-preset);
                }
            }
        }

        SettingRow {
            label: @tr("Format and colour JSON lines");
            desc: @tr("Pretty-prints only complete JSON objects or arrays that occupy a whole terminal line. Other output is unchanged");
            show-divider: false;
            Switch {
                on: root.json-format-output;
                toggled(v) => {
                    root.json-format-output = v;
                    root.set-json-format-output(v);
                }
            }
        }

        Rectangle {
            height: 18px * Theme.ui-scale;
        }

        SectionHeader {
            text: @tr("PREVIEW");
        }

        Rectangle {
            height: root.output-highlight-preset == "devops" ? 116px * Theme.ui-scale : 92px * Theme.ui-scale;
            background: Theme.term-bg;
            border-radius: 6px * Theme.ui-scale;
            border-width: 1px * Theme.ui-scale;
            border-color: Theme.border-subtle;
            VerticalLayout {
                padding: 12px * Theme.ui-scale;
                spacing: 5px * Theme.ui-scale;
                Text {
                    text: "DEBUG cache lookup";
                    color: root.output-highlight-enabled ? Theme.text-muted : Theme.term-fg;
                    font-family: Theme.term-font-family;
                    font-size: 12px * Theme.ui-scale;
                }

                Text {
                    text: "INFO server ready";
                    color: root.output-highlight-enabled ? Theme.accent : Theme.term-fg;
                    font-family: Theme.term-font-family;
                    font-size: 12px * Theme.ui-scale;
                }

                Text {
                    text: "WARN disk nearly full";
                    color: root.output-highlight-enabled ? Theme.warning : Theme.term-fg;
                    font-family: Theme.term-font-family;
                    font-size: 12px * Theme.ui-scale;
                }

                Text {
                    text: "ERROR connection failed";
                    color: root.output-highlight-enabled ? Theme.danger : Theme.term-fg;
                    font-family: Theme.term-font-family;
                    font-size: 12px * Theme.ui-scale;
                }

                if root.output-highlight-preset == "devops": Text {
                    text: "SUCCESS deployment completed";
                    color: root.output-highlight-enabled ? Theme.success : Theme.term-fg;
                    font-family: Theme.term-font-family;
                    font-size: 12px * Theme.ui-scale;
                }
            }
        }

        Rectangle {
            height: 18px * Theme.ui-scale;
        }

        SectionHeader {
            text: @tr("CUSTOM RULES");
        }

        SettingHint {
            text: @tr("Custom rules run before the built-in preset and never overwrite ANSI colours");
        }

        Rectangle {
            height: 10px * Theme.ui-scale;
        }

        LabeledInput {
            label: root.rule-name-label;
            label-width: root.rule-form-label-width;
            placeholder: @tr("Timeout errors");
            value <=> root.new-rule-name;
            accepted => {
                if root.new-rule-name != "" && root.new-rule-pattern != ""
                    && root.save-rule-form() {
                    root.reset-rule-form();
                }
            }
        }

        Rectangle {
            height: 8px * Theme.ui-scale;
        }

        LabeledInput {
            label: root.rule-pattern-label;
            label-width: root.rule-form-label-width;
            placeholder: root.new-rule-regex ? "timeout|connection refused" : "connection refused";
            value <=> root.new-rule-pattern;
            accepted => {
                if root.new-rule-name != "" && root.new-rule-pattern != ""
                    && root.save-rule-form() {
                    root.reset-rule-form();
                }
            }
        }

        Rectangle {
            height: 8px * Theme.ui-scale;
        }

        HorizontalLayout {
            spacing: 8px * Theme.ui-scale;
            cross-axis-alignment: center;

            CompactCheckBox {
                text: @tr("Regex");
                gap: 4px * Theme.ui-scale;
                checked: root.new-rule-regex;
                toggled => { root.new-rule-regex = self.checked; }
            }

            CompactCheckBox {
                text: @tr("Case sensitive");
                gap: 4px * Theme.ui-scale;
                checked: root.new-rule-case-sensitive;
                toggled => { root.new-rule-case-sensitive = self.checked; }
            }

            CompactCheckBox {
                text: @tr("Whole line");
                gap: 4px * Theme.ui-scale;
                checked: root.new-rule-whole-line;
                toggled => { root.new-rule-whole-line = self.checked; }
            }

            CursorColorInput {
                input-height: 20px * Theme.ui-scale;
                width: 100px * Theme.ui-scale;
                value <=> root.highlight-draft-color-hex;
                preview-color: root.highlight-draft-swatch;
                apply-color(v) => { return root.set-highlight-draft-color(v); }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.rule-edit-index < 0: GhostButton {
                text: @tr("Reset rules");
                clicked => {
                    root.reset-output-highlight-rules();
                    root.reset-rule-form();
                }
            }

            if root.rule-edit-index >= 0: GhostButton {
                text: @tr("Cancel");
                clicked => { root.reset-rule-form(); }
            }

            PrimaryButton {
                text: root.rule-edit-index >= 0
                    ? (@tr("Save"))
                    : (@tr("Add rule"));
                disabled: root.new-rule-name == "" || root.new-rule-pattern == "";
                clicked => {
                    if root.save-rule-form() {
                        root.reset-rule-form();
                    }
                }
            }
        }

        if root.output-highlight-rule-status != "": SettingHint {
            text: root.output-highlight-rule-status;
            color: Theme.danger;
        }

        if root.output-highlight-rules.length == 0: SettingHint {
            text: @tr("No custom rules yet");
            height: 34px * Theme.ui-scale;
            vertical-alignment: center;
        }

        if root.output-highlight-rules.length > 0: Rectangle {
            height: 8px * Theme.ui-scale;
        }
        rule-list := VerticalLayout {
            spacing: 0;
            for rule[index] in root.output-highlight-rules: rule-row := Rectangle {
                height: root.rule-row-h;
                border-radius: Theme.radius-md;
                clip: true;
                // Drag source / drop target chrome, else edit/hover highlight.
                background: root.rule-dragging && root.rule-drag-from == index ? Theme.bg-active
                    : (root.rule-dragging
                        && root.rule-drop-before == index
                        && root.rule-drag-from != index
                        && root.rule-drop-before != root.rule-drag-from + 1
                        ? Theme.accent.with-alpha(0.12)
                        : (root.rule-edit-index == index ? Theme.bg-active
                            : (row-ta.has-hover || up-ta.has-hover || down-ta.has-hover
                                || rule-sw.has-hover || edit-ta.has-hover || delete-ta.has-hover
                                || ctx-menu.is-open
                                ? Theme.bg-hover : transparent)));
                animate background { duration: 120ms; }

                property <length> ctx-x;
                property <length> ctx-y;
                property <bool> press-dragging: false;
                property <bool> did-drag: false;
                property <length> grab-x;
                property <length> grab-y;

                row-ta := TouchArea {
                    mouse-cursor: root.rule-dragging && root.rule-drag-from == index
                        ? grabbing : grab;
                    double-clicked => {
                        if (!root.rule-dragging) {
                            root.load-rule-into-form(index);
                        }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                            rule-row.ctx-x = self.mouse-x;
                            rule-row.ctx-y = self.mouse-y;
                            ctx-menu.show();
                        } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            rule-row.press-dragging = true;
                            rule-row.did-drag = false;
                            rule-row.grab-x = self.mouse-x;
                            rule-row.grab-y = self.mouse-y;
                        } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                            if (rule-row.press-dragging && rule-row.did-drag) {
                                root.finish-rule-drag();
                            }
                            rule-row.press-dragging = false;
                            rule-row.did-drag = false;
                        }
                    }
                    moved => {
                        if (rule-row.press-dragging) {
                            if (!rule-row.did-drag
                                && (abs(self.mouse-x - rule-row.grab-x) > 5px * Theme.ui-scale
                                || abs(self.mouse-y - rule-row.grab-y) > 5px * Theme.ui-scale)) {
                                rule-row.did-drag = true;
                                root.rule-drag-from = index;
                                root.rule-drop-before = index;
                                root.rule-dragging = true;
                            }
                            if (rule-row.did-drag) {
                                root.update-rule-drop(self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 9px * Theme.ui-scale;
                    padding-left: 6px * Theme.ui-scale;
                    padding-right: 4px * Theme.ui-scale;
                    cross-axis-alignment: center;

                    Rectangle {
                        width: 8px * Theme.ui-scale;
                        height: 8px * Theme.ui-scale;
                        border-radius: 4px * Theme.ui-scale;
                        background: rule.swatch;
                        vertical-stretch: 0;
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 2px * Theme.ui-scale;
                        Text {
                            text: rule.name;
                            color: rule.enabled ? Theme.text-primary : Theme.text-muted;
                            font-family: Theme.term-font-family;
                            font-size: 12px * Theme.ui-scale;
                            overflow: elide;
                        }

                        Text {
                            text: rule.pattern + " · "
                                + (rule.regex ? "Regex" : (@tr("Keyword")))
                                + (rule.case-sensitive ? " · Aa" : "")
                                + (rule.whole-line ? (@tr(" · whole line")) : "");
                            color: Theme.text-muted;
                            font-size: 10px * Theme.ui-scale;
                            overflow: elide;
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px * Theme.ui-scale;
                        width: 56px * Theme.ui-scale;

                        Rectangle {
                            width: 26px * Theme.ui-scale;
                            height: 26px * Theme.ui-scale;
                            border-radius: Theme.radius-sm;
                            opacity: rule.can-move-up ? 1.0 : 0.35;
                            background: up-ta.has-hover && rule.can-move-up ? Theme.bg-active : transparent;
                            up-ta := TouchArea {
                                enabled: !root.rule-dragging;
                                mouse-cursor: rule.can-move-up ? pointer : default;
                                clicked => {
                                    if (rule.can-move-up) {
                                        root.adjust-edit-index-after-move(index, index - 1);
                                        root.move-output-highlight-rule(index, -1);
                                    }
                                }
                            }

                            Text {
                                text: "↑";
                                color: Theme.text-secondary;
                                font-size: 12px * Theme.ui-scale;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }

                        Rectangle {
                            width: 26px * Theme.ui-scale;
                            height: 26px * Theme.ui-scale;
                            border-radius: Theme.radius-sm;
                            opacity: rule.can-move-down ? 1.0 : 0.35;
                            background: down-ta.has-hover && rule.can-move-down ? Theme.bg-active : transparent;
                            down-ta := TouchArea {
                                enabled: !root.rule-dragging;
                                mouse-cursor: rule.can-move-down ? pointer : default;
                                clicked => {
                                    if (rule.can-move-down) {
                                        root.adjust-edit-index-after-move(index, index + 1);
                                        root.move-output-highlight-rule(index, 1);
                                    }
                                }
                            }

                            Text {
                                text: "↓";
                                color: Theme.text-secondary;
                                font-size: 12px * Theme.ui-scale;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }

                    Rectangle {
                        width: 28px * Theme.ui-scale;
                        height: 28px * Theme.ui-scale;
                        border-radius: Theme.radius-sm;
                        background: edit-ta.has-hover ? Theme.bg-active : transparent;
                        edit-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.load-rule-into-form(index); }
                        }

                        Text {
                            text: "\u{E3C9}";
                            font-family: "Material Icons";
                            color: Theme.text-muted;
                            font-size: 15px * Theme.ui-scale;
                            width: 100%;
                            height: 100%;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 28px * Theme.ui-scale;
                        height: 28px * Theme.ui-scale;
                        border-radius: Theme.radius-sm;
                        background: delete-ta.has-hover ? Theme.bg-active : transparent;
                        delete-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                if (root.rule-edit-index == index) {
                                    root.reset-rule-form();
                                } else if (root.rule-edit-index > index) {
                                    root.rule-edit-index = root.rule-edit-index - 1;
                                }
                                root.remove-output-highlight-rule(index);
                            }
                        }

                        Text {
                            text: "\u{E872}";
                            font-family: "Material Icons";
                            color: Theme.text-muted;
                            font-size: 15px * Theme.ui-scale;
                            width: 100%;
                            height: 100%;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    rule-sw := Switch {
                        on: rule.enabled;
                        toggled(v) => {
                            // Disabling parks the rule at the end — keep the
                            // edit form pointed at the same rule.
                            if (!v && root.rule-edit-index >= 0) {
                                if (root.rule-edit-index == index) {
                                    root.rule-edit-index = root.output-highlight-rules.length - 1;
                                } else if (root.rule-edit-index > index) {
                                    root.rule-edit-index = root.rule-edit-index - 1;
                                }
                            }
                            root.set-output-highlight-rule-enabled(index, v);
                        }
                    }
                }

                ctx-menu := PopupWindow {
                    x: rule-row.ctx-x;
                    y: rule-row.ctx-y;
                    width: menu-vl.preferred-width;
                    height: menu-vl.preferred-height;

                    Rectangle {
                        background: Theme.popup-bg;
                        border-radius: Theme.radius-sm;
                        border-width: 1px * Theme.ui-scale;
                        border-color: Theme.border-strong;
                        drop-shadow-blur: 10px * Theme.ui-scale;
                        drop-shadow-color: #00000050;

                        menu-vl := VerticalLayout {
                            padding: 4px * Theme.ui-scale;
                            spacing: 2px * Theme.ui-scale;

                            MenuItem {
                                icon: "\u{E25A}";
                                label: @tr("Move to top");
                                clicked => {
                                    root.adjust-edit-index-after-move(index, 0);
                                    root.move-output-highlight-rule-to-top(index);
                                }
                            }

                            MenuItem {
                                icon: "\u{E258}";
                                label: @tr("Move to bottom");
                                clicked => {
                                    let last = root.output-highlight-rules.length - 1;
                                    root.adjust-edit-index-after-move(index, last);
                                    root.move-output-highlight-rule-to-bottom(index);
                                }
                            }

                            MenuItem {
                                icon: "\u{E837}";
                                label: @tr("Only enable this");
                                clicked => {
                                    // Sole enabled rule is parked at index 0.
                                    if (root.rule-edit-index == index) {
                                        root.rule-edit-index = 0;
                                    } else if (root.rule-edit-index >= 0) {
                                        root.reset-rule-form();
                                    }
                                    root.select-only-output-highlight-rule(index);
                                }
                            }

                            Rectangle {
                                height: 1px * Theme.ui-scale;
                                background: Theme.border-subtle;
                            }

                            MenuItem {
                                icon: "\u{E162}";
                                label: @tr("Select all");
                                clicked => { root.select-all-output-highlight-rules(); }
                            }

                            MenuItem {
                                icon: "\u{E8D4}";
                                label: @tr("Invert selection");
                                clicked => {
                                    // Bulk reorder of enabled/disabled — drop
                                    // the edit form rather than guess the index.
                                    if (root.rule-edit-index >= 0) {
                                        root.reset-rule-form();
                                    }
                                    root.invert-output-highlight-rule-selection();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
