import { PrimaryButton, DangerButton } from "../../widgets.slint";
import { SectionHeader, SettingRow, Switch } from "../widgets.slint";

export component DataSettingsPage inherits Rectangle {
    height: self.preferred-height;
    in-out property <bool> credentials-vault-available: true;
    callback request-clear-known-hosts();
    callback request-clear-passwords();
    callback request-clear-sessions();
    callback request-restore-settings();
    in-out property <bool> save-passwords: false;
    callback set-save-passwords(bool);

    VerticalLayout {
        padding-left: 15px;
        padding-right: 15px;
        padding-top: 15px;
        spacing: 0;
        alignment: start;
        SectionHeader {
            text: @tr("DATA");
        }

        SettingRow {
            label: @tr("Save passwords / private-keys");
            desc: !root.credentials-vault-available
                ? (@tr("Unavailable: OS keyring cannot store the vault master key."))
                : (@tr("When on, passwords and private keys are stored in an encrypted vault (OS keyring master key). Turning this off does not clear credentials already saved."));
            Switch {
                enabled: root.credentials-vault-available;
                on: root.save-passwords;
                toggled(v) => { root.save-passwords = v; root.set-save-passwords(v); }
            }
        }

        SettingRow {
            label: @tr("Clear saved passwords / private-keys");
            desc: @tr("Remove every stored password, private-keys from saved sessions.");
            DangerButton {
                text: @tr("Clear");
                clicked => { root.request-clear-passwords(); }
            }
        }

        SettingRow {
            label: @tr("Clear SSH known hosts");
            desc: @tr("Forget remembered server host keys. The next connection to each host will ask you to trust the key again.");
            DangerButton {
                text: @tr("Clear");
                clicked => { root.request-clear-known-hosts(); }
            }
        }

        SettingRow {
            label: @tr("Clear all groups and sessions");
            desc: @tr("Permanently delete every saved Quick Connect group and session. Open tabs are not closed. You can choose whether to also clear saved passwords / private keys.");
            DangerButton {
                text: @tr("Clear");
                clicked => { root.request-clear-sessions(); }
            }
        }

        SettingRow {
            label: @tr("Restore default settings");
            desc: @tr("Reset settings preferences to defaults (including SSH/SFTP algorithms). Saved groups, sessions, commands, passwords, private-keys, and SSH known hosts are kept.");
            show-divider: false;
            PrimaryButton {
                text: @tr("Restore");
                clicked => { root.request-restore-settings(); }
            }
        }
    }
}
