import { Theme } from "../../shared/theme.slint";
import { ComboBox } from "std-widgets.slint";
import { GhostButton, CompactCheckBox } from "../../shared/widgets.slint";
import {
    SectionHeader,
    SettingHint,
    SettingRow,
    Switch,
    Stepper,
} from "../widgets.slint";
import { AlgorithmOptionRow } from "../../types/settings.slint";

export component SshSettingsPage inherits Rectangle {
    height: self.preferred-height;
    in-out property <bool> download-always-ask;
    callback move-ssh-algorithm(string, int);
    callback reset-ssh-algorithm-section();
    callback reset-ssh-algorithms();
    callback set-download-always-ask(bool);
    callback set-sftp-follow-cd(bool);
    callback set-ssh-algorithm-category(string);
    callback set-ssh-keepalive-secs(int);
    in-out property <bool> sftp-follow-cd;
    in-out property <string> ssh-algorithm-category: "kex";
    in property <[AlgorithmOptionRow]> ssh-algorithm-rows;
    in-out property <int> ssh-keepalive-secs: 0;
    callback toggle-ssh-algorithm(string);

    VerticalLayout {
        padding-left: 15px;
        padding-right: 15px;
        padding-top: 15px;
        spacing: 0;
        alignment: start;
        SectionHeader {
            text: "SSH";
        }

        SettingRow {
            label: @tr("Keepalive interval");
            desc: @tr("0 disables keepalive. A positive value is the interval in seconds. Some older switches drop OpenSSH keepalive packets — leave this at 0 for those devices. Applies to new connections.");
            Stepper {
                value: root.ssh-keepalive-secs;
                minimum: 0;
                maximum: 3600;
                step: 5;
                unit: "s";
                changed(v) => {
                    root.ssh-keepalive-secs = v;
                    root.set-ssh-keepalive-secs(v);
                }
            }
        }

        SectionHeader {
            text: @tr("SSH ALGORITHMS");
        }

        SettingHint {
            text: @tr("Choose which algorithms are offered (order = preference). Leaving the built-in defaults enables an automatic compact retry for very old devices. Custom lists are applied strictly. Takes effect on new connections.");
        }

        SettingRow {
            label: @tr("Category");
            desc: @tr("Key exchange, host key, cipher, MAC, or compression.");
            ComboBox {
                width: 150px;
                height: 30px;
                model: [
                    @tr("Key exchange"),
                    @tr("Host key"),
                    @tr("Cipher"),
                    @tr("MAC"),
                    @tr("Compression")
                ];
                current-index: root.ssh-algorithm-category == "serverHostKey" ? 1
                    : (root.ssh-algorithm-category == "cipher" ? 2
                    : (root.ssh-algorithm-category == "hmac" ? 3
                    : (root.ssh-algorithm-category == "compress" ? 4 : 0)));
                selected(v) => {
                    root.ssh-algorithm-category = v == @tr("Host key") || v == "Host key" || v == "主机密钥" ? "serverHostKey"
                        : (v == @tr("Cipher") || v == "Cipher" || v == "加密算法" ? "cipher"
                        : (v == @tr("MAC") || v == "MAC" || v == "消息认证码" ? "hmac"
                        : (v == @tr("Compression") || v == "Compression" || v == "压缩算法" ? "compress" : "kex")));
                    root.set-ssh-algorithm-category(root.ssh-algorithm-category);
                }
            }
        }

        SettingRow {
            label: @tr("Reset");
            desc: @tr("Restore this category or every algorithm list to the built-in defaults.");
            show-divider: false;
            HorizontalLayout {
                spacing: 8px;
                GhostButton {
                    text: @tr("This category");
                    clicked => { root.reset-ssh-algorithm-section(); }
                }

                GhostButton {
                    text: @tr("All defaults");
                    clicked => { root.reset-ssh-algorithms(); }
                }
            }
        }

        for algo[index] in root.ssh-algorithm-rows: Rectangle {
            height: 34px * Theme.panel-font;
            HorizontalLayout {
                spacing: 8px;
                padding-top: 4px;
                padding-bottom: 4px;
                cross-axis-alignment: center;

                CompactCheckBox {
                    horizontal-stretch: 1;
                    text: algo.name;
                    checked: algo.checked;
                    toggled => { root.toggle-ssh-algorithm(algo.name); }
                }

                if algo.weak: Rectangle {
                    border-radius: 4px;
                    background: Theme.danger.with-alpha(0.18);
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        Text {
                            text: @tr("weak");
                            color: Theme.danger;
                            font-size: 10px * Theme.panel-font;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                if algo.checked: HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 5px;
                        opacity: algo.can-move-up ? 1.0 : 0.35;
                        background: up-ta.has-hover && algo.can-move-up ? Theme.bg-hover : transparent;
                        up-ta := TouchArea {
                            mouse-cursor: algo.can-move-up ? pointer : default;
                            clicked => {
                                if (algo.can-move-up) {
                                    root.move-ssh-algorithm(algo.name, -1);
                                }
                            }
                        }

                        Text {
                            text: "↑";
                            color: Theme.text-secondary;
                            font-size: 12px * Theme.panel-font;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }

                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 5px;
                        opacity: algo.can-move-down ? 1.0 : 0.35;
                        background: down-ta.has-hover && algo.can-move-down ? Theme.bg-hover : transparent;
                        down-ta := TouchArea {
                            mouse-cursor: algo.can-move-down ? pointer : default;
                            clicked => {
                                if (algo.can-move-down) {
                                    root.move-ssh-algorithm(algo.name, 1);
                                }
                            }
                        }

                        Text {
                            text: "↓";
                            color: Theme.text-secondary;
                            font-size: 12px * Theme.panel-font;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: 100%;
                            height: 100%;
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.border-subtle;
            }
        }

        SectionHeader {
            text: "SFTP";
        }

        SettingRow {
            label: @tr("SFTP follows terminal cd");
            desc: @tr("A cd in the terminal switches the SFTP panel to the same directory.");
            Switch {
                on: root.sftp-follow-cd;
                toggled(v) => { root.sftp-follow-cd = v; root.set-sftp-follow-cd(v); }
            }
        }

        SettingRow {
            label: @tr("Always ask where to save");
            desc: @tr("Every SFTP download prompts for a location instead of using the preset folder.");
            show-divider: false;
            Switch {
                on: root.download-always-ask;
                toggled(v) => { root.download-always-ask = v; root.set-download-always-ask(v); }
            }
        }
    }
}
