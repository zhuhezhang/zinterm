import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { OutputRuleItem, AlgorithmOptionRow } from "../types/settings.slint";
import { NavItem } from "widgets.slint";
import { FontSettingsPage } from "pages/font.slint";
import { InputSettingsPage } from "pages/input.slint";
import { RendererSettingsPage } from "pages/renderer.slint";
import { OutputSettingsPage } from "pages/output.slint";
import { WallpaperSettingsPage } from "pages/wallpaper.slint";
import { SshSettingsPage } from "pages/ssh.slint";
import { SidebarSettingsPage } from "pages/sidebar.slint";
import { DataSettingsPage } from "pages/data.slint";
import { LanguageSettingsPage } from "pages/language.slint";
import { UpdateSettingsPage } from "pages/update.slint";

export component InterfacePanel inherits Rectangle {
    // Language preference: "auto" | "zh" | "en".
    in-out property <string> language-pref: "auto";
    in property <bool> is-windows;
    in-out property <string> renderer-mode: "software";
    in property <[string]> term-fonts;
    in property <string> term-font-family;
    in property <length> term-font-size;
    in-out property <float> terminal-line-spacing: 1.0;
    in-out property <bool> term-font-bold;
    in-out property <string> term-cursor-style: "bar";
    in-out property <string> term-cursor-color-hex: "#D4D4D4";
    in property <color> term-cursor-color: #D4D4D4;
    in-out property <bool> output-highlight-enabled;
    in-out property <bool> json-format-output: true;
    in-out property <string> output-highlight-preset;
    in property <[OutputRuleItem]> output-highlight-rules;
    in-out property <string> output-highlight-rule-status;
    // Draft colour for the add/edit form (validated hex + live swatch).
    in-out property <string> highlight-draft-color-hex: "#F14C4C";
    in-out property <color> highlight-draft-swatch: #F14C4C;
    in property <float> ui-scale;
    in-out property <bool> sftp-follow-cd;
    in-out property <bool> collapse-sftp-default;
    in-out property <bool> download-always-ask;
    in-out property <bool> paste-confirm-enabled: true;
    in-out property <bool> extra-paste-shortcuts-enabled: true;
    in-out property <bool> select-copy-right-paste-enabled: true;
    in-out property <bool> zen-mode: false;
    in-out property <bool> welcome-as-sidebar;
    in-out property <bool> confirm-delete-group-enabled: true;
    in-out property <bool> confirm-delete-session-enabled: false;
    in-out property <bool> welcome-single-click-connect: true;
    in-out property <bool> quick-commands-as-sidebar;
    in-out property <bool> update-check-enabled: false;
    in-out property <int> ssh-keepalive-secs: 0;
    in-out property <string> ssh-algorithm-category: "kex";
    in property <[AlgorithmOptionRow]> ssh-algorithm-rows;
    in-out property <bool> save-passwords: false;
    in-out property <bool> credentials-vault-available: true;
    in-out property <float> wallpaper-overlay;   // frosted-panel opacity 0.30-1.00
    // Active wallpaper id: "" / "builtin:light" / "builtin:dark" / a file path.
    in property <string> current-wallpaper;
    in property <string> custom-wallpaper-name;   // basename for the file row

    in property <string> ifd-start-page: "font";
    property <string> ifd-page: root.ifd-start-page;
    property <int> rule-edit-index: -1;   // -1 = add, >=0 = edit that rule
    property <string> new-rule-name;
    property <string> new-rule-pattern;
    property <bool> new-rule-regex;
    property <bool> new-rule-case-sensitive;
    property <bool> new-rule-whole-line;
    property <bool> renderer-restart-required;
    property <bool> wp-is-custom:
        root.current-wallpaper != "" && root.current-wallpaper != "builtin:light"
        && root.current-wallpaper != "builtin:dark" && root.current-wallpaper != "builtin:tech"
        && root.current-wallpaper != "builtin:miku" && root.current-wallpaper != "builtin:ms";

    callback set-term-font(string);
    callback set-term-font-size(int);
    callback set-terminal-line-spacing(float);
    callback set-term-font-bold(bool);
    callback set-term-cursor-style(string);
    callback set-term-cursor-color(string) -> bool;
    callback set-output-highlight(bool, string);
    callback set-json-format-output(bool);
    callback set-highlight-draft-color(string) -> bool;
    // name, pattern, regex, case-sensitive, whole-line, color
    callback add-output-highlight-rule(string, string, bool, bool, bool, string) -> bool;
    callback update-output-highlight-rule(int, string, string, bool, bool, bool, string) -> bool;
    callback remove-output-highlight-rule(int);
    callback set-output-highlight-rule-enabled(int, bool);

    function reset-rule-form() {
        root.rule-edit-index = -1;
        root.new-rule-name = "";
        root.new-rule-pattern = "";
        root.new-rule-regex = false;
        root.new-rule-case-sensitive = false;
        root.new-rule-whole-line = false;
        root.highlight-draft-color-hex = "#F14C4C";
        root.highlight-draft-swatch = #F14C4C;
        root.output-highlight-rule-status = "";
    }

    function load-rule-into-form(index: int) {
        if (index < 0 || index >= root.output-highlight-rules.length) {
            return;
        }
        root.rule-edit-index = index;
        root.new-rule-name = root.output-highlight-rules[index].name;
        root.new-rule-pattern = root.output-highlight-rules[index].pattern;
        root.new-rule-regex = root.output-highlight-rules[index].regex;
        root.new-rule-case-sensitive = root.output-highlight-rules[index].case-sensitive;
        root.new-rule-whole-line = root.output-highlight-rules[index].whole-line;
        root.highlight-draft-color-hex = root.output-highlight-rules[index].color;
        root.highlight-draft-swatch = root.output-highlight-rules[index].swatch;
        root.output-highlight-rule-status = "";
    }

    function save-rule-form() -> bool {
        if (root.rule-edit-index >= 0) {
            return root.update-output-highlight-rule(
                root.rule-edit-index,
                root.new-rule-name,
                root.new-rule-pattern,
                root.new-rule-regex,
                root.new-rule-case-sensitive,
                root.new-rule-whole-line,
                root.highlight-draft-color-hex);
        }
        return root.add-output-highlight-rule(
            root.new-rule-name,
            root.new-rule-pattern,
            root.new-rule-regex,
            root.new-rule-case-sensitive,
            root.new-rule-whole-line,
            root.highlight-draft-color-hex);
    }
    callback set-ui-scale(int);
    callback set-panel-font(int);   // settings-panel font scale, percent
    callback set-renderer-mode(string);
    callback set-sftp-follow-cd(bool);
    callback set-collapse-sftp-default(bool);
    callback set-download-always-ask(bool);
    callback set-paste-confirm-enabled(bool);
    callback set-extra-paste-shortcuts-enabled(bool);
    callback set-select-copy-right-paste-enabled(bool);
    callback set-zen-mode(bool);
    callback set-welcome-as-sidebar(bool);
    callback set-confirm-delete-group-enabled(bool);
    callback set-confirm-delete-session-enabled(bool);
    callback set-welcome-single-click-connect(bool);
    callback set-quick-commands-as-sidebar(bool);
    callback set-update-check-enabled(bool);   // startup new-version check (#184)
    callback set-ssh-keepalive-secs(int);
    callback set-ssh-algorithm-category(string);
    callback toggle-ssh-algorithm(string);
    callback move-ssh-algorithm(string, int);
    callback reset-ssh-algorithm-section();
    callback reset-ssh-algorithms();
    callback set-language(string);             // "auto" / "zh" / "en"
    callback persist-wallpaper-overlay(float);   // save the overlay opacity
    callback set-wallpaper(string);    // none / builtin selection
    callback pick-wallpaper-file();    // open the OS file dialog (Rust)
    callback set-save-passwords(bool);
    callback request-clear-known-hosts();
    callback request-clear-sessions();
    callback request-clear-passwords();
    callback request-restore-settings();

    HorizontalLayout {
        // --- Left nav ------------------------------------------------------
        Rectangle {
            width: 168px;
            // Transparent so the whole dialog is one frosted layer (the card's
            // bg-panel); a 1px divider keeps the nav/content separation (items 6/7).
            background: transparent;
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                height: parent.height;
                background: Theme.border-subtle;
            }

            nav-scroll := ScrollView {
                width: 100%;
                height: 100%;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, nav-items.preferred-height);
                nav-items := VerticalLayout {
                    width: nav-scroll.visible-width;
                    padding: 8px;
                    spacing: 2px;
                    alignment: start;
                    NavItem {
                        icon: "\u{E167}";
                        label: @tr("Font");
                        active: root.ifd-page == "font";
                        clicked => { root.ifd-page = "font"; }
                    }

                    NavItem {
                        icon: "\u{E312}";
                        label: @tr("Input");
                        active: root.ifd-page == "input";
                        clicked => { root.ifd-page = "input"; }
                    }

                    NavItem {
                        icon: "\u{E1B1}";
                        label: @tr("Rendering");
                        active: root.ifd-page == "renderer";
                        clicked => { root.ifd-page = "renderer"; }
                    }

                    NavItem {
                        icon: "\u{E8D4}";
                        label: @tr("Output");
                        active: root.ifd-page == "output";
                        clicked => { root.ifd-page = "output"; }
                    }

                    NavItem {
                        icon: "\u{E1BC}";
                        label: @tr("Wallpaper");
                        active: root.ifd-page == "wallpaper";
                        clicked => { root.ifd-page = "wallpaper"; }
                    }

                    NavItem {
                        icon: "\u{F013}";
                        label: "SSH / SFTP";
                        active: root.ifd-page == "ssh";
                        clicked => { root.ifd-page = "ssh"; }
                    }

                    NavItem {
                        icon: "\u{E314}";
                        label: @tr("Sidebars");
                        active: root.ifd-page == "sidebar";
                        clicked => { root.ifd-page = "sidebar"; }
                    }

                    NavItem {
                        icon: "\u{E88A}";
                        label: @tr("Welcome page");
                        active: root.ifd-page == "welcome";
                        clicked => { root.ifd-page = "welcome"; }
                    }

                    NavItem {
                        icon: "\u{E1DB}";
                        label: @tr("Data");
                        active: root.ifd-page == "data";
                        clicked => { root.ifd-page = "data"; }
                    }

                    NavItem {
                        icon: "\u{E894}";
                        label: @tr("Language");
                        active: root.ifd-page == "language";
                        clicked => { root.ifd-page = "language"; }
                    }

                    NavItem {
                        icon: "\u{E923}";
                        label: @tr("Update check");
                        active: root.ifd-page == "update";
                        clicked => { root.ifd-page = "update"; }
                    }
                }
            }
        }

        // --- Right content -------------------------------------------------
        Rectangle {
            horizontal-stretch: 1;
            // Transparent: the card's single bg-panel frost shows through, so the
            // settings panel matches the welcome panel and tracks the
            // wallpaper-opacity slider (items 6/7).
            background: transparent;

            settings-scroll := ScrollView {
                width: 100%;
                height: 100%;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, settings-pages.preferred-height);

                settings-pages := VerticalLayout {
                    width: settings-scroll.visible-width;

                    // --- Font page ---------------------------------------------
                    if root.ifd-page == "font": FontSettingsPage {
                        width: 100%;
                        term-cursor-color: root.term-cursor-color;
                        term-cursor-color-hex <=> root.term-cursor-color-hex;
                        term-cursor-style <=> root.term-cursor-style;
                        term-font-bold <=> root.term-font-bold;
                        term-font-family: root.term-font-family;
                        term-font-size: root.term-font-size;
                        term-fonts: root.term-fonts;
                        terminal-line-spacing <=> root.terminal-line-spacing;
                        ui-scale: root.ui-scale;
                        set-panel-font(a0) => { root.set-panel-font(a0); }
                        set-term-cursor-color(a0) => { return root.set-term-cursor-color(a0); }
                        set-term-cursor-style(a0) => { root.set-term-cursor-style(a0); }
                        set-term-font(a0) => { root.set-term-font(a0); }
                        set-term-font-bold(a0) => { root.set-term-font-bold(a0); }
                        set-term-font-size(a0) => { root.set-term-font-size(a0); }
                        set-terminal-line-spacing(a0) => { root.set-terminal-line-spacing(a0); }
                        set-ui-scale(a0) => { root.set-ui-scale(a0); }
                    }
                    if root.ifd-page == "input": InputSettingsPage {
                        width: 100%;
                        extra-paste-shortcuts-enabled <=> root.extra-paste-shortcuts-enabled;
                        paste-confirm-enabled <=> root.paste-confirm-enabled;
                        select-copy-right-paste-enabled <=> root.select-copy-right-paste-enabled;
                        set-extra-paste-shortcuts-enabled(a0) => { root.set-extra-paste-shortcuts-enabled(a0); }
                        set-paste-confirm-enabled(a0) => { root.set-paste-confirm-enabled(a0); }
                        set-select-copy-right-paste-enabled(a0) => { root.set-select-copy-right-paste-enabled(a0); }
                    }
                    if root.ifd-page == "renderer": RendererSettingsPage {
                        width: 100%;
                        is-windows: root.is-windows;
                        renderer-mode <=> root.renderer-mode;
                        renderer-restart-required <=> root.renderer-restart-required;
                        set-renderer-mode(a0) => { root.set-renderer-mode(a0); }
                    }
                    if root.ifd-page == "output": OutputSettingsPage {
                        width: 100%;
                        add-output-highlight-rule(a0, a1, a2, a3, a4, a5) => { return root.add-output-highlight-rule(a0, a1, a2, a3, a4, a5); }
                        update-output-highlight-rule(a0, a1, a2, a3, a4, a5, a6) => { return root.update-output-highlight-rule(a0, a1, a2, a3, a4, a5, a6); }
                        set-highlight-draft-color(a0) => { return root.set-highlight-draft-color(a0); }
                        highlight-draft-color-hex <=> root.highlight-draft-color-hex;
                        highlight-draft-swatch <=> root.highlight-draft-swatch;
                        json-format-output <=> root.json-format-output;
                        new-rule-case-sensitive <=> root.new-rule-case-sensitive;
                        new-rule-name <=> root.new-rule-name;
                        new-rule-pattern <=> root.new-rule-pattern;
                        new-rule-regex <=> root.new-rule-regex;
                        new-rule-whole-line <=> root.new-rule-whole-line;
                        output-highlight-enabled <=> root.output-highlight-enabled;
                        output-highlight-preset <=> root.output-highlight-preset;
                        output-highlight-rule-status <=> root.output-highlight-rule-status;
                        output-highlight-rules: root.output-highlight-rules;
                        rule-edit-index <=> root.rule-edit-index;
                        remove-output-highlight-rule(a0) => { root.remove-output-highlight-rule(a0); }
                        set-json-format-output(a0) => { root.set-json-format-output(a0); }
                        set-output-highlight(a0, a1) => { root.set-output-highlight(a0, a1); }
                        set-output-highlight-rule-enabled(a0, a1) => { root.set-output-highlight-rule-enabled(a0, a1); }
                    }
                    if root.ifd-page == "wallpaper": WallpaperSettingsPage {
                        width: 100%;
                        current-wallpaper: root.current-wallpaper;
                        custom-wallpaper-name: root.custom-wallpaper-name;
                        wallpaper-overlay <=> root.wallpaper-overlay;
                        persist-wallpaper-overlay(a0) => { root.persist-wallpaper-overlay(a0); }
                        pick-wallpaper-file => { root.pick-wallpaper-file(); }
                        set-wallpaper(a0) => { root.set-wallpaper(a0); }
                    }
                    if root.ifd-page == "ssh": SshSettingsPage {
                        width: 100%;
                        download-always-ask <=> root.download-always-ask;
                        sftp-follow-cd <=> root.sftp-follow-cd;
                        ssh-algorithm-category <=> root.ssh-algorithm-category;
                        ssh-algorithm-rows: root.ssh-algorithm-rows;
                        ssh-keepalive-secs <=> root.ssh-keepalive-secs;
                        move-ssh-algorithm(a0, a1) => { root.move-ssh-algorithm(a0, a1); }
                        reset-ssh-algorithm-section => { root.reset-ssh-algorithm-section(); }
                        reset-ssh-algorithms => { root.reset-ssh-algorithms(); }
                        set-download-always-ask(a0) => { root.set-download-always-ask(a0); }
                        set-sftp-follow-cd(a0) => { root.set-sftp-follow-cd(a0); }
                        set-ssh-algorithm-category(a0) => { root.set-ssh-algorithm-category(a0); }
                        set-ssh-keepalive-secs(a0) => { root.set-ssh-keepalive-secs(a0); }
                        toggle-ssh-algorithm(a0) => { root.toggle-ssh-algorithm(a0); }
                    }
                    if root.ifd-page == "sidebar" || root.ifd-page == "welcome": SidebarSettingsPage {
                        width: 100%;
                        ifd-page <=> root.ifd-page;
                        collapse-sftp-default <=> root.collapse-sftp-default;
                        confirm-delete-group-enabled <=> root.confirm-delete-group-enabled;
                        confirm-delete-session-enabled <=> root.confirm-delete-session-enabled;
                        quick-commands-as-sidebar <=> root.quick-commands-as-sidebar;
                        welcome-as-sidebar <=> root.welcome-as-sidebar;
                        welcome-single-click-connect <=> root.welcome-single-click-connect;
                        zen-mode <=> root.zen-mode;
                        set-collapse-sftp-default(a0) => { root.set-collapse-sftp-default(a0); }
                        set-confirm-delete-group-enabled(a0) => { root.set-confirm-delete-group-enabled(a0); }
                        set-confirm-delete-session-enabled(a0) => { root.set-confirm-delete-session-enabled(a0); }
                        set-quick-commands-as-sidebar(a0) => { root.set-quick-commands-as-sidebar(a0); }
                        set-welcome-as-sidebar(a0) => { root.set-welcome-as-sidebar(a0); }
                        set-welcome-single-click-connect(a0) => { root.set-welcome-single-click-connect(a0); }
                        set-zen-mode(a0) => { root.set-zen-mode(a0); }
                    }
                    if root.ifd-page == "data": DataSettingsPage {
                        width: 100%;
                        credentials-vault-available <=> root.credentials-vault-available;
                        save-passwords <=> root.save-passwords;
                        request-clear-known-hosts => { root.request-clear-known-hosts(); }
                        request-clear-passwords => { root.request-clear-passwords(); }
                        request-clear-sessions => { root.request-clear-sessions(); }
                        request-restore-settings => { root.request-restore-settings(); }
                        set-save-passwords(a0) => { root.set-save-passwords(a0); }
                    }
                    if root.ifd-page == "language": LanguageSettingsPage {
                        width: 100%;
                        language-pref <=> root.language-pref;
                        set-language(a0) => { root.set-language(a0); }
                    }
                    if root.ifd-page == "update": UpdateSettingsPage {
                        width: 100%;
                        update-check-enabled <=> root.update-check-enabled;
                        set-update-check-enabled(a0) => { root.set-update-check-enabled(a0); }
                    }
                }
            }
        }
    }
}
