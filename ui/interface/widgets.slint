import { Theme } from "../shared/theme.slint";
import { BorderedLineInput } from "../shared/widgets.slint";

export component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 30px * Theme.ui-scale;
    border-radius: 6px * Theme.ui-scale;
    background: root.active ? Theme.bg-active : (ta.has-hover ? Theme.bg-hover : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px * Theme.ui-scale;
        spacing: 9px * Theme.ui-scale;
        Text {
            text: root.icon;
            font-family: "Material Icons";
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: 15px * Theme.ui-scale;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: root.active ? Theme.text-primary : Theme.text-secondary;
            font-size: 13px * Theme.ui-scale;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// Small muted group heading (字体 / 预览 / SFTP …).
// Fixed height leaves CJK ascent room on macOS (Heiti/Songti metrics, #129).
export component SectionHeader inherits Text {
    font-size: 11px * Theme.ui-scale;
    font-weight: 700;
    color: Theme.text-muted;
    vertical-alignment: center;
    height: 26px * Theme.ui-scale;
}

// Muted page-level hint under a section / setting (same metrics as SettingRow.desc).
// Extra height: Slint preferred-height undershoots CJK descent on macOS (#129).
export component SettingHint inherits Text {
    color: Theme.text-muted;
    font-size: 11px * Theme.ui-scale;
    wrap: word-wrap;
    height: max(15px * Theme.ui-scale, self.preferred-height + 8px * Theme.ui-scale);
}

// A settings row: label (+ optional description) on the left, a control slot on
// the right via @children. Right-aligned and vertically centered.
export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> desc;
    in property <bool> show-divider: true;
    VerticalLayout {
        HorizontalLayout {
            spacing: 14px * Theme.ui-scale;
            padding-top: 9px * Theme.ui-scale;
            padding-bottom: 9px * Theme.ui-scale;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                // 5px (was 3) so CJK desc ascent doesn't collide with the label.
                spacing: 5px * Theme.ui-scale;
                Text {
                    text: root.label;
                    font-size: 13px * Theme.ui-scale;
                    color: Theme.text-primary;
                }

                // Pad height: preferred-height undershoots CJK ink on macOS (#129),
                // so wrapped desc (e.g. keepalive) loses the last line's descent.
                if root.desc != "": Rectangle {
                    height: max(15px * Theme.ui-scale, desc-text.preferred-height + 8px * Theme.ui-scale);
                    desc-text := Text {
                        width: 100%;
                        text: root.desc;
                        font-size: 11px * Theme.ui-scale;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                @children
            }
        }

        if root.show-divider: Rectangle {
            height: 1px * Theme.ui-scale;
            background: Theme.border-subtle;
        }
    }
}

// iOS-style toggle switch. Display-only `on` (driven by the parent); a tap emits
// the intended new value so the parent owns the state (avoids Slint's
// binding-break-on-self-assign gotcha).
export component Switch inherits Rectangle {
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 38px * Theme.ui-scale;
    height: 22px * Theme.ui-scale;
    border-radius: 11px * Theme.ui-scale;
    opacity: root.enabled ? 1.0 : 0.45;
    background: root.on ? Theme.accent : Theme.bg-active;
    animate background { duration: 120ms; }
    Rectangle {
        width: 16px * Theme.ui-scale;
        height: 16px * Theme.ui-scale;
        border-radius: 8px * Theme.ui-scale;
        y: 3px * Theme.ui-scale;
        x: root.on ? parent.width - self.width - 3px * Theme.ui-scale : 3px * Theme.ui-scale;
        background: white;
        animate x {
            duration: 120ms;
            easing: ease-out;
        }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.toggled(!root.on); }
    }
}

// [- value +] stepper. Display-only `value`; emits the clamped new value.
export component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> unit;
    callback changed(int);
    width: 112px * Theme.ui-scale;
    height: 26px * Theme.ui-scale;
    border-radius: 6px * Theme.ui-scale;
    background: Theme.bg-elevated;
    border-width: 1px * Theme.ui-scale;
    border-color: Theme.border-subtle;
    clip: true;
    HorizontalLayout {
        Rectangle {
            width: 30px * Theme.ui-scale;
            border-top-left-radius: Theme.radius-md;
            border-bottom-left-radius: Theme.radius-md;
            background: minus-ta.has-hover ? Theme.bg-hover : transparent;
            minus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(max(root.minimum, root.value - root.step)); }
            }

            Text {
                text: "\u{E15B}";
                font-family: "Material Icons";
                font-size: 14px * Theme.ui-scale;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            width: 1px * Theme.ui-scale;
            background: Theme.border-subtle;
        }

        Text {
            text: root.value + root.unit;
            horizontal-stretch: 1;
            font-size: 12px * Theme.ui-scale;
            color: Theme.text-primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Rectangle {
            width: 1px * Theme.ui-scale;
            background: Theme.border-subtle;
        }

        Rectangle {
            width: 30px * Theme.ui-scale;
            border-top-right-radius: Theme.radius-md;
            border-bottom-right-radius: Theme.radius-md;
            background: plus-ta.has-hover ? Theme.bg-hover : transparent;
            plus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(min(root.maximum, root.value + root.step)); }
            }

            Text {
                text: "\u{E145}";
                font-family: "Material Icons";
                font-size: 14px * Theme.ui-scale;
                color: Theme.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// Compact cursor-shape choice with a live visual sample (#275).
export component CursorStyleButton inherits Rectangle {
    in property <string> label;
    in property <string> cursor-kind;
    in property <bool> selected;
    callback clicked();
    width: 74px * Theme.ui-scale;
    height: 30px * Theme.ui-scale;
    border-radius: 6px * Theme.ui-scale;
    border-width: 1px * Theme.ui-scale;
    border-color: root.selected ? Theme.accent : Theme.border-subtle;
    background: root.selected ? Theme.bg-active : (cursor-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated);
    cursor-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 7px * Theme.ui-scale;
        padding-right: 7px * Theme.ui-scale;
        spacing: 6px * Theme.ui-scale;
        alignment: center;
        Rectangle {
            width: 14px * Theme.ui-scale;
            height: 100%;
            background: transparent;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 14px * Theme.ui-scale;
                height: 18px * Theme.ui-scale;
                background: Theme.term-bg;
                Rectangle {
                    x: 2px * Theme.ui-scale;
                    y: root.cursor-kind == "underline" ? parent.height - 3px * Theme.ui-scale : 2px * Theme.ui-scale;
                    width: root.cursor-kind == "bar" ? 2px * Theme.ui-scale : 10px * Theme.ui-scale;
                    height: root.cursor-kind == "underline" ? 2px * Theme.ui-scale : 14px * Theme.ui-scale;
                    background: Theme.term-fg;
                }
            }
        }

        Text {
            text: root.label;
            color: root.selected ? Theme.text-primary : Theme.text-secondary;
            font-size: 11px * Theme.ui-scale;
            vertical-alignment: center;
        }
    }
}

export component CursorPaletteSwatch inherits Rectangle {
    in property <string> hex;
    in property <color> swatch-color;
    in property <bool> selected;
    callback chosen(string);
    width: 26px * Theme.ui-scale;
    height: 26px * Theme.ui-scale;
    border-radius: 5px * Theme.ui-scale;
    border-width: root.selected ? 2px * Theme.ui-scale : 1px * Theme.ui-scale;
    border-color: root.selected ? Theme.accent : Theme.border-strong;
    background: root.swatch-color;
    swatch-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(root.hex); }
    }
}

// Hex RGB editor with a live swatch. Incomplete/invalid input remains editable
// but is marked red and is not applied or persisted.
export component CursorColorInput inherits Rectangle {
    in-out property <string> value;
    in property <color> preview-color;
    in property <length> input-height: 29px * Theme.ui-scale;
    property <bool> valid: true;
    callback apply-color(string) -> bool;
    width: 160px * Theme.ui-scale;
    height: root.input-height;

    HorizontalLayout {
        spacing: 6px * Theme.ui-scale;
        Rectangle {
            width: root.input-height;
            height: root.input-height;
            border-radius: 6px * Theme.ui-scale;
            border-width: 1px * Theme.ui-scale;
            border-color: Theme.border-strong;
            background: root.preview-color;
            color-button := TouchArea {
                mouse-cursor: pointer;
                clicked => { color-picker.show(); }
            }
        }

        color-input := BorderedLineInput {
            horizontal-stretch: 1;
            height: root.input-height;
            pad-x: 8px * Theme.ui-scale;
            text <=> root.value;
            font-family: Theme.term-font-family;
            font-size: 12px * Theme.ui-scale;
            idle-border: root.valid ? Theme.border-subtle : #e05252;
            edited => { root.valid = root.apply-color(self.text); }
        }
    }

    color-picker := PopupWindow {
        x: parent.width - self.width;
        y: parent.height + 4px * Theme.ui-scale;
        width: 210px * Theme.ui-scale;
        height: 160px * Theme.ui-scale;
        Rectangle {
            background: Theme.popup-bg;
            border-radius: 8px * Theme.ui-scale;
            border-width: 1px * Theme.ui-scale;
            border-color: Theme.border-strong;
            drop-shadow-blur: 12px * Theme.ui-scale;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 10px * Theme.ui-scale;
                spacing: 7px * Theme.ui-scale;
                Text {
                    text: root.value;
                    color: Theme.text-secondary;
                    font-family: Theme.term-font-family;
                    font-size: 11px * Theme.ui-scale;
                    vertical-alignment: center;
                }

                HorizontalLayout {
                    spacing: 6px * Theme.ui-scale;
                    CursorPaletteSwatch {
                        hex: "#D4D4D4";
                        swatch-color: #D4D4D4;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#FFFFFF";
                        swatch-color: #FFFFFF;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#FF5252";
                        swatch-color: #FF5252;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#FF9800";
                        swatch-color: #FF9800;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#FFD740";
                        swatch-color: #FFD740;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#69F0AE";
                        swatch-color: #69F0AE;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }
                }

                HorizontalLayout {
                    spacing: 6px * Theme.ui-scale;
                    CursorPaletteSwatch {
                        hex: "#00E676";
                        swatch-color: #00E676;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#00E5FF";
                        swatch-color: #00E5FF;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#40C4FF";
                        swatch-color: #40C4FF;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#448AFF";
                        swatch-color: #448AFF;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#7C4DFF";
                        swatch-color: #7C4DFF;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#E040FB";
                        swatch-color: #E040FB;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }
                }

                HorizontalLayout {
                    spacing: 6px * Theme.ui-scale;
                    CursorPaletteSwatch {
                        hex: "#F48FB1";
                        swatch-color: #F48FB1;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#FF8A65";
                        swatch-color: #FF8A65;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#FFF176";
                        swatch-color: #FFF176;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#A5D6A7";
                        swatch-color: #A5D6A7;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#80CBC4";
                        swatch-color: #80CBC4;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#90CAF9";
                        swatch-color: #90CAF9;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }
                }

                HorizontalLayout {
                    spacing: 6px * Theme.ui-scale;
                    CursorPaletteSwatch {
                        hex: "#B39DDB";
                        swatch-color: #B39DDB;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#CE93D8";
                        swatch-color: #CE93D8;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#BCAAA4";
                        swatch-color: #BCAAA4;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#9E9E9E";
                        swatch-color: #9E9E9E;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#607D8B";
                        swatch-color: #607D8B;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }

                    CursorPaletteSwatch {
                        hex: "#2D2D2F";
                        swatch-color: #2D2D2F;
                        selected: root.value == self.hex;
                        chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } }
                    }
                }
            }
        }
    }
}

// A macOS-style wallpaper thumbnail: a rounded, clipped preview (passed via
// @children) with a selection ring + check badge. The label sits below it in
// the page, not inside.
export component WallpaperSwatch inherits Rectangle {
    in property <bool> selected;
    callback clicked();
    width: 120px * Theme.ui-scale;
    height: 74px * Theme.ui-scale;
    border-radius: 8px * Theme.ui-scale;
    border-width: root.selected ? 3px * Theme.ui-scale : 1px * Theme.ui-scale;
    border-color: root.selected ? Theme.accent : Theme.border-strong;
    clip: true;
    @children
    if root.selected: Rectangle {
        x: parent.width - self.width - 5px * Theme.ui-scale;
        y: 5px * Theme.ui-scale;
        width: 18px * Theme.ui-scale;
        height: 18px * Theme.ui-scale;
        border-radius: 9px * Theme.ui-scale;
        background: Theme.accent;
        Text {
            text: "\u{E5CA}"; // check
            font-family: "Material Icons";
            color: white;
            font-size: 13px * Theme.ui-scale;
            width: 100%;
            height: 100%;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
