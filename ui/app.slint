        sftp-follow-cd <=> root.sftp-follow-cd;
        ssh-algorithm-category <=> root.ssh-algorithm-category;
        ssh-algorithm-rows: root.ssh-algorithm-rows;
        ssh-import-hint <=> root.ssh-import-hint;
        ssh-keepalive-secs <=> root.ssh-keepalive-secs;
        term-cursor-color <=> root.term-cursor-color;
        term-cursor-color-hex <=> root.term-cursor-color-hex;
        term-cursor-style <=> root.term-cursor-style;
        term-font-bold <=> root.term-font-bold;
        term-font-family <=> root.term-font-family;
        term-font-size <=> root.term-font-size;
        term-fonts: root.term-fonts;
        terminal-focus-seq <=> root.terminal-focus-seq;
        terminal-line-spacing <=> root.terminal-line-spacing;
        toggle-ssh-algorithm(a0) => { root.toggle-ssh-algorithm(a0); }
        ui-scale <=> root.ui-scale;
        update-check-enabled <=> root.update-check-enabled;
        update-output-highlight-rule(a0, a1, a2, a3, a4, a5, a6) => { return root.update-output-highlight-rule(a0, a1, a2, a3, a4, a5, a6); }
        wallpaper-overlay <=> root.wallpaper-overlay;
        welcome-as-sidebar <=> root.welcome-as-sidebar;
        welcome-delete-detail <=> root.welcome-delete-detail;
        welcome-delete-kind <=> root.welcome-delete-kind;
        welcome-delete-open <=> root.welcome-delete-open;
        welcome-delete-target <=> root.welcome-delete-target;
        welcome-single-click-connect <=> root.welcome-single-click-connect;
        zen-mode <=> root.zen-mode;
    }
}
