import { Theme } from "theme.slint";
import { PrimaryButton, GhostButton, TooltipArea } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

export struct SessionInfo {
    id: string,
    name: string,
    host: string,
    port: int,
    user: string,
    auth: string,      // "password" | "key"
    last-used: string, // ISO timestamp or "never"
    group: string,        // folder/group path ("" = root / ungrouped; "a/b" = nested)
    group-header: string, // set on the first row of each group → render a header
    group-label: string,  // last path segment shown in the header
    group-depth: int,     // nesting depth (0 = top-level)
    collapsed: bool,      // group is collapsed → this session row is hidden
    builtin: bool,        // legacy; always false (built-in system shells removed)
    conn-kind: string,    // "" | "ssh" | "serial" | "telnet" | "local"
    // Host / IP for ssh|telnet|local, serial port name for serial.
    endpoint: string,
}

// Column layout shared by the session list header and rows (non-compact only).
global SessionColLayout {
    out property <length> pad-left: 10px;
    out property <length> pad-right: 10px;
    out property <length> icon-w: 18px;
    // Gap between session/group icon and label (matches group-header spacing).
    out property <length> icon-gap: 4px;
    out property <length> split-w: 1px;
    out property <length> col-min: 64px;
}

// Draggable column headers for the welcome session list (#non-compact).
component SessionListHeader inherits Rectangle {
    in-out property <length> col-name;
    in-out property <length> col-host;
    callback persist-cols();

    property <bool> resizing-name: false;
    property <bool> resizing-host: false;

    height: 22px;
    background: Theme.bg-root;
    clip: true;

    HorizontalLayout {
        width: 100%;
        padding-left: SessionColLayout.pad-left;
        padding-right: SessionColLayout.pad-right;
        spacing: 0;

        Rectangle { width: SessionColLayout.icon-w; }
        Rectangle { width: SessionColLayout.icon-gap; }

        Rectangle {
            width: root.col-name;
            clip: true;
            Text {
                text: @tr("Name");
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
                overflow: elide;
            }
        }

        Rectangle {
            width: SessionColLayout.split-w;
            background: name-split.pressed || root.resizing-name ? Theme.accent : Theme.border-subtle;
            name-split := TouchArea {
                x: -3px;
                width: parent.width + 6px;
                mouse-cursor: ew-resize;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.resizing-name = true;
                    } else if (ev.kind == PointerEventKind.up) {
                        root.resizing-name = false;
                        root.persist-cols();
                    }
                }
                moved => {
                    if (root.resizing-name) {
                        root.col-name = clamp(
                            self.absolute-position.x + self.mouse-x - root.absolute-position.x
                                - SessionColLayout.pad-left - SessionColLayout.icon-w
                                - SessionColLayout.icon-gap,
                            SessionColLayout.col-min,
                            root.width - SessionColLayout.pad-left - SessionColLayout.pad-right
                                - SessionColLayout.icon-w - SessionColLayout.icon-gap
                                - 2 * SessionColLayout.split-w
                                - root.col-host - SessionColLayout.col-min);
                    }
                }
            }
        }

        Rectangle {
            width: root.col-host;
            clip: true;
            Text {
                text: " " + @tr("Host / IP / Serial Port");
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
                overflow: elide;
            }
        }

        Rectangle {
            width: SessionColLayout.split-w;
            background: host-split.pressed || root.resizing-host ? Theme.accent : Theme.border-subtle;
            host-split := TouchArea {
                x: -3px;
                width: parent.width + 6px;
                mouse-cursor: ew-resize;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.resizing-host = true;
                    } else if (ev.kind == PointerEventKind.up) {
                        root.resizing-host = false;
                        root.persist-cols();
                    }
                }
                moved => {
                    if (root.resizing-host) {
                        root.col-host = clamp(
                            self.absolute-position.x + self.mouse-x - root.absolute-position.x
                                - SessionColLayout.pad-left - SessionColLayout.icon-w
                                - SessionColLayout.icon-gap
                                - root.col-name - SessionColLayout.split-w,
                            SessionColLayout.col-min,
                            root.width - SessionColLayout.pad-left - SessionColLayout.pad-right
                                - SessionColLayout.icon-w - SessionColLayout.icon-gap
                                - 2 * SessionColLayout.split-w
                                - root.col-name - SessionColLayout.col-min);
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            Text {
                text: " " + @tr("User");
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
                overflow: elide;
            }
        }
    }
}

// --- SessionRow ------------------------------------------------------------
component SessionRow inherits Rectangle {
    in property <SessionInfo> session;
    in property <bool> compact;
    in property <length> col-name-width: 180px;
    in property <length> col-host-width: 180px;
    callback connect();
    callback edit();
    callback duplicate();
    callback move-to-group(string);
    callback remove();
    // Full session list — group-header is non-empty once per group, so the
    // "move to group" submenu can iterate it to list each group exactly once.
    in property <[SessionInfo]> all-sessions;
    property <bool> system-row: root.session.builtin;
    property <string> conn-icon:
        session.conn-kind == "serial" ? "\u{E1E0}" // usb
        : session.conn-kind == "telnet" ? "\u{E328}" // router
        : session.conn-kind == "local" ? "\u{E30A}"  // desktop_windows
        : "\u{E0DA}";                             // vpn_key (ssh)
    property <string> conn-label:
        session.conn-kind == "serial" ? @tr("Serial")
        : session.conn-kind == "telnet" ? "Telnet"
        : session.conn-kind == "local" ? @tr("Local")
        : "SSH";
    // e.g. "SSH 192.168.1.1 · 主机1"
    property <string> tip-text:
        session.endpoint == ""
            ? (conn-label + " · " + session.name)
            : (conn-label + " " + session.endpoint + " · " + session.name);
    property <string> detail-host:
        session.conn-kind == "serial" || session.conn-kind == "local" ? session.endpoint
        : (session.port > 0 ? session.host + ":" + session.port : session.host);
    property <string> detail-user:
        session.conn-kind == "serial" || session.conn-kind == "local" ? "" : session.user;
    // Nest under the owning group: one indent step past the group's own depth.
    property <length> group-indent:
        session.group == "" ? 0px : (session.group-depth + 1) * 16px;

    border-radius: Theme.radius-sm;
    background: touch.has-hover ? Theme.bg-hover : transparent;
    clip: true;
    animate background { duration: 120ms; }

    // Remember where the right-click landed so the popup can appear there.
    property <length> ctx-x;
    property <length> ctx-y;

    touch := TooltipArea {
        mouse-cursor: pointer;
        tooltip-text: root.tip-text;
        tip-from-cursor: true;
        anchor-width: root.width;
        anchor-height: root.height;
        activate => { root.connect(); }
        pointer-event(e) => {
            // Built-in PowerShell/CMD rows have no edit/move/delete actions.
            // All menu items are conditional on !system-row, so opening the
            // popup for them only produces an empty rectangle (#336).
            if (!root.system-row && e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                ctx-x = self.mouse-x;
                ctx-y = self.mouse-y;
                ctx-menu.show();
            }
        }
    }

    // Right-click context menu -----------------------------------------------
    ctx-menu := PopupWindow {
        x: ctx-x;
        y: ctx-y;
        width: 140px;
        // Height follows the content so a variable number of "move to" rows fit.
        height: menu-vl.preferred-height;

        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000050;

            menu-vl := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                // Edit
                if !root.system-row: Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: edit-ta.has-hover ? Theme.bg-hover : transparent;
                    edit-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.edit(); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Text {
                            text: "\u{E3C9}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Text {
                            text: @tr("Edit");
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Duplicate — clone this session as a starting point (#41).
                if !root.system-row: Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: dup-ta.has-hover ? Theme.bg-hover : transparent;
                    dup-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.duplicate(); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Text {
                            text: "\u{E14D}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Text {
                            text: @tr("Duplicate");
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Delete (red tint)
                if !root.system-row: Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: del-ta.has-hover ? #cc333320 : transparent;
                    del-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.remove(); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Text {
                            text: "\u{E872}";
                            font-family: "Material Icons";
                            color: #cc3333;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Text {
                            text: @tr("Delete");
                            color: #cc3333;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }

                if !root.system-row: Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                // "Move to" hint — labels the group list below so the user knows
                // these entries move the session into that folder.
                if !root.system-row: HorizontalLayout {
                    padding-left: 10px;
                    padding-top: 2px;
                    spacing: 6px;
                    Text {
                        text: "\u{E2C7}";
                        font-family: "Material Icons";
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }

                    Text {
                        text: @tr("Move to");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                // Move to root (ungrouped).
                if !root.system-row && root.session.group != "": Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: root-ta.has-hover ? Theme.bg-hover : transparent;
                    root-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.move-to-group(""); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        Text {
                            text: "\u{E2C7}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Text {
                            text: @tr("Root");
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }

                // Move to another group (#41). group-header is non-empty once
                // per group (incl. empty folders), so iterating the full list
                // yields each group once; the current group is skipped.
                for s[i] in root.all-sessions: Rectangle {
                    visible: !root.system-row && s.group-header != ""
                        && s.group-header != root.session.group;
                    height: self.visible ? 28px : 0px;
                    border-radius: Theme.radius-sm;
                    background: mv-ta.has-hover ? Theme.bg-hover : transparent;
                    mv-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.move-to-group(s.group-header); }
                    }

                    HorizontalLayout {
                        padding-left: 10px + s.group-depth * 16px;
                        spacing: 8px;
                        Text {
                            text: "\u{E2C7}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Text {
                            text: s.group-label;
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // Row content ------------------------------------------------------------
    // Non-compact columns must match SessionListHeader:
    //   pad | icon | gap | name | split | host | split | user
    // Group indent lives only inside the (icon+gap+name) cell so Host / User
    // stay aligned with the headers. Compact keeps a full-row indent.
    row-layout := HorizontalLayout {
        width: 100%;
        padding-left: SessionColLayout.pad-left + (root.compact ? root.group-indent : 0px);
        padding-right: SessionColLayout.pad-right;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 0;
        // Slint 1.17+: `alignment` is the main axis (horizontal). Keep stretch so
        // column stretch factors work; trailing compact spacer eats leftover width.
        // Do NOT use cross-axis-alignment: center — it sizes cells to a short
        // preferred-height and SessionRow's clip cuts off the top of the glyphs.
        alignment: stretch;

        if root.compact: Rectangle {
            width: SessionColLayout.icon-w;
            height: SessionColLayout.icon-w;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: Theme.bg-elevated;
            Text {
                text: root.conn-icon;
                font-family: "Material Icons";
                color: Theme.text-secondary;
                font-size: Theme.fs-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.compact: Rectangle { width: 8px; }

        // Natural-width label at the start of the row; trailing spacer absorbs
        // leftover width so the text cannot appear centered in the sidebar.
        if root.compact: Text {
            text: session.name;
            color: Theme.text-primary;
            font-size: Theme.fs-sm;
            wrap: no-wrap;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
        if root.compact: Rectangle { horizontal-stretch: 1; }

        // Fixed-width clipped cell so indent cannot push Host / User columns.
        if !root.compact: Rectangle {
            width: SessionColLayout.icon-w + SessionColLayout.icon-gap + root.col-name-width;
            clip: true;
            HorizontalLayout {
                width: parent.width;
                height: 100%;
                padding-left: root.group-indent;
                spacing: 0;
                alignment: stretch;

                Rectangle {
                    width: SessionColLayout.icon-w;
                    height: SessionColLayout.icon-w;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: Theme.bg-elevated;
                    Text {
                        text: root.conn-icon;
                        font-family: "Material Icons";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { width: SessionColLayout.icon-gap; }

                Text {
                    text: session.name;
                    color: Theme.text-primary;
                    font-size: Theme.fs-md;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
        if !root.compact: Rectangle { width: SessionColLayout.split-w; }
        if !root.compact: Rectangle {
            width: root.col-host-width;
            clip: true;
            Text {
                text: root.detail-host;
                color: Theme.text-secondary;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
                height: 100%;
                overflow: elide;
            }
        }
        if !root.compact: Rectangle { width: SessionColLayout.split-w; }
        if !root.compact: Rectangle {
            horizontal-stretch: 1;
            clip: true;
            Text {
                text: root.detail-user;
                color: Theme.text-secondary;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
                height: 100%;
                overflow: elide;
            }
        }
    }

    height: row-layout.preferred-height;
}

component CollapseButton inherits Rectangle {
    in property <string> glyph;
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.bg-hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.glyph;
        font-family: "Material Icons";
        color: Theme.text-secondary;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// --- Welcome ---------------------------------------------------------------
export component Welcome inherits Rectangle {
    in property <[SessionInfo]> sessions;
    in property <string> import-hint;        // result text after an import
    callback new-session();
    callback connect-session(string);
    callback edit-session(string);
    callback duplicate-session(string);
    callback move-session(string /* id */, string /* group */);
    callback toggle-group(string /* group */);
    callback new-sibling-group(string /* ref group path */);
    callback new-child-group(string /* ref group path */);
    callback edit-group(string /* path */, string /* label */);
    callback delete-group(string /* name */);
    callback remove-session(string);
    callback cycle-tab(bool /* reverse */);
    // Compact mode (welcome-as-sidebar): drop the big title/tagline header and
    // tighten padding so the session list fits a narrow docked panel (#v0.5).
    in property <bool> compact;
    in property <string> dock-edge: "left";
    property <bool> dock-horizontal: root.dock-edge == "left" || root.dock-edge == "right";
    // Collapse the sidebar to the edge icon strip (compact mode only) (#v0.5 M5).
    callback collapse();
    callback dock-drag-move(length, length);
    callback dock-drag-end();
    // Non-compact session list column widths (name / host); user column fills the rest.
    in-out property <length> session-col-name: 180px;
    in-out property <length> session-col-host: 180px;
    callback persist-session-cols(length /* name */, length /* host */);

    background: Theme.bg-root;

    // The regular welcome page is itself a tab. When Ctrl+Tab wraps from the
    // last terminal to this page, keep the shortcut chain alive so the next
    // press can continue to the first terminal (#294). The compact welcome
    // sidebar must never take focus away from an active terminal.
    if !root.compact: FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if ((Theme.is-mac ? event.modifiers.meta : event.modifiers.control)
                && (event.text == Key.Tab || event.text == Key.Backtab)) {
                root.cycle-tab(event.modifiers.shift || event.text == Key.Backtab);
                accept
            } else {
                reject
            }
        }
    }

    VerticalLayout {
        spacing: root.compact ? 12px : 0px;

        // Header (title + tagline) — pinned to the top at its natural height so
        // it can't grab the stretch space and spread apart (seen on macOS); the
        // quick-connect card below takes all the remaining height (#dock). Hidden
        // in compact/sidebar mode.
        if !root.compact: VerticalLayout {
            padding: 8px;
            vertical-stretch: 0;
            alignment: start;
            spacing: 4px;
            Text {
                text: "meatshell";
                color: Theme.text-primary;
                font-size: 28px;
                font-weight: 700;
            }

            Text {
                text: @tr("meatshell — a lightweight Rust + Slint SSH client by 'lil meatball'");
                color: Theme.text-secondary;
                font-size: Theme.fs-md;
                wrap: no-wrap;
            }
        }

        // Quick Connect card — always fills the remaining height so the panel
        // doesn't jump when the first session is added (the empty placeholder
        // stretches to fill just like the session list does) (#214).
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-panel;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: 8px;
                spacing: 12px;

                Rectangle {
                    height: header-row.preferred-height;
                    TouchArea {
                        enabled: root.compact;
                        mouse-cursor: move;
                        moved => {
                            root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.up) { root.dock-drag-end(); }
                        }
                    }

                    header-row := HorizontalLayout {
                        spacing: 4px;
                        padding-right: root.compact ? -8px : 0px;
                        if root.compact && root.dock-edge != "left": CollapseButton {
                            glyph: root.dock-edge == "right" ? "\u{E5CC}"
                                : root.dock-edge == "top" ? "\u{E5CE}"
                                : "\u{E5CF}";
                            clicked => { root.collapse(); }
                        }
                        Text {
                            text: @tr("Quick connect");
                            color: Theme.text-primary;
                            font-size: Theme.fs-lg;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        if root.compact && root.dock-edge == "left": CollapseButton {
                            glyph: "\u{E314}";
                            clicked => { root.collapse(); }
                        }
                        Text {
                            text: root.import-hint;
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        if !root.compact: PrimaryButton {
                            text: @tr("+ New session");
                            clicked => { root.new-session(); }
                        }
                    }
                }

                if root.compact: PrimaryButton {
                    text: @tr("+ New session");
                    clicked => { root.new-session(); }
                }

                if sessions.length == 0: Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-root;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: @tr("No sessions yet");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-md;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: @tr("Use 'New session' (top-right) to add your first server");
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                        }
                    }
                }

                if sessions.length > 0: VerticalLayout {
                    spacing: 0;
                    vertical-stretch: 1;

                    if !root.compact: SessionListHeader {
                        col-name <=> root.session-col-name;
                        col-host <=> root.session-col-host;
                        persist-cols => {
                            root.persist-session-cols(root.session-col-name, root.session-col-host);
                        }
                    }

                    sess-scroll := ScrollView {
                        vertical-stretch: 1;
                        // Compact sidebar: grow the viewport with the longest
                        // session/group label so names scroll instead of eliding.
                        viewport-width: root.compact
                            ? max(self.visible-width, sess-list.preferred-width)
                            : self.visible-width;
                        viewport-height: max(self.visible-height, sess-list.preferred-height);
                        sess-list := VerticalLayout {
                            width: sess-scroll.viewport-width;
                            spacing: 2px;
                            for session[i] in sessions: VerticalLayout {
                                spacing: 2px;
                                vertical-stretch: 0;
                                width: 100%;
                                // Group header on the first row of each group (#41).
                                // Click anywhere on it to collapse / expand the group.
                                if session.group-header != "": Rectangle {
                                    width: 100%;
                                    border-radius: Theme.radius-sm;
                                    background: grp-ta.has-hover ? Theme.bg-hover : transparent;
                                    clip: true;
                                    animate background { duration: 120ms; }

                                    property <bool> grp-nesting: true;
                                    property <int> grp-menu-count:
                                        (grp-nesting ? 1 : 0)
                                        + (session.id == "" && grp-nesting ? 1 : 0)
                                        + (grp-nesting ? 2 : 0);
                                    // Right-click popup anchor.
                                    property <length> gmx;
                                    property <length> gmy;

                                    grp-row := HorizontalLayout {
                                        width: 100%;
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                        padding-left: SessionColLayout.pad-left + session.group-depth * 16px;
                                        padding-right: SessionColLayout.pad-right;
                                        spacing: 4px;
                                        // Slint 1.17+: stretch + trailing spacer (compact) keeps
                                        // the label left. Avoid cross-axis center — it clips glyphs.
                                        alignment: stretch;

                                        // Collapse chevron — shown for every group, empty
                                        // folders included, so they line up and can be
                                        // toggled (an empty group just expands to nothing).
                                        Text {
                                            text: session.collapsed ? "\u{E5CC}" : "\u{E5CF}";
                                            font-family: "Material Icons";
                                            color: Theme.text-muted;
                                            font-size: Theme.fs-md;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            width: SessionColLayout.icon-w;
                                            height: SessionColLayout.icon-w;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 3px;
                                            background: Theme.bg-elevated;
                                            Text {
                                                text: "\u{E2C7}";   // folder glyph
                                                font-family: "Material Icons";
                                                color: Theme.text-secondary;
                                                font-size: Theme.fs-sm;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: session.group-label;
                                            color: Theme.text-primary;
                                            font-size: root.compact ? Theme.fs-sm : Theme.fs-md;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            // Compact: keep natural width so the label stays
                                            // left of any leftover row space (see spacer below).
                                            horizontal-stretch: root.compact ? 0 : 1;
                                            horizontal-alignment: left;
                                            wrap: no-wrap;
                                            overflow: root.compact ? clip : elide;
                                        }
                                        if root.compact: Rectangle { horizontal-stretch: 1; }
                                    }

                                    height: grp-row.preferred-height;

                                    grp-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        // Left-click toggles collapse (any group, incl.
                                        // empty); right-click opens the group menu.
                                        clicked => { root.toggle-group(session.group); }
                                        pointer-event(e) => {
                                            if (grp-menu-count > 0 && e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                                gmx = self.mouse-x;
                                                gmy = self.mouse-y;
                                                grp-menu.show();
                                            }
                                        }
                                    }

                                    grp-menu := PopupWindow {
                                        x: gmx;
                                        y: gmy;
                                        width: 156px;
                                        height: grp-menu-count * 28px + 9px;
                                        Rectangle {
                                            background: Theme.popup-bg;
                                            border-radius: Theme.radius-sm;
                                            border-width: 1px;
                                            border-color: Theme.border-strong;
                                            drop-shadow-blur: 10px;
                                            drop-shadow-color: #00000050;
                                            VerticalLayout {
                                                padding: 4px;
                                                spacing: 1px;
                                                // Edit (rename) group.
                                                if grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: eg-ta.has-hover ? Theme.bg-hover : transparent;
                                                    eg-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.edit-group(session.group, session.group-label); }
                                                    }

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E3C9}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("Rename group");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                    }
                                                }
                                                // Delete group — only when it has no sessions (id == "")
                                                if session.id == "" && grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: dg-ta.has-hover ? #cc333320 : transparent;
                                                    dg-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.delete-group(session.group); }
                                                    }

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E872}";
                                                            font-family: "Material Icons";
                                                            color: #cc3333;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("Delete group");
                                                            color: #cc3333;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                    }
                                                }
                                                // New sibling group (same parent path).
                                                if grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: sg-ta.has-hover ? Theme.bg-hover : transparent;
                                                    sg-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.new-sibling-group(session.group); }
                                                    }

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E2CC}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("New sibling group");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                            overflow: elide;
                                                        }
                                                    }
                                                }
                                                // New child group (nested under this folder).
                                                if grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: cg-ta.has-hover ? Theme.bg-hover : transparent;
                                                    cg-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.new-child-group(session.group); }
                                                    }

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E2CC}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("New child group");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                            overflow: elide;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if session.id != "" && session.id != "__group__" && !session.collapsed: SessionRow {
                                    width: 100%;
                                    session: session;
                                    compact: root.compact;
                                    col-name-width: root.session-col-name;
                                    col-host-width: root.session-col-host;
                                    all-sessions: root.sessions;
                                    connect => { root.connect-session(session.id); }
                                    edit => { root.edit-session(session.id); }
                                    duplicate => { root.duplicate-session(session.id); }
                                    move-to-group(g) => { root.move-session(session.id, g); }
                                    remove => { root.remove-session(session.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
