import { Theme } from "theme.slint";
import { PrimaryButton, GhostButton, TooltipArea, BorderedLineInput } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

export struct SessionInfo {
    id: string,
    name: string,
    host: string,
    port: int,
    user: string,
    auth: string,      // "password" | "key"
    last-used: string, // ISO timestamp or "never"
    group: string,        // folder/group path ("" = root / ungrouped; "a/b" = nested)
    group-header: string, // set on the first row of each group → render a header
    group-label: string,  // last path segment shown in the header
    group-depth: int,     // nesting depth (0 = top-level)
    collapsed: bool,      // group is collapsed → this session row is hidden
    builtin: bool,        // legacy; always false (built-in system shells removed)
    conn-kind: string,    // "" | "ssh" | "serial" | "telnet" | "local"
    // Host / IP for ssh|telnet|local, serial port name for serial.
    endpoint: string,
}

// Column layout shared by the session list header and rows (non-compact only).
global SessionColLayout {
    out property <length> pad-left: 10px;
    out property <length> pad-right: 10px;
    out property <length> icon-w: 18px;
    // Gap between session/group icon and label (matches group-header spacing).
    out property <length> icon-gap: 4px;
    out property <length> split-w: 1px;
    out property <length> col-min: 64px;
}

// Draggable column headers for the welcome session list (#non-compact).
component SessionListHeader inherits Rectangle {
    in-out property <length> col-name;
    in-out property <length> col-host;
    callback persist-cols();

    property <bool> resizing-name: false;
    property <bool> resizing-host: false;

    height: 22px;
    border-radius: Theme.radius-sm;
    background: Theme.bg-root;
    clip: true;

    HorizontalLayout {
        width: 100%;
        padding-left: SessionColLayout.pad-left;
        padding-right: SessionColLayout.pad-right;
        spacing: 0;

        Rectangle { width: SessionColLayout.icon-w; }
        Rectangle { width: SessionColLayout.icon-gap; }

        Rectangle {
            width: root.col-name;
            clip: true;
            Text {
                text: @tr("Name");
                color: Theme.text-muted;
                font-size: Theme.fs-md;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
                overflow: elide;
            }
        }

        Rectangle {
            width: SessionColLayout.split-w;
            background: name-split.pressed || root.resizing-name ? Theme.accent : Theme.border-subtle;
            name-split := TouchArea {
                x: -3px;
                width: parent.width + 6px;
                mouse-cursor: ew-resize;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.resizing-name = true;
                    } else if (ev.kind == PointerEventKind.up) {
                        root.resizing-name = false;
                        root.persist-cols();
                    }
                }
                moved => {
                    if (root.resizing-name) {
                        root.col-name = clamp(
                            self.absolute-position.x + self.mouse-x - root.absolute-position.x
                                - SessionColLayout.pad-left - SessionColLayout.icon-w
                                - SessionColLayout.icon-gap,
                            SessionColLayout.col-min,
                            root.width - SessionColLayout.pad-left - SessionColLayout.pad-right
                                - SessionColLayout.icon-w - SessionColLayout.icon-gap
                                - 2 * SessionColLayout.split-w
                                - root.col-host - SessionColLayout.col-min);
                    }
                }
            }
        }

        Rectangle {
            width: root.col-host;
            clip: true;
            Text {
                text: " " + @tr("Host / IP / Serial Port");
                color: Theme.text-muted;
                font-size: Theme.fs-md;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
                overflow: elide;
            }
        }

        Rectangle {
            width: SessionColLayout.split-w;
            background: host-split.pressed || root.resizing-host ? Theme.accent : Theme.border-subtle;
            host-split := TouchArea {
                x: -3px;
                width: parent.width + 6px;
                mouse-cursor: ew-resize;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.resizing-host = true;
                    } else if (ev.kind == PointerEventKind.up) {
                        root.resizing-host = false;
                        root.persist-cols();
                    }
                }
                moved => {
                    if (root.resizing-host) {
                        root.col-host = clamp(
                            self.absolute-position.x + self.mouse-x - root.absolute-position.x
                                - SessionColLayout.pad-left - SessionColLayout.icon-w
                                - SessionColLayout.icon-gap
                                - root.col-name - SessionColLayout.split-w,
                            SessionColLayout.col-min,
                            root.width - SessionColLayout.pad-left - SessionColLayout.pad-right
                                - SessionColLayout.icon-w - SessionColLayout.icon-gap
                                - 2 * SessionColLayout.split-w
                                - root.col-name - SessionColLayout.col-min);
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            Text {
                text: " " + @tr("User");
                color: Theme.text-muted;
                font-size: Theme.fs-md;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
                overflow: elide;
            }
        }
    }
}

// --- SessionRow ------------------------------------------------------------
component SessionRow inherits Rectangle {
    in property <SessionInfo> session;
    in property <bool> compact;
    in property <bool> single-click-connect: false;
    in property <length> col-name-width: 180px;
    in property <length> col-host-width: 180px;
    callback connect();
    callback edit();
    callback duplicate();
    callback remove();
    // Drag-to-reparent: press-move past a small threshold, then drop on a group.
    in property <bool> is-drag-source: false;
    in property <bool> is-drop-highlight: false;
    callback begin-drag();
    callback update-drag(length /* pointer-abs-y */);
    callback finish-drag(bool /* did-move */);
    property <bool> system-row: root.session.builtin;
    property <string> conn-icon:
        session.conn-kind == "serial" ? "\u{E1E0}" // usb
        : session.conn-kind == "telnet" ? "\u{E328}" // router
        : session.conn-kind == "local" ? "\u{E30A}"  // desktop_windows
        : "\u{E0DA}";                             // vpn_key (ssh)
    property <string> conn-label:
        session.conn-kind == "serial" ? @tr("Serial")
        : session.conn-kind == "telnet" ? "Telnet"
        : session.conn-kind == "local" ? @tr("Local")
        : "SSH";
    // e.g. "SSH 192.168.1.1 · 主机1"
    property <string> tip-text:
        session.endpoint == ""
            ? (conn-label + " · " + session.name)
            : (conn-label + " " + session.endpoint + " · " + session.name);
    property <string> detail-host:
        session.conn-kind == "serial" || session.conn-kind == "local" ? session.endpoint
        : (session.port > 0 ? session.host + ":" + session.port : session.host);
    property <string> detail-user:
        session.conn-kind == "serial" || session.conn-kind == "local" ? "" : session.user;
    // Nest under the owning group: one indent step past the group's own depth.
    property <length> group-indent:
        session.group == "" ? 0px : (session.group-depth + 1) * 16px;

    border-radius: Theme.radius-sm;
    background: root.is-drag-source ? Theme.bg-active
        : (root.is-drop-highlight ? Theme.accent.with-alpha(0.12)
        : (touch.has-hover ? Theme.bg-hover : transparent));
    clip: true;
    animate background { duration: 120ms; }

    // Remember where the right-click landed so the popup can appear there.
    property <length> ctx-x;
    property <length> ctx-y;
    property <bool> press-dragging: false;
    property <bool> did-drag: false;
    property <length> grab-x;
    property <length> grab-y;

    touch := TooltipArea {
        mouse-cursor: root.press-dragging && root.did-drag ? grabbing : pointer;
        tooltip-text: root.tip-text;
        tip-from-cursor: true;
        anchor-width: root.width;
        anchor-height: root.height;
        // Default: double-click connects; optional setting flips to single-click.
        activate => {
            if (!root.did-drag && root.single-click-connect) {
                root.connect();
            }
        }
        double-clicked => {
            if (!root.did-drag && !root.single-click-connect) {
                root.connect();
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.press-dragging = true;
                root.did-drag = false;
                root.grab-x = self.mouse-x;
                root.grab-y = self.mouse-y;
            } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                ctx-x = self.mouse-x;
                ctx-y = self.mouse-y;
                ctx-menu.show();
            } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                if (root.press-dragging) {
                    root.finish-drag(root.did-drag);
                }
                root.press-dragging = false;
                root.did-drag = false;
            }
        }
        moved => {
            if (root.press-dragging) {
                if (!root.did-drag
                    && (abs(self.mouse-x - root.grab-x) > 5px
                        || abs(self.mouse-y - root.grab-y) > 5px)) {
                    root.did-drag = true;
                    root.begin-drag();
                }
                if (root.did-drag) {
                    root.update-drag(self.absolute-position.y + self.mouse-y);
                }
            }
        }
    }

    // Right-click context menu -----------------------------------------------
    ctx-menu := PopupWindow {
        x: ctx-x;
        y: ctx-y;
        // Hug content so short labels don't leave empty space on the right.
        width: menu-vl.preferred-width;
        height: menu-vl.preferred-height;

        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000050;

            menu-vl := VerticalLayout {
                padding: 4px;
                spacing: 2px;

                // Connect — available for every row, including built-ins.
                Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: conn-ta.has-hover ? Theme.bg-hover : transparent;
                    conn-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.connect(); }
                    }

                    HorizontalLayout {
                        alignment: start;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: "\u{E037}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Text {
                            text: @tr("Connect");
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                        }
                    }
                }

                // Edit
                if !root.system-row: Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: edit-ta.has-hover ? Theme.bg-hover : transparent;
                    edit-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.edit(); }
                    }

                    HorizontalLayout {
                        alignment: start;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: "\u{E3C9}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Text {
                            text: @tr("Edit");
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                        }
                    }
                }

                // Duplicate — clone this session as a starting point (#41).
                if !root.system-row: Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: dup-ta.has-hover ? Theme.bg-hover : transparent;
                    dup-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.duplicate(); }
                    }

                    HorizontalLayout {
                        alignment: start;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: "\u{E14D}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Text {
                            text: @tr("Duplicate");
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                        }
                    }
                }

                // Delete (red tint)
                if !root.system-row: Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: del-ta.has-hover ? #cc333320 : transparent;
                    del-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.remove(); }
                    }

                    HorizontalLayout {
                        alignment: start;
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text {
                            text: "\u{E872}";
                            font-family: "Material Icons";
                            color: #cc3333;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }

                        Text {
                            text: @tr("Delete");
                            color: #cc3333;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // Row content ------------------------------------------------------------
    // Non-compact columns must match SessionListHeader:
    //   pad | icon | gap | name | split | host | split | user
    // Group indent lives only inside the (icon+gap+name) cell so Host / User
    // stay aligned with the headers. Compact keeps a full-row indent.
    row-layout := HorizontalLayout {
        width: 100%;
        padding-left: SessionColLayout.pad-left + (root.compact ? root.group-indent : 0px);
        padding-right: SessionColLayout.pad-right;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 0;
        // Slint 1.17+: `alignment` is the main axis (horizontal). Keep stretch so
        // column stretch factors work; trailing compact spacer eats leftover width.
        // Do NOT use cross-axis-alignment: center — it sizes cells to a short
        // preferred-height and SessionRow's clip cuts off the top of the glyphs.
        alignment: stretch;

        if root.compact: Rectangle {
            width: SessionColLayout.icon-w;
            height: SessionColLayout.icon-w;
            y: (parent.height - self.height) / 2;
            border-radius: 3px;
            background: Theme.bg-elevated;
            Text {
                text: root.conn-icon;
                font-family: "Material Icons";
                color: Theme.text-secondary;
                font-size: Theme.fs-sm;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.compact: Rectangle { width: 8px; }

        // Natural-width label at the start of the row; trailing spacer absorbs
        // leftover width so the text cannot appear centered in the sidebar.
        if root.compact: Text {
            text: session.name;
            color: Theme.text-primary;
            font-size: Theme.fs-sm;
            wrap: no-wrap;
            vertical-alignment: center;
            horizontal-alignment: left;
        }
        if root.compact: Rectangle { horizontal-stretch: 1; }

        // Fixed-width clipped cell so indent cannot push Host / User columns.
        if !root.compact: Rectangle {
            width: SessionColLayout.icon-w + SessionColLayout.icon-gap + root.col-name-width;
            clip: true;
            HorizontalLayout {
                width: parent.width;
                height: 100%;
                padding-left: root.group-indent;
                spacing: 0;
                alignment: stretch;

                Rectangle {
                    width: SessionColLayout.icon-w;
                    height: SessionColLayout.icon-w;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: Theme.bg-elevated;
                    Text {
                        text: root.conn-icon;
                        font-family: "Material Icons";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { width: SessionColLayout.icon-gap; }

                Text {
                    text: session.name;
                    color: Theme.text-primary;
                    font-size: Theme.fs-md;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
        if !root.compact: Rectangle { width: SessionColLayout.split-w; }
        if !root.compact: Rectangle {
            width: root.col-host-width;
            clip: true;
            Text {
                text: root.detail-host;
                color: Theme.text-secondary;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
                height: 100%;
                overflow: elide;
            }
        }
        if !root.compact: Rectangle { width: SessionColLayout.split-w; }
        if !root.compact: Rectangle {
            horizontal-stretch: 1;
            clip: true;
            Text {
                text: root.detail-user;
                color: Theme.text-secondary;
                font-size: Theme.fs-sm;
                vertical-alignment: center;
                horizontal-alignment: left;
                width: parent.width;
                height: 100%;
                overflow: elide;
            }
        }
    }

    height: row-layout.preferred-height;
}

component CollapseButton inherits Rectangle {
    in property <string> glyph;
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.bg-hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.glyph;
        font-family: "Material Icons";
        color: Theme.text-secondary;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// --- Welcome ---------------------------------------------------------------
export component Welcome inherits Rectangle {
    in property <[SessionInfo]> sessions;
    in-out property <string> session-search: "";
    callback search-sessions(string /* query */);
    callback new-session(string /* host */, bool /* focus-host */);
    callback new-session-in-group(string /* group */);
    callback connect-session(string);
    callback edit-session(string);
    callback duplicate-session(string);
    callback toggle-group(string /* group */);
    callback expand-all-groups();
    callback collapse-all-groups();
    callback expand-group-children(string /* group */);
    callback collapse-group-children(string /* group */);
    callback new-sibling-group(string /* ref group path */);
    callback new-child-group(string /* ref group path */);
    callback edit-group(string /* path */, string /* label */);
    callback delete-group(string /* name */);
    callback remove-session(string /* id */, string /* name */);
    callback cycle-tab(bool /* reverse */);
    // Global ⌘/Ctrl+F — AppWindow expands sidebar if needed then bumps search-focus-seq.
    callback focus-session-search();
    // Compact mode (welcome-as-sidebar): drop the big title/tagline header and
    // tighten padding so the session list fits a narrow docked panel (#v0.5).
    in property <bool> compact;
    // When true, a single click connects; otherwise double-click is required.
    in property <bool> single-click-connect: false;
    in property <string> dock-edge: "left";
    property <bool> dock-horizontal: root.dock-edge == "left" || root.dock-edge == "right";
    // Collapse the sidebar to the edge icon strip (compact mode only) (#v0.5 M5).
    callback collapse();
    callback dock-drag-move(length, length);
    callback dock-drag-end();
    // Non-compact session list column widths (name / host); user column fills the rest.
    in-out property <length> session-col-name: 180px;
    in-out property <length> session-col-host: 180px;
    callback persist-session-cols(length /* name */, length /* host */);
    // Drag session/group onto another group (or root) to re-parent.
    in-out property <string> welcome-drag-kind;    // "" | "session" | "group"
    in-out property <string> welcome-drag-from;    // session id or group path
    in-out property <string> welcome-drop-target;  // destination group path ("" = root)
    callback welcome-drag-at(length /* list-top-y */, length /* pointer-y */, string /* kind */, string /* from */);
    callback drop-welcome-session(string /* id */, string /* target-group */);
    callback drop-welcome-group(string /* path */, string /* target-parent */);
    // Global ⌘/Ctrl+F bumps this so the visible search field grabs focus.
    in property <int> search-focus-seq: 0;

    background: Theme.bg-root;

    // The regular welcome page is itself a tab. When Ctrl+Tab wraps from the
    // last terminal to this page, keep the shortcut chain alive so the next
    // press can continue to the first terminal (#294). The compact welcome
    // sidebar must never take focus away from an active terminal.
    if !root.compact: FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            if ((Theme.is-mac ? event.modifiers.meta : event.modifiers.control)
                && (event.text == Key.Tab || event.text == Key.Backtab)) {
                root.cycle-tab(event.modifiers.shift || event.text == Key.Backtab);
                accept
            // ⌘F / Ctrl+F — focus the session search box (not Shift; that's terminal Find).
            } else if (event.modifiers.control && !event.modifiers.shift
                && (event.text == "f" || event.text == "F" || event.text == "\u{0006}")) {
                root.focus-session-search();
                accept
            } else {
                reject
            }
        }
    }

    VerticalLayout {
        spacing: root.compact ? 12px : 0px;

        // Header (title + tagline) — pinned to the top at its natural height so
        // it can't grab the stretch space and spread apart (seen on macOS); the
        // quick-connect card below takes all the remaining height (#dock). Hidden
        // in compact/sidebar mode.
        if !root.compact: VerticalLayout {
            padding: 8px;
            vertical-stretch: 0;
            alignment: start;
            spacing: 4px;
            Text {
                text: "meatshell";
                color: Theme.text-primary;
                font-size: 28px;
                font-weight: 700;
            }

            Text {
                text: @tr("meatshell — a lightweight Rust + Slint SSH client by 'lil meatball'");
                color: Theme.text-secondary;
                font-size: Theme.fs-md;
                wrap: no-wrap;
            }
        }

        // Quick Connect card — always fills the remaining height so the panel
        // doesn't jump when the first session is added (the empty placeholder
        // stretches to fill just like the session list does) (#214).
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-panel;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: root.compact ? 8px : 12px;
                spacing: 12px;

                // Compact: title→button gap is slightly tighter than the 12px below the
                // button so it matches optically (title row is taller than the glyphs).
                VerticalLayout {
                    spacing: root.compact ? 8px : 0px;
                    vertical-stretch: 0;

                    Rectangle {
                        height: header-row.preferred-height;
                        TouchArea {
                            enabled: root.compact;
                            mouse-cursor: move;
                            moved => {
                                root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                            }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.up) { root.dock-drag-end(); }
                            }
                        }

                        header-row := HorizontalLayout {
                            spacing: 11px;
                            if root.compact && root.dock-edge != "left": CollapseButton {
                                glyph: root.dock-edge == "right" ? "\u{E5CC}"
                                    : root.dock-edge == "top" ? "\u{E5CE}"
                                    : "\u{E5CF}";
                                clicked => { root.collapse(); }
                            }
                            Text {
                                text: @tr("Quick connect");
                                color: Theme.text-primary;
                                font-size: Theme.fs-lg;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            if root.compact && root.dock-edge == "left": CollapseButton {
                                glyph: "\u{E314}";
                                clicked => { root.collapse(); }
                            }

                            if !root.compact: BorderedLineInput {
                                min-width: 140px;
                                max-width: 260px;
                                horizontal-stretch: 1;
                                height: 30px;
                                pad-x: 8px;
                                font-size: Theme.fs-sm;
                                leading-icon: "\u{E8B6}";
                                text <=> root.session-search;
                                placeholder: @tr("Search sessions");
                                edited => { root.search-sessions(self.text); }
                                accepted(text) => { root.new-session(text, true); }
                                focus-request: root.search-focus-seq;
                            }

                            if !root.compact: PrimaryButton {
                                text: @tr("+ New session");
                                clicked => { root.new-session("", false); }
                            }
                        }
                    }

                    if root.compact: HorizontalLayout {
                        spacing: root.compact ? 6px : 0px;
                        BorderedLineInput {
                            horizontal-stretch: 1;
                            height: 30px;
                            pad-x: 8px;
                            font-size: Theme.fs-sm;
                            leading-icon: "\u{E8B6}";
                            text <=> root.session-search;
                            placeholder: @tr("Search sessions");
                            edited => { root.search-sessions(self.text); }
                            accepted(text) => { root.new-session(text, true); }
                            focus-request: root.search-focus-seq;
                        }

                        PrimaryButton {
                            text: @tr("+ New session");
                            clicked => { root.new-session("", false); }
                        }
                    }
                }

                if sessions.length == 0: Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-root;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: root.session-search != "" ? @tr("No match") : @tr("No sessions yet");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-md;
                            horizontal-alignment: center;
                        }

                        if root.session-search == "": Text {
                            text: @tr("Use 'New session' (top-right) to add your first server");
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                        }
                    }
                }

                if sessions.length > 0: VerticalLayout {
                    spacing: root.compact ? 0 : 2px;
                    vertical-stretch: 1;

                    if !root.compact: SessionListHeader {
                        col-name <=> root.session-col-name;
                        col-host <=> root.session-col-host;
                        persist-cols => {
                            root.persist-session-cols(root.session-col-name, root.session-col-host);
                        }
                    }

                    sess-scroll := ScrollView {
                        vertical-stretch: 1;
                        // Compact sidebar: grow the viewport with the longest
                        // session/group label so names scroll instead of eliding.
                        viewport-width: root.compact
                            ? max(self.visible-width, sess-list.preferred-width)
                            : self.visible-width;
                        viewport-height: max(self.visible-height, sess-list.preferred-height);
                        sess-list := VerticalLayout {
                            width: sess-scroll.viewport-width;
                            spacing: 2px;
                            for session[i] in sessions: VerticalLayout {
                                spacing: 2px;
                                vertical-stretch: 0;
                                width: 100%;
                                // Group header on the first row of each group (#41).
                                // Click anywhere on it to collapse / expand the group.
                                if session.group-header != "": Rectangle {
                                    width: 100%;
                                    border-radius: Theme.radius-sm;
                                    background: root.welcome-drag-kind == "group" && root.welcome-drag-from == session.group
                                        ? Theme.bg-active
                                        : (root.welcome-drag-kind != "" && root.welcome-drop-target == session.group
                                            ? Theme.accent.with-alpha(0.12)
                                            : (grp-ta.has-hover ? Theme.bg-hover : transparent));
                                    clip: true;
                                    animate background { duration: 120ms; }

                                    property <bool> grp-nesting: true;
                                    // new session + rename + delete + sibling + child
                                    // + expand/collapse all + expand/collapse children
                                    property <int> grp-menu-count: grp-nesting ? 9 : 0;
                                    // Right-click popup anchor.
                                    property <length> gmx;
                                    property <length> gmy;
                                    property <bool> grp-pressing: false;
                                    property <bool> grp-moved: false;
                                    property <length> grp-grab-x;
                                    property <length> grp-grab-y;

                                    grp-row := HorizontalLayout {
                                        width: 100%;
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                        padding-left: SessionColLayout.pad-left + session.group-depth * 16px;
                                        padding-right: SessionColLayout.pad-right;
                                        spacing: 4px;
                                        // Slint 1.17+: stretch + trailing spacer (compact) keeps
                                        // the label left. Avoid cross-axis center — it clips glyphs.
                                        alignment: stretch;

                                        // Collapse chevron — shown for every group, empty
                                        // folders included, so they line up and can be
                                        // toggled (an empty group just expands to nothing).
                                        Text {
                                            text: session.collapsed ? "\u{E5CC}" : "\u{E5CF}";
                                            font-family: "Material Icons";
                                            color: Theme.text-muted;
                                            font-size: Theme.fs-md;
                                            vertical-alignment: center;
                                        }

                                        Rectangle {
                                            width: SessionColLayout.icon-w;
                                            height: SessionColLayout.icon-w;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 3px;
                                            background: Theme.bg-elevated;
                                            Text {
                                                text: "\u{E2C7}";   // folder glyph
                                                font-family: "Material Icons";
                                                color: Theme.text-secondary;
                                                font-size: Theme.fs-sm;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Text {
                                            text: session.group-label;
                                            color: Theme.text-primary;
                                            font-size: root.compact ? Theme.fs-sm : Theme.fs-md;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            // Compact: keep natural width so the label stays
                                            // left of any leftover row space (see spacer below).
                                            horizontal-stretch: root.compact ? 0 : 1;
                                            horizontal-alignment: left;
                                            wrap: no-wrap;
                                            overflow: root.compact ? clip : elide;
                                        }
                                        if root.compact: Rectangle { horizontal-stretch: 1; }
                                    }

                                    height: grp-row.preferred-height;

                                    grp-ta := TouchArea {
                                        mouse-cursor: root.welcome-drag-kind == "group" && root.welcome-drag-from == session.group
                                            ? grabbing : (grp-pressing ? grab : pointer);
                                        // Left-click toggles collapse (any group, incl.
                                        // empty); right-click opens the group menu;
                                        // press-move re-parents the group.
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                                grp-pressing = true;
                                                grp-moved = false;
                                                grp-grab-x = self.mouse-x;
                                                grp-grab-y = self.mouse-y;
                                            } else if (grp-menu-count > 0 && e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                                gmx = self.mouse-x;
                                                gmy = self.mouse-y;
                                                grp-menu.show();
                                            } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                                                if (grp-pressing && grp-moved && root.welcome-drag-kind == "group") {
                                                    root.drop-welcome-group(root.welcome-drag-from, root.welcome-drop-target);
                                                } else if (grp-pressing && !grp-moved) {
                                                    root.toggle-group(session.group);
                                                }
                                                // Always clear drag chrome on release (also covers cancel /
                                                // no-op drops). Do this after arming the drop call so
                                                // args are captured; AppWindow clears again before Rust
                                                // mutates the list.
                                                root.welcome-drag-kind = "";
                                                root.welcome-drag-from = "";
                                                root.welcome-drop-target = "";
                                                grp-pressing = false;
                                                grp-moved = false;
                                            }
                                        }
                                        moved => {
                                            if (grp-pressing) {
                                                if (!grp-moved
                                                    && (abs(self.mouse-x - grp-grab-x) > 5px
                                                        || abs(self.mouse-y - grp-grab-y) > 5px)) {
                                                    grp-moved = true;
                                                    root.welcome-drag-kind = "group";
                                                    root.welcome-drag-from = session.group;
                                                    root.welcome-drop-target = session.group;
                                                }
                                                if (grp-moved) {
                                                    root.welcome-drag-at(
                                                        sess-list.absolute-position.y,
                                                        self.absolute-position.y + self.mouse-y,
                                                        root.welcome-drag-kind,
                                                        root.welcome-drag-from,
                                                    );
                                                }
                                            }
                                        }
                                    }

                                    grp-menu := PopupWindow {
                                        x: gmx;
                                        y: gmy;
                                        // Hug content so long labels fit without leftover empty width.
                                        width: grp-menu-vl.preferred-width;
                                        height: grp-menu-vl.preferred-height;
                                        Rectangle {
                                            background: Theme.popup-bg;
                                            border-radius: Theme.radius-sm;
                                            border-width: 1px;
                                            border-color: Theme.border-strong;
                                            drop-shadow-blur: 10px;
                                            drop-shadow-color: #00000050;
                                            grp-menu-vl := VerticalLayout {
                                                padding: 4px;
                                                spacing: 1px;
                                                // New session in this group.
                                                if grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: ns-ta.has-hover ? Theme.bg-hover : transparent;
                                                    ns-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.new-session-in-group(session.group); }
                                                    }

                                                    HorizontalLayout {
                                                        alignment: start;
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E145}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("New session");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                // Edit (rename) group.
                                                if grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: eg-ta.has-hover ? Theme.bg-hover : transparent;
                                                    eg-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.edit-group(session.group, session.group-label); }
                                                    }

                                                    HorizontalLayout {
                                                        alignment: start;
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E3C9}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("Rename group");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                // New child group (nested under this folder).
                                                if grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: cg-ta.has-hover ? Theme.bg-hover : transparent;
                                                    cg-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.new-child-group(session.group); }
                                                    }

                                                    HorizontalLayout {
                                                        alignment: start;
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E2CC}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("New child group");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                // New sibling group (same parent path).
                                                if grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: sg-ta.has-hover ? Theme.bg-hover : transparent;
                                                    sg-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.new-sibling-group(session.group); }
                                                    }

                                                    HorizontalLayout {
                                                        alignment: start;
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E2CC}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("New sibling group");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                if grp-nesting: Rectangle {
                                                    height: 1px;
                                                    background: Theme.border-subtle;
                                                }
                                                // Expand every Quick Connect folder.
                                                if grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: eag-ta.has-hover ? Theme.bg-hover : transparent;
                                                    eag-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.expand-all-groups(); }
                                                    }

                                                    HorizontalLayout {
                                                        alignment: start;
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E5D7}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("Expand all groups");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                // Collapse every Quick Connect folder.
                                                if grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: cag-ta.has-hover ? Theme.bg-hover : transparent;
                                                    cag-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.collapse-all-groups(); }
                                                    }

                                                    HorizontalLayout {
                                                        alignment: start;
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E5D6}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("Collapse all groups");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                // Expand this folder and all nested children.
                                                if grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: egc-ta.has-hover ? Theme.bg-hover : transparent;
                                                    egc-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.expand-group-children(session.group); }
                                                    }

                                                    HorizontalLayout {
                                                        alignment: start;
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E313}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("Expand all children");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                // Collapse nested children; keep this folder open.
                                                if grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: cgc-ta.has-hover ? Theme.bg-hover : transparent;
                                                    cgc-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.collapse-group-children(session.group); }
                                                    }

                                                    HorizontalLayout {
                                                        alignment: start;
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E316}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("Collapse all children");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                if grp-nesting: Rectangle {
                                                    height: 1px;
                                                    background: Theme.border-subtle;
                                                }
                                                // Delete group — cascades to child groups and sessions.
                                                if grp-nesting: Rectangle {
                                                    height: 28px;
                                                    border-radius: Theme.radius-sm;
                                                    background: dg-ta.has-hover ? #cc333320 : transparent;
                                                    dg-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.delete-group(session.group); }
                                                    }

                                                    HorizontalLayout {
                                                        alignment: start;
                                                        padding-left: 10px;
                                                        padding-right: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E872}";
                                                            font-family: "Material Icons";
                                                            color: #cc3333;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("Delete group");
                                                            color: #cc3333;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                if session.id != "" && session.id != "__group__" && !session.collapsed: SessionRow {
                                    width: 100%;
                                    session: session;
                                    compact: root.compact;
                                    single-click-connect: root.single-click-connect;
                                    col-name-width: root.session-col-name;
                                    col-host-width: root.session-col-host;
                                    is-drag-source: root.welcome-drag-kind == "session" && root.welcome-drag-from == session.id;
                                    is-drop-highlight: root.welcome-drag-kind != ""
                                        && root.welcome-drop-target == session.group
                                        && session.group == "";
                                    connect => { root.connect-session(session.id); }
                                    edit => { root.edit-session(session.id); }
                                    duplicate => { root.duplicate-session(session.id); }
                                    remove => { root.remove-session(session.id, session.name); }
                                    begin-drag => {
                                        root.welcome-drag-kind = "session";
                                        root.welcome-drag-from = session.id;
                                        root.welcome-drop-target = session.group;
                                    }
                                    update-drag(pointer-y) => {
                                        root.welcome-drag-at(
                                            sess-list.absolute-position.y,
                                            pointer-y,
                                            root.welcome-drag-kind,
                                            root.welcome-drag-from,
                                        );
                                    }
                                    finish-drag(did-move) => {
                                        if (did-move && root.welcome-drag-kind == "session") {
                                            root.drop-welcome-session(root.welcome-drag-from, root.welcome-drop-target);
                                        }
                                        // Clear even when the drop rebuilds rows mid-handler.
                                        root.welcome-drag-kind = "";
                                        root.welcome-drag-from = "";
                                        root.welcome-drop-target = "";
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
