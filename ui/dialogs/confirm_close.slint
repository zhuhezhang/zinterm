import { Theme } from "../shared/theme.slint";
import { PrimaryButton, GhostButton } from "../shared/widgets.slint";

export component ConfirmCloseDialog inherits Rectangle {
    in-out property <bool> confirm-close-open: false;
    callback confirm-close-yes();

    // --- Confirm-before-close dialog (#88) --------------------------------
    if root.confirm-close-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000088;
        TouchArea {
            clicked => { root.confirm-close-open = false; }
        }
        // Grab the keyboard so the terminal beneath stops receiving input, and
        // make the dialog operable without the mouse: Enter/Space close, Esc
        // cancels (so X → Space closes, X → Esc backs out) (#140-3).
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.confirm-close-open = false;
                    accept
                } else if (e.text == Key.Return || e.text == " ") {
                    root.confirm-close-yes();
                    accept
                } else {
                    accept   // modal: swallow everything else
                }
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 300px;
            height: 110px;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea { }

            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: @tr("Close ZinTerm?");
                    color: Theme.text-primary;
                    font-size: Theme.fs-lg;
                    font-weight: 700;
                }

                Text {
                    text: @tr("There are active sessions. Closing will disconnect them.");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }

                Rectangle {
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GhostButton {
                        text: @tr("Cancel");
                        clicked => { root.confirm-close-open = false; }
                    }

                    PrimaryButton {
                        text: @tr("Close");
                        clicked => { root.confirm-close-yes(); }
                    }
                }
            }
        }
    }
}
