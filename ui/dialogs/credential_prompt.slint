import { Theme } from "../shared/theme.slint";
import {
    PrimaryButton,
    GhostButton,
    TooltipArea,
    BorderedTextArea,
    LabeledInput,
} from "../shared/widgets.slint";

export component CredentialPrompt inherits Rectangle {
    callback cred-accept();
    in-out property <string> cred-auth: "password";
    in-out property <string> cred-host;
    in-out property <string> cred-key-inline;
    in-out property <string> cred-password;
    callback cred-pick-key();
    in-out property <bool> cred-prompt-open: false;
    callback cred-reject();
    in-out property <string> cred-user;
    in-out property <int> terminal-focus-seq: 0;

    if root.cred-prompt-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000aa;
        TouchArea {
            clicked => { root.cred-reject(); }
        }

        cred-wrap := Rectangle {
            width: root.cred-auth == "key" ? 420px : 300px;
            height: cred-card.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.popup-bg;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;

            // Match label column width across visible fields (locale-aware via @tr).
            property <length> cred-label-width: max(cred-lu.preferred-width,
                max(cred-lp.preferred-width, max(cred-lk.preferred-width, cred-lpp.preferred-width)));
            // Enter→Connect then hand focus back to the active terminal.
            public function cred-connect-and-focus-term() {
                root.cred-accept();
                root.terminal-focus-seq += 1;
            }
            Rectangle {
                x: -10000px;
                y: -10000px;
                width: 0px;
                height: 0px;
                clip: true;
                cred-lu := Text {
                    text: @tr("Username");
                    font-size: Theme.fs-sm;
                }

                cred-lp := Text {
                    text: @tr("Password");
                    font-size: Theme.fs-sm;
                }

                cred-lk := Text {
                    text: @tr("Private key");
                    font-size: Theme.fs-sm;
                }

                cred-lpp := Text {
                    text: @tr("Key passphrase");
                    font-size: Theme.fs-sm;
                }
            }

            TouchArea { }   // swallow clicks inside the card
            cred-card := VerticalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: @tr("Login");
                    color: Theme.text-primary;
                    font-size: Theme.fs-xl;
                    font-weight: 600;
                }

                Text {
                    text: root.cred-host;
                    color: Theme.text-secondary;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-sm;
                }

                // Username — always shown (prefilled when known).
                cred-user-input := LabeledInput {
                    label: @tr("Username");
                    label-width: cred-wrap.cred-label-width;
                    gap: 8px;
                    value <=> root.cred-user;
                    auto-focus: root.cred-user == "" || (root.cred-auth != "key" && root.cred-password != "");
                    accepted => {
                        if (root.cred-user == "") {
                            // Current field empty → ignore Enter.
                        } else if (root.cred-auth == "key" && root.cred-key-inline == "") {
                            // Need a key before connecting; passphrase field is next.
                            cred-secret-input.focus-input();
                        } else if (root.cred-auth != "key" && root.cred-password == "") {
                            cred-secret-input.focus-input();
                        } else {
                            cred-wrap.cred-connect-and-focus-term();
                        }
                    }
                    canceled => { root.cred-reject(); }   // Esc cancels (#140-3)
                }

                // Key auth: path / pasted PEM (same unified field as session dialog).
                if root.cred-auth == "key": HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: cred-wrap.cred-label-width;
                        height: cred-key-label.preferred-height;
                        y: 8px;
                        cred-key-label := Text {
                            width: 100%;
                            text: @tr("Private key");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: right;
                        }

                        TooltipArea {
                            width: parent.width;
                            height: parent.height;
                            tooltip-text: @tr("Enter a key file path or paste the private key. Pasted keys are encrypted before saving");
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;
                        BorderedTextArea {
                            horizontal-stretch: 1;
                            area-height: 96px;
                            idle-border: Theme.border-strong;
                            area-background: Theme.bg-elevated;
                            text <=> root.cred-key-inline;
                            font-family: Theme.font-mono;
                            font-size: Theme.fs-sm;
                            placeholder: @tr("/path/to/private_key_file or \nprivate_key_content") + "(-----BEGIN OPENSSH PRIVATE KEY...)";
                        }

                        Rectangle {
                            width: 64px;
                            height: 32px;
                            y: 0px;
                            border-radius: Theme.radius-sm;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            background: cred-browse-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                            Text {
                                text: @tr("Browse…");
                                color: Theme.text-primary;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            cred-browse-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.cred-pick-key(); }
                            }
                        }
                    }
                }

                // Login password (password auth) or key passphrase (key auth).
                cred-secret-input := LabeledInput {
                    label: root.cred-auth == "key" ? @tr("Key passphrase") : @tr("Password");
                    label-width: cred-wrap.cred-label-width;
                    gap: 8px;
                    password: true;
                    placeholder: root.cred-auth == "key" ? @tr("Leave blank if the key isn't encrypted") : "";
                    value <=> root.cred-password;
                    auto-focus: root.cred-user != "" && root.cred-password == "" && (root.cred-auth != "key" || root.cred-key-inline != "");
                    accepted => {
                        if (root.cred-auth != "key" && root.cred-password == "") {
                            // Password required — ignore empty Enter.
                        } else if (root.cred-user == "") {
                            cred-user-input.focus-input();
                        } else if (root.cred-auth == "key" && root.cred-key-inline == "") {
                            // Need a key before connecting.
                        } else {
                            // Key passphrase may be blank (unencrypted key).
                            cred-wrap.cred-connect-and-focus-term();
                        }
                    }
                    canceled => { root.cred-reject(); }   // Esc cancels (#140-3)
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GhostButton {
                        text: @tr("Cancel");
                        clicked => { root.cred-reject(); }
                    }

                    PrimaryButton {
                        text: @tr("Connect");
                        clicked => { cred-wrap.cred-connect-and-focus-term(); }
                    }
                }
            }
        }
    }
}
