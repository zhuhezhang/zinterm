import { Theme } from "../theme.slint";
import { BorderedLineInput } from "../widgets.slint";
import { Button } from "std-widgets.slint";

export component QuickCmdGroupDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    in-out property <string> qcg-name;
    in-out property <bool> qcg-open: false;           // group name dialog open;
    in-out property <string> qcg-orig;
    callback submit-quick-group(string /* orig */, string /* name */);

    // --- Quick-command group name dialog (#55): new / rename --------------
    if root.qcg-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000080;
        TouchArea {
            clicked => { root.qcg-open = false; }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 340px;
            height: 140px;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea { }   // swallow inside clicks

            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: root.qcg-orig == ""
                        ? (@tr("New group"))
                        : (@tr("Rename group"));
                    color: Theme.text-primary;
                    font-size: Theme.fs-lg;
                    font-weight: 700;
                }

                Text {
                    text: @tr("Group name");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }

                qcg-input := BorderedLineInput {
                    text <=> root.qcg-name;
                    font-family: Theme.ui-font-family;
                    auto-focus: true;
                    accepted => {
                        if (root.qcg-name != "") {
                            root.submit-quick-group(root.qcg-orig, root.qcg-name);
                            root.qcg-open = false;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.qcg-open = false; }
                    }

                    Button {
                        text: @tr("OK");
                        primary: true;
                        enabled: root.qcg-name != "";
                        clicked => {
                            root.submit-quick-group(root.qcg-orig, root.qcg-name);
                            root.qcg-open = false;
                        }
                    }
                }
            }
        }
    }
}
