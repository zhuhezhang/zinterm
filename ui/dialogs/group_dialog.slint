import { Theme } from "../theme.slint";
import { BorderedLineInput } from "../widgets.slint";
import { Button } from "std-widgets.slint";

export component GroupDialog inherits Rectangle {
    in-out property <string> group-dialog-error;
    in-out property <string> group-dialog-mode;
    in-out property <string> group-dialog-name;
    in-out property <bool> group-dialog-open: false;
    in-out property <string> group-dialog-orig;
    in-out property <string> group-dialog-parent;
    callback submit-group(string /* orig */, string /* segment */, string /* parent */) -> string;

    // --- Group create / rename dialog (#41) -------------------------------
    if root.group-dialog-open: Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000080;
        TouchArea {
            clicked => { root.group-dialog-open = false; }
        }
        // Grab keyboard while open; Esc closes (#140-3).
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.group-dialog-open = false;
                    accept
                } else {
                    accept
                }
            }
            key-released(e) => { accept }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 320px;
            height: 170px;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea { }   // swallow inside clicks

            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                Text {
                    text: root.group-dialog-mode == "rename"
                        ? (@tr("Rename group"))
                        : root.group-dialog-mode == "child"
                        ? (@tr("New child group"))
                        : (@tr("New sibling group"));
                    color: Theme.text-primary;
                    font-size: Theme.fs-lg;
                    font-weight: 700;
                }

                Text {
                    text: @tr("Group name");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                }

                ge-input := BorderedLineInput {
                    text <=> root.group-dialog-name;
                    font-family: Theme.ui-font-family; // CJK-capable (#54)
                    auto-focus: true;
                    edited => { root.group-dialog-error = ""; }
                    // Enter confirms when non-empty.
                    accepted => {
                        if (root.group-dialog-name != "") {
                            root.group-dialog-error = root.submit-group(
                                root.group-dialog-orig,
                                root.group-dialog-name,
                                root.group-dialog-parent,
                            );
                            if (root.group-dialog-error == "") {
                                root.group-dialog-open = false;
                            }
                        }
                    }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) {
                            root.group-dialog-open = false;
                            accept
                        } else {
                            reject
                        }
                    }
                }

                Text {
                    text: root.group-dialog-error;
                    color: Theme.danger;
                    font-size: Theme.fs-xs;
                    height: 20px;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: @tr("Cancel");
                        clicked => { root.group-dialog-open = false; }
                    }

                    Button {
                        text: @tr("OK");
                        primary: true;
                        enabled: root.group-dialog-name != "";
                        clicked => {
                            root.group-dialog-error = root.submit-group(
                                root.group-dialog-orig,
                                root.group-dialog-name,
                                root.group-dialog-parent,
                            );
                            if (root.group-dialog-error == "") {
                                root.group-dialog-open = false;
                            }
                        }
                    }
                }
            }
        }
    }
}
