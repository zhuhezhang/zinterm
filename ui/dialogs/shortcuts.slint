import { Theme } from "../shared/theme.slint";
import { ScrollView } from "std-widgets.slint";

component ShortcutRow inherits Rectangle {
    in property <string> keys;
    in property <string> desc;
    height: 28px * Theme.ui-scale;
    HorizontalLayout {
        spacing: 10px * Theme.ui-scale;
        Rectangle {
            width: 116px * Theme.ui-scale;
            chip := Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: min(parent.width, kt.preferred-width + 16px * Theme.ui-scale);
                height: 20px * Theme.ui-scale;
                background: Theme.bg-root;
                border-radius: Theme.radius-sm;
                border-width: 1px * Theme.ui-scale;
                border-color: Theme.border-strong;
                kt := Text {
                    text: root.keys;
                    color: Theme.text-primary;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-xs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        Text {
            text: root.desc;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

export component ShortcutsDialog inherits Rectangle {
    in-out property <bool> is-mac;
    in-out property <bool> shortcuts-open: false; // centered keyboard-shortcuts dialog (#103);

    // --- Keyboard shortcuts dialog (#103) ---------------------------------
    Rectangle {
        width: parent.width;
        height: parent.height;
        visible: root.shortcuts-open;
        background: #00000080;
        TouchArea {
            clicked => { root.shortcuts-open = false; }
        }
        // Esc closes when the dialog is shown (#140-3).
        if root.shortcuts-open: FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.shortcuts-open = false;
                    accept
                } else {
                    accept
                }
            }
            key-released(e) => { accept }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 424px * Theme.ui-scale;
            height: 432px * Theme.ui-scale;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px * Theme.ui-scale;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px * Theme.ui-scale;
            drop-shadow-color: #000000a0;
            TouchArea { }

            VerticalLayout {
                padding: 8px * Theme.ui-scale;
                spacing: 5px * Theme.ui-scale;

                HorizontalLayout {
                    Text {
                        text: @tr("Keyboard shortcuts");
                        color: Theme.text-primary;
                        font-size: Theme.fs-lg;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 22px * Theme.ui-scale;
                        height: 22px * Theme.ui-scale;
                        border-radius: Theme.radius-sm;
                        background: sc-close.has-hover ? Theme.bg-hover : transparent;
                        sc-close := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.shortcuts-open = false; }
                        }

                        Text {
                            text: "\u{E5CD}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Scrollable so the list never overflows the fixed-height card (#140).
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 5px * Theme.ui-scale;

                        Text {
                            text: @tr("Tabs");
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌃Tab" : "Ctrl+Tab";
                            desc: @tr("Next tab");
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌃⇧Tab" : "Ctrl+Shift+Tab";
                            desc: @tr("Previous tab");
                        }

                        Text {
                            text: @tr("Session search box");
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘F" : "Ctrl+F";
                            desc: @tr("Focus session search box");
                        }

                        ShortcutRow {
                            keys: "Enter";
                            desc: @tr("New session");
                        }

                        Rectangle {
                            height: 6px * Theme.ui-scale;
                        }

                        Text {
                            text: @tr("Terminal");
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘-" : "Ctrl+-";
                            desc: @tr("Zoom out terminal font");
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘=" : "Ctrl+=";
                            desc: @tr("Zoom in terminal font");
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘C" : "Ctrl+Shift+C";
                            desc: @tr("Copy selection");
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘V" : "Ctrl+V";
                            desc: @tr("Paste");
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘⇧R" : "Ctrl+Shift+R";
                            desc: @tr("Jump to command history search");
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘⇧F" : "Ctrl+Shift+F";
                            desc: @tr("Open find bar");
                        }

                        ShortcutRow {
                            keys: @tr("Drag");
                            desc: @tr("Select text");
                        }

                        ShortcutRow {
                            keys: @tr("Wheel / Scrollbar");
                            desc: @tr("Scroll history");
                        }

                        Rectangle {
                            height: 6px * Theme.ui-scale;
                        }

                        Text {
                            text: @tr("Find in terminal input");
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                        }

                        ShortcutRow {
                            keys: "Enter";
                            desc: @tr("Next match");
                        }

                        ShortcutRow {
                            keys: "Shift+Enter";
                            desc: @tr("Previous match");
                        }

                        ShortcutRow {
                            keys: "Esc";
                            desc: @tr("Close find bar");
                        }

                        Rectangle {
                            height: 6px * Theme.ui-scale;
                        }

                        Text {
                            text: @tr("Command box");
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘R" : "Ctrl+R";
                            desc: @tr("Search command history");
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘S" : "Ctrl+S";
                            desc: @tr("Move to start of line");
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘E" : "Ctrl+E";
                            desc: @tr("Move to end of line");
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘K" : "Ctrl+K";
                            desc: @tr("Delete to end of line");
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘U" : "Ctrl+U";
                            desc: @tr("Delete to start of line");
                        }

                        ShortcutRow {
                            keys: "Esc";
                            desc: @tr("Close history / focus terminal");
                        }

                        Rectangle {
                            height: 2px * Theme.ui-scale;
                        }
                    }
                }
            }
        }
    }
}
