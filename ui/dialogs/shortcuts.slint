import { Theme } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";

component ShortcutRow inherits Rectangle {
    in property <string> keys;
    in property <string> desc;
    height: 28px;
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 116px;
            chip := Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: min(parent.width, kt.preferred-width + 16px);
                height: 20px;
                background: Theme.bg-root;
                border-radius: Theme.radius-sm;
                border-width: 1px;
                border-color: Theme.border-strong;
                kt := Text {
                    text: root.keys;
                    color: Theme.text-primary;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-xs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        Text {
            text: root.desc;
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

export component ShortcutsDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    in-out property <bool> is-mac <=> Theme.is-mac;
    in-out property <bool> lang-en: false;  // effective UI language (false = 中文);
    in-out property <bool> shortcuts-open: false; // centered keyboard-shortcuts dialog (#103);

    // --- Keyboard shortcuts dialog (#103) ---------------------------------
    Rectangle {
        width: parent.width;
        height: parent.height;
        visible: root.shortcuts-open;
        background: #00000080;
        TouchArea {
            clicked => { root.shortcuts-open = false; }
        }
        // Esc closes when the dialog is shown (#140-3).
        if root.shortcuts-open: FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.shortcuts-open = false;
                    accept
                } else {
                    accept
                }
            }
            key-released(e) => { accept }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 424px;
            height: 432px;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea { }

            VerticalLayout {
                padding: 8px;
                spacing: 5px;

                HorizontalLayout {
                    Text {
                        text: root.lang-en ? "Keyboard shortcuts" : "快捷键";
                        color: Theme.text-primary;
                        font-size: Theme.fs-lg;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: Theme.radius-sm;
                        background: sc-close.has-hover ? Theme.bg-hover : transparent;
                        sc-close := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.shortcuts-open = false; }
                        }

                        Text {
                            text: "\u{E5CD}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Scrollable so the list never overflows the fixed-height card (#140).
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 5px;

                        Text {
                            text: root.lang-en ? "Tabs" : "标签页";
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌃Tab" : "Ctrl+Tab";
                            desc: root.lang-en ? "Next tab" : "下一个标签页";
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌃⇧Tab" : "Ctrl+Shift+Tab";
                            desc: root.lang-en ? "Previous tab" : "上一个标签页";
                        }

                        Text {
                            text: root.lang-en ? "Session search box" : "会话搜索框";
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘F" : "Ctrl+F";
                            desc: root.lang-en ? "Focus session search box" : "聚焦会话搜索框";
                        }

                        ShortcutRow {
                            keys: "Enter";
                            desc: root.lang-en ? "New session" : "新建会话";
                        }

                        Rectangle {
                            height: 6px;
                        }

                        Text {
                            text: root.lang-en ? "Terminal" : "终端";
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘C" : "Ctrl+Shift+C";
                            desc: root.lang-en ? "Copy selection" : "复制选中内容";
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘V" : "Ctrl+V";
                            desc: root.lang-en ? "Paste" : "粘贴";
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘⇧R" : "Ctrl+Shift+R";
                            desc: root.lang-en ? "Jump to command history search" : "跳到命令历史搜索";
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘⇧F" : "Ctrl+Shift+F";
                            desc: root.lang-en ? "Open find bar" : "打开查找框";
                        }

                        ShortcutRow {
                            keys: root.lang-en ? "Drag" : "鼠标拖动";
                            desc: root.lang-en ? "Select text" : "选择文本";
                        }

                        ShortcutRow {
                            keys: root.lang-en ? "Wheel / Scrollbar" : "滚轮 / 滚动条";
                            desc: root.lang-en ? "Scroll history" : "滚动历史";
                        }

                        Rectangle {
                            height: 6px;
                        }

                        Text {
                            text: root.lang-en ? "Find in terminal input" : "终端内容查找输入框";
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                        }

                        ShortcutRow {
                            keys: "Enter";
                            desc: root.lang-en ? "Next match" : "下一个匹配";
                        }

                        ShortcutRow {
                            keys: "Shift+Enter";
                            desc: root.lang-en ? "Previous match" : "上一个匹配";
                        }

                        ShortcutRow {
                            keys: "Esc";
                            desc: root.lang-en ? "Close find bar" : "关闭查找框";
                        }

                        Rectangle {
                            height: 6px;
                        }

                        Text {
                            text: root.lang-en ? "Command box" : "命令输入框";
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘R" : "Ctrl+R";
                            desc: root.lang-en ? "Search history" : "搜索命令历史";
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘S" : "Ctrl+S";
                            desc: root.lang-en ? "Move to start of line" : "移到行首";
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘E" : "Ctrl+E";
                            desc: root.lang-en ? "Move to end of line" : "移到行尾";
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘K" : "Ctrl+K";
                            desc: root.lang-en ? "Delete to end of line" : "删除到行尾";
                        }

                        ShortcutRow {
                            keys: root.is-mac ? "⌘U" : "Ctrl+U";
                            desc: root.lang-en ? "Delete to start of line" : "删除到行首";
                        }

                        ShortcutRow {
                            keys: "Esc";
                            desc: root.lang-en ? "Close history / focus terminal" : "关闭历史（快捷）命令 / 聚焦终端";
                        }

                        Rectangle {
                            height: 2px;
                        }
                    }
                }
            }
        }
    }
}
