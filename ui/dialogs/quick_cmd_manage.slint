import { Theme } from "../theme.slint";
import { QuickCmd } from "../types/terminal.slint";
import { BorderedLineInput, BorderedTextArea } from "../widgets.slint";
import { ScrollView, Button } from "std-widgets.slint";

export component QuickCmdManageDialog inherits Rectangle {
    width: 100%;
    height: 100%;
    in-out property <string> active-tab-id: "welcome";
    callback add-quick-command(string /* name */, string /* command */, string /* group */);
    callback delete-quick-command(int /* index */);
    callback delete-quick-group(string /* name */);
    callback drop-quick-command(int /* from */, string /* target-group */, int /* before-orig */);
    callback drop-quick-group(string /* from */, string /* before-group */);
    callback duplicate-quick-command(int /* index */);
    callback edit-quick-command(int /* index */);
    in-out property <string> qcg-name;
    in-out property <bool> qcg-open: false;           // group name dialog open;
    in-out property <string> qcg-orig;
    in-out property <bool> qcm-cmd-dragging;
    in-out property <string> qcm-command;
    in-out property <length> qcm-dialog-height: 560px;
    in-out property <bool> qcm-dialog-resizing;
    in-out property <length> qcm-dialog-width: 560px;
    callback qcm-drag-at(length /* list-top-y */, length /* pointer-y */, int /* drag-from */, string /* drag-group-from */);
    in-out property <int> qcm-drag-from: -1;
    in-out property <string> qcm-drag-group-from;
    in-out property <int> qcm-drop-before: -1;
    in-out property <string> qcm-drop-before-group;
    in-out property <string> qcm-drop-group;
    in-out property <int> qcm-edit-index: -1;         // -1 = add, >=0 = edit that entry (#55);
    in-out property <string> qcm-group;
    in-out property <bool> qcm-grp-dragging;
    in property <[QuickCmd]> qcm-manage-commands;
    in-out property <string> qcm-name;
    in-out property <length> qcm-resize-base-height;
    in-out property <length> qcm-resize-base-width;
    in-out property <length> qcm-resize-grab-x;
    in-out property <length> qcm-resize-grab-y;
    in-out property <string> qcm-search: "";
    in-out property <bool> quick-cmd-manage-open: false;  // manage dialog;
    callback run-command(string /* tab-id */, string /* cmd */, bool /* to-all */);
    callback save-quick-command(int /* index */, string /* name */, string /* command */, string /* group */);
    callback search-qcm-commands(string /* query */);
    callback toggle-quick-group(string /* group */);

    // --- Quick-command manage dialog (#55) --------------------------------
    if root.quick-cmd-manage-open: Rectangle {
        width: root.width;
        height: root.height;
        background: #00000080;
        TouchArea {
            clicked => { root.quick-cmd-manage-open = false; }
        }
        // Grab keyboard while open; Esc closes (#140-3).
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.quick-cmd-manage-open = false;
                    accept
                } else {
                    accept
                }
            }
            key-released(e) => { accept }
        }

        qcm-card := Rectangle {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            width: min(root.qcm-dialog-width, root.width - 32px);
            height: min(root.qcm-dialog-height, root.height - 32px);
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea { }   // swallow backdrop clicks on the card body

            VerticalLayout {
                padding: 8px;
                spacing: 8px;
                HorizontalLayout {
                    Text {
                        text: @tr("Quick commands");
                        color: Theme.text-primary;
                        font-size: Theme.fs-lg;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: Theme.radius-sm;
                        background: qcm-close.has-hover ? Theme.bg-hover : transparent;
                        qcm-close := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.quick-cmd-manage-open = false; }
                        }

                        Text {
                            text: "\u{E5CD}";
                            font-family: "Material Icons";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-md;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Add / edit form: name + group (optional) + command.
                VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            width: cmd-label.width;
                            text: @tr("Name");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }

                        qcm-name-in := BorderedLineInput {
                            text <=> root.qcm-name;
                            placeholder: @tr("e.g. tail log");
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.quick-cmd-manage-open = false;
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: @tr("Group");
                            width: cmd-label.width;
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }

                        BorderedLineInput {
                            text <=> root.qcm-group;
                            placeholder: @tr("leave empty → default");
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.quick-cmd-manage-open = false;
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        cmd-label := Text {
                            text: @tr("Command");
                            color: Theme.text-secondary;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }

                        qcm-cmd-in := BorderedTextArea {
                            text <=> root.qcm-command;
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.quick-cmd-manage-open = false;
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }
                    }
                }

                // New (empty) group, cancel、save、edit command button.
                HorizontalLayout {
                    spacing: 7px;
                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    Button {
                        text: @tr("+ New group");
                        clicked => { root.qcg-orig = ""; root.qcg-name = ""; root.qcg-open = true; }
                    }

                    // Cancel only while editing an existing entry.
                    if root.qcm-edit-index >= 0: Button {
                        text: @tr("Cancel");
                        clicked => {
                            root.qcm-edit-index = -1;
                            root.qcm-name = "";
                            root.qcm-command = "";
                            root.qcm-group = "";
                        }
                    }

                    Button {
                        text: @tr("Execute");
                        enabled: root.qcm-command != "";
                        clicked => {
                            root.run-command(root.active-tab-id, root.qcm-command, false);
                        }
                    }

                    Button {
                        text: root.qcm-edit-index >= 0 ? @tr("Save and execute") : @tr("Add and execute");
                        enabled: root.qcm-name != "" && root.qcm-command != "";
                        clicked => {
                            if (root.qcm-edit-index >= 0) {
                                root.save-quick-command(root.qcm-edit-index, root.qcm-name, root.qcm-command, root.qcm-group);
                            } else {
                                root.add-quick-command(root.qcm-name, root.qcm-command, root.qcm-group);
                            }
                            root.run-command(root.active-tab-id, root.qcm-command, false);
                            root.qcm-edit-index = -1;
                            root.qcm-name = "";
                            root.qcm-command = "";
                            root.qcm-group = "";
                        }
                    }

                    Button {
                        text: root.qcm-edit-index >= 0 ? (@tr("Save"))
                            : (@tr("Add"));
                        primary: true;
                        enabled: root.qcm-name != "" && root.qcm-command != "";
                        clicked => {
                            if (root.qcm-edit-index >= 0) {
                                root.save-quick-command(root.qcm-edit-index, root.qcm-name, root.qcm-command, root.qcm-group);
                            } else {
                                root.add-quick-command(root.qcm-name, root.qcm-command, root.qcm-group);
                            }
                            root.qcm-edit-index = -1;
                            root.qcm-name = "";
                            root.qcm-command = "";
                            root.qcm-group = "";
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.border-subtle;
                }

                // Search + list — tighter gap than the dialog's 8px section spacing.
                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 2px;

                    Rectangle {
                        height: 30px;

                        qcm-search-in := BorderedLineInput {
                            height: root.height;
                            pad-x: 8px;
                            font-size: Theme.fs-sm;
                            leading-icon: "\u{E8B6}";
                            text <=> root.qcm-search;
                            placeholder: @tr("Search commands");
                            edited => { root.search-qcm-commands(self.text); }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) {
                                    root.quick-cmd-manage-open = false;
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }
                    }

                    // Existing commands list with delete buttons.
                    // ScrollView (not bare Flickable) so a scrollbar appears when the list overflows.
                    ScrollView {
                        vertical-stretch: 1;
                        viewport-width: self.visible-width;
                        viewport-height: max(self.visible-height, qcm-list.preferred-height);
                        qcm-list := VerticalLayout {
                            alignment: start;
                            spacing: 0px;
                            padding-top: root.qcm-manage-commands.length == 0 ? 6px : 0px;
                            if root.qcm-manage-commands.length == 0: Text {
                                text: root.qcm-search != "" ? @tr("No match") : @tr("No quick commands yet");
                                color: Theme.text-muted;
                                font-size: Theme.fs-xs;
                            }
                            for q in root.qcm-manage-commands: VerticalLayout {
                                alignment: start;
                                spacing: 0px;
                                property <length> row-h: (q.group-header != "" ? 32px : 0px)
                                    + (!q.collapsed && q.orig-index >= 0 ? 32px : 0px);
                                height: row-h > 0px ? row-h + 1px : 0px;
                                // Group header on the first row of each group (#55).
                                if q.group-header != "": Rectangle {
                                    height: 32px;
                                    property <length> gmx;
                                    property <length> gmy;
                                    property <bool> grp-moved: false;
                                    property <bool> grp-pressing: false;
                                    property <length> grp-grab-x: 0px;
                                    border-radius: Theme.radius-sm;
                                    background: root.qcm-drag-group-from == q.group ? Theme.bg-active
                                        : ((root.qcm-drag-from >= 0
                                        && root.qcm-drop-group == q.group
                                        && root.qcm-drop-before < 0)
                                        || (root.qcm-drag-group-from != ""
                                        && root.qcm-drop-before-group == q.group
                                        && root.qcm-drag-group-from != q.group)
                                        ? Theme.accent.with-alpha(0.12)
                                        : (grp-header-ta.has-hover || qgrp-menu.is-open ? Theme.bg-hover : transparent));

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 4px;
                                        Text {
                                            text: q.collapsed ? "\u{E5CC}" : "\u{E5CF}";
                                            font-family: "Material Icons";
                                            color: Theme.text-muted;
                                            font-size: Theme.fs-sm;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: "\u{E2C7}";
                                            font-family: "Material Icons";
                                            color: Theme.text-muted;
                                            font-size: Theme.fs-sm;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: q.group;
                                            color: Theme.text-muted;
                                            font-size: Theme.fs-sm;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            horizontal-alignment: left;
                                        }
                                    }

                                    grp-header-ta := TouchArea {
                                        width: root.width;
                                        height: root.height;
                                        mouse-cursor: q.group != "default"
                                            ? (root.qcm-grp-dragging && root.qcm-drag-group-from == q.group
                                            ? grabbing : grab)
                                            : pointer;
                                        pointer-event(e) => {
                                            if (e.kind == PointerEventKind.down
                                                && e.button == PointerEventButton.left) {
                                                grp-pressing = true;
                                                grp-moved = false;
                                                grp-grab-x = self.mouse-x;
                                                root.qcm-drag-from = -1;
                                                root.qcm-cmd-dragging = false;
                                            } else if (e.kind == PointerEventKind.down
                                                && e.button == PointerEventButton.right) {
                                                gmx = self.mouse-x;
                                                gmy = self.mouse-y;
                                                qgrp-menu.show();
                                            } else if (e.kind == PointerEventKind.up) {
                                                if (grp-pressing
                                                    && q.group != "default"
                                                    && root.qcm-grp-dragging
                                                    && grp-moved) {
                                                    root.drop-quick-group(
                                                        root.qcm-drag-group-from,
                                                        root.qcm-drop-before-group,
                                                    );
                                                    root.qcm-drag-group-from = "";
                                                    root.qcm-drop-before-group = "";
                                                } else if (grp-pressing && !grp-moved) {
                                                    root.toggle-quick-group(q.group);
                                                }
                                                grp-pressing = false;
                                                root.qcm-grp-dragging = false;
                                            }
                                        }
                                        moved => {
                                            if (grp-pressing && q.group != "default") {
                                                if (!grp-moved
                                                    && abs(self.mouse-x - grp-grab-x) > 5px) {
                                                    grp-moved = true;
                                                    root.qcm-drag-group-from = q.group;
                                                    root.qcm-drop-before-group = q.group;
                                                    root.qcm-grp-dragging = true;
                                                }
                                                if (root.qcm-grp-dragging) {
                                                    root.qcm-drag-at(
                                                        qcm-list.absolute-position.y,
                                                        self.absolute-position.y + self.mouse-y,
                                                        root.qcm-drag-from,
                                                        root.qcm-drag-group-from,
                                                    );
                                                }
                                            }
                                        }
                                    }

                                    qgrp-menu := PopupWindow {
                                        x: gmx;
                                        y: gmy;
                                        width: 150px;
                                        height: (q.orig-index == -1 ? 3 : 2) * 30px + 9px;
                                        Rectangle {
                                            background: Theme.popup-bg;
                                            border-radius: Theme.radius-sm;
                                            border-width: 1px;
                                            border-color: Theme.border-strong;
                                            drop-shadow-blur: 10px;
                                            drop-shadow-color: #00000050;
                                            VerticalLayout {
                                                padding: 4px;
                                                spacing: 1px;
                                                Rectangle {
                                                    height: 30px;
                                                    border-radius: Theme.radius-sm;
                                                    background: qeg-ta.has-hover ? Theme.bg-hover : transparent;
                                                    qeg-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.qcg-orig = q.group;
                                                            root.qcg-name = q.group;
                                                            root.qcg-open = true;
                                                        }
                                                    }

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E3C9}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("Rename group");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                    }
                                                }

                                                if q.orig-index == -1: Rectangle {
                                                    height: 30px;
                                                    border-radius: Theme.radius-sm;
                                                    background: qdg-ta.has-hover ? #cc333320 : transparent;
                                                    qdg-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.delete-quick-group(q.group); }
                                                    }

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E872}";
                                                            font-family: "Material Icons";
                                                            color: #cc3333;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("Delete group");
                                                            color: #cc3333;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                    }
                                                }
                                                Rectangle {
                                                    height: 30px;
                                                    border-radius: Theme.radius-sm;
                                                    background: qng-ta.has-hover ? Theme.bg-hover : transparent;
                                                    qng-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.qcg-orig = "";
                                                            root.qcg-name = "";
                                                            root.qcg-open = true;
                                                        }
                                                    }

                                                    HorizontalLayout {
                                                        padding-left: 10px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: "\u{E2CC}";
                                                            font-family: "Material Icons";
                                                            color: Theme.text-secondary;
                                                            font-size: Theme.fs-sm;
                                                            vertical-alignment: center;
                                                        }

                                                        Text {
                                                            text: @tr("New group");
                                                            color: Theme.text-primary;
                                                            font-size: Theme.fs-md;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Command row (skip the empty-group placeholder; hidden when collapsed).
                                if !q.collapsed && q.orig-index >= 0: Rectangle {
                                    height: 32px;
                                    property <bool> cmd-moved: false;
                                    property <bool> cmd-pressing: false;
                                    property <length> cmd-grab-x: 0px;
                                    border-radius: Theme.radius-sm;
                                    background: root.qcm-drag-from == q.orig-index ? Theme.bg-active
                                        : (root.qcm-drag-from >= 0
                                        && root.qcm-drop-before == q.orig-index
                                        && root.qcm-drag-from != q.orig-index
                                        ? Theme.accent.with-alpha(0.12)
                                        : (body-ta.has-hover || run-ta.has-hover || dup-ta.has-hover || del-ta.has-hover
                                        ? Theme.bg-hover : transparent));

                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 6px;
                                        spacing: 4px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            body-ta := TouchArea {
                                                width: root.width;
                                                height: root.height;
                                                mouse-cursor: root.qcm-drag-from == q.orig-index ? grabbing : grab;
                                                double-clicked => {
                                                    cmd-pressing = false;
                                                    cmd-moved = false;
                                                    root.qcm-cmd-dragging = false;
                                                    root.qcm-drag-from = -1;
                                                    root.edit-quick-command(q.orig-index);
                                                }
                                                pointer-event(e) => {
                                                    if (e.kind == PointerEventKind.down
                                                        && e.button == PointerEventButton.left) {
                                                        cmd-pressing = true;
                                                        cmd-moved = false;
                                                        cmd-grab-x = self.mouse-x;
                                                        root.qcm-drop-group = q.group;
                                                        root.qcm-drop-before = q.orig-index;
                                                        root.qcm-drag-group-from = "";
                                                    } else if (e.kind == PointerEventKind.up) {
                                                        if (cmd-pressing
                                                            && root.qcm-cmd-dragging
                                                            && cmd-moved) {
                                                            root.drop-quick-command(
                                                                root.qcm-drag-from,
                                                                root.qcm-drop-group,
                                                                root.qcm-drop-before,
                                                            );
                                                        }
                                                        cmd-pressing = false;
                                                        root.qcm-cmd-dragging = false;
                                                        root.qcm-drag-from = -1;
                                                        root.qcm-drop-before = -1;
                                                        root.qcm-drop-group = "";
                                                    }
                                                }
                                                moved => {
                                                    if (cmd-pressing) {
                                                        if (!cmd-moved
                                                            && abs(self.mouse-x - cmd-grab-x) > 5px) {
                                                            cmd-moved = true;
                                                            root.qcm-drag-from = q.orig-index;
                                                            root.qcm-cmd-dragging = true;
                                                            root.qcm-grp-dragging = false;
                                                        }
                                                        if (root.qcm-cmd-dragging) {
                                                            root.qcm-drag-at(
                                                                qcm-list.absolute-position.y,
                                                                self.absolute-position.y + self.mouse-y,
                                                                root.qcm-drag-from,
                                                                root.qcm-drag-group-from,
                                                            );
                                                        }
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                padding-left: 2px;
                                                Text {
                                                    text: q.name;
                                                    color: Theme.text-primary;
                                                    font-size: Theme.fs-sm;
                                                    overflow: elide;
                                                }

                                                Text {
                                                    text: q.summary;
                                                    color: Theme.text-muted;
                                                    font-size: Theme.fs-xs;
                                                    overflow: elide;
                                                    font-family: Theme.ui-font-family;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            width: 24px;
                                            height: 28px;
                                            y: (root.height - self.height) / 2;
                                            border-radius: Theme.radius-sm;
                                            background: run-ta.has-hover ? Theme.accent.with-alpha(0.25) : transparent;
                                            run-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.run-command(root.active-tab-id, q.command, false); }
                                            }

                                            Text {
                                                text: "\u{E037}";
                                                font-family: "Material Icons";
                                                color: Theme.accent;
                                                font-size: Theme.fs-md;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            width: 24px;
                                            height: 28px;
                                            y: (root.height - self.height) / 2;
                                            border-radius: Theme.radius-sm;
                                            background: dup-ta.has-hover ? Theme.bg-hover : transparent;
                                            dup-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.duplicate-quick-command(q.orig-index); }
                                            }

                                            Text {
                                                text: "\u{E14D}";
                                                font-family: "Material Icons";
                                                color: Theme.text-secondary;
                                                font-size: Theme.fs-sm;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            y: (root.height - self.height) / 2;
                                            border-radius: Theme.radius-sm;
                                            background: del-ta.has-hover ? Theme.danger.with-alpha(0.18) : transparent;
                                            del-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.delete-quick-command(q.orig-index); }
                                            }

                                            Text {
                                                text: "\u{E872}";
                                                font-family: "Material Icons";
                                                color: Theme.danger;
                                                font-size: Theme.fs-md;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                            // Drop at end of the list (append group to the end).
                            Rectangle {
                                height: 10px;
                                background: root.qcm-drag-group-from != "" && root.qcm-drop-before-group == ""
                                    ? Theme.accent.with-alpha(0.12) : transparent;
                                qcm-append-ta := TouchArea { }
                            }
                        }
                    }
                }
            }

            // Bottom-right resize grip. The chosen size is retained while the
            // application is running, and remains clamped to the main window.
            Rectangle {
                x: root.width - 18px;
                y: root.height - 18px;
                width: 18px;
                height: 18px;
                background: qcm-resize-ta.has-hover || root.qcm-dialog-resizing
                    ? Theme.bg-hover : transparent;
                Text {
                    text: "\u{E3C2}";
                    font-family: "Material Icons";
                    color: Theme.text-muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                qcm-resize-ta := TouchArea {
                    height: 23px;
                    mouse-cursor: nwse-resize;
                    width: 26px;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.qcm-dialog-resizing = true;
                            root.qcm-resize-base-width = root.qcm-dialog-width;
                            root.qcm-resize-base-height = root.qcm-dialog-height;
                            root.qcm-resize-grab-x = self.absolute-position.x + self.mouse-x;
                            root.qcm-resize-grab-y = self.absolute-position.y + self.mouse-y;
                        } else if (e.kind == PointerEventKind.up) {
                            root.qcm-dialog-resizing = false;
                        }
                    }
                    moved => {
                        if (root.qcm-dialog-resizing) {
                            root.qcm-dialog-width = clamp(
                                root.qcm-resize-base-width
                                + self.absolute-position.x + self.mouse-x - root.qcm-resize-grab-x,
                                460px, max(460px, root.width - 32px));
                            root.qcm-dialog-height = clamp(
                                root.qcm-resize-base-height
                                + self.absolute-position.y + self.mouse-y - root.qcm-resize-grab-y,
                                420px, max(420px, root.height - 32px));
                        }
                    }
                }
            }
        }
    }
}
