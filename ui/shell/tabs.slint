import { Theme } from "../shared/theme.slint";
import { IconButton, TooltipArea } from "../shared/widgets.slint";

export struct TabInfo {
    id: string,
    title: string,
    kind: string,   // "welcome" | "terminal"
    conn-kind: string, // "" | "ssh" | "serial" | "telnet" | "local"
    // Host / IP for ssh|telnet|local, serial port name for serial.
    endpoint: string,
    connected: bool,
    // 0 connecting / 1 connected / 2 disconnected (normal) / 3 failed
    conn-state: int,
    // "auto" | "del" | "bs" — Backspace byte mode for this tab's session.
    backspace-mode: string,
}

// --- SingleTab -------------------------------------------------------------
component SingleTab inherits Rectangle {
    in property <TabInfo> info;
    in property <bool> active;
    // True while THIS tab id is the one being reordered (may differ from the
    // TouchArea that still holds the pointer after in-place model swaps).
    in property <bool> drag-highlight;
    callback selected();
    callback closed();
    callback duplicated();
    // Drag-to-reorder (v0.5): move the grabbed tab by `dir` slots
    // (negative = left, positive = right). Passes the frozen grab-id so hops
    // stay correct after in-place row updates.
    callback reorder(string /* tab-id */, int /* dir */);
    callback drag-began(string /* tab-id */);
    callback drag-ended();
    // Right-click (v0.5): request a context menu at the given absolute position.
    callback context-requested(length /* abs-x */, length /* abs-y */);
    // Drag-to-split (v0.5): report the absolute cursor while dragging, and the
    // drop point on release. The parent maps these to pane drop-zones.
    callback drag-moved(length /* abs-x */, length /* abs-y */);
    callback drag-dropped(length /* abs-x */, length /* abs-y */);
    // Forward mouse-wheel / trackpad scroll so the parent can pan a horizontal strip.
    callback wheel(length /* delta */);

    // Where inside the tab the drag began, and whether a drag (vs a click) is in
    // progress. `dragging` suppresses the select-on-release.
    property <length> grab-offset;
    // Slot width frozen when the drag starts so hops stay stable if this
    // TouchArea's bound `info` (and thus width) changes mid-drag.
    property <length> hop-unit;
    // Tab id at press time — kept across in-place row swaps on this element.
    property <string> grab-id;
    property <bool> pressing;
    property <int> hops;
    out property <bool> dragging;

    height: 30px * Theme.ui-scale;
    // Uniform tab width: long titles elide, short titles leave blank space.
    property <length> tab-width: 160px * Theme.ui-scale;
    width: tab-width;
    preferred-width: tab-width;
    horizontal-stretch: 0;
    clip: true;

    // Fixed tab chrome — spacing must not shift with title length.
    property <length> tab-pad-left: 8px * Theme.ui-scale;
    property <length> tab-pad-right: 6px * Theme.ui-scale;
    property <length> tab-gap: 6px * Theme.ui-scale;
    property <length> tab-icon-size: 14px * Theme.ui-scale;
    property <length> tab-dot-size: 8px * Theme.ui-scale;
    property <length> tab-close-size: 20px * Theme.ui-scale;
    property <bool> show-close: info.kind != "welcome";
    property <string> conn-icon:
        info.kind == "welcome" ? "\u{E88A}"       // home
        : info.conn-kind == "serial" ? "\u{E1E0}" // usb
        : info.conn-kind == "telnet" ? "\u{E328}" // router
        : info.conn-kind == "local" ? "\u{E30A}"  // desktop_windows
        : "\u{E0DA}";                             // vpn_key (ssh)
    property <string> conn-label:
        info.conn-kind == "serial" ? @tr("Serial")
        : info.conn-kind == "telnet" ? "Telnet"
        : info.conn-kind == "local" ? @tr("Local")
        : "SSH";
    // e.g. "SSH 192.168.1.1 · 主机1" / "Serial COM3 · switch"
    // Local shells skip the tooltip — the tab title is already clear.
    property <string> tip-text:
        info.kind == "welcome" || info.conn-kind == "local" ? ""
        : info.endpoint == ""
            ? (conn-label + " · " + info.title)
            : (conn-label + " " + info.endpoint + " · " + info.title);
    property <length> icon-x: tab-pad-left;
    property <length> dot-x: icon-x + tab-icon-size + tab-gap;
    property <length> title-x: dot-x + tab-dot-size + tab-gap;
    property <length> title-w: max(
        0px,
        (show-close
            ? (root.width - tab-pad-right - tab-close-size - tab-gap)
            : (root.width - tab-pad-right))
            - title-x);
    border-radius: Theme.radius-sm;
    border-width: active ? 2px * Theme.ui-scale : 0px;
    border-color: active ? Theme.accent : transparent;
    background: drag-highlight ? Theme.bg-active
        : (active ? Theme.tab-active-bg
        : (touch.has-hover ? Theme.bg-hover : transparent));
    animate background { duration: 120ms; }

    // Declared FIRST so the icon / close button overlays are at a higher z-order
    // and receive their own click events. TooltipArea inherits TouchArea.
    touch := TooltipArea {
        mouse-cursor: pointer;
        tooltip-text: root.dragging ? "" : root.tip-text;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.grab-offset = self.mouse-x;
                root.hop-unit = root.width + 2px * Theme.ui-scale;
                root.grab-id = root.info.id;
                root.pressing = true;
                root.dragging = false;
            } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.context-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            } else if (e.kind == PointerEventKind.up) {
                if (root.pressing && !root.dragging) {
                    root.selected();
                } else if (root.pressing && root.dragging) {
                    root.drag-dropped(self.absolute-position.x + self.mouse-x,
                                      self.absolute-position.y + self.mouse-y);
                }
                if (root.dragging) {
                    root.drag-ended();
                }
                root.pressing = false;
                root.dragging = false;
                root.grab-id = "";
            }
        }
        moved => {
            if (root.pressing) {
                // A drag begins once the cursor drifts horizontally OR leaves the
                // tab vertically (so a straight-down drag to split also counts).
                if (!root.dragging && (abs(self.mouse-x - root.grab-offset) > 5px * Theme.ui-scale
                    || self.mouse-y < -6px * Theme.ui-scale || self.mouse-y > root.height + 6px * Theme.ui-scale)) {
                    root.dragging = true;
                    root.drag-began(root.grab-id);
                }
                // Drop-to-split / cross-pane merge hints only during a real drag.
                // Firing on every press (even a click) painted a stuck tab-strip
                // insertion caret at the pointer (#122).
                if (root.dragging) {
                    root.drag-moved(self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                    // Reorder within the strip only while the cursor stays on the strip
                    // row; once it drops into a pane body we hand off to drag-to-split.
                    // Hop count from cursor drift (half-slot threshold); one callback
                    // can cross several tabs so a fast swipe keeps up with the pointer.
                    if (root.hop-unit > 0px
                        && self.mouse-y > -10px * Theme.ui-scale && self.mouse-y < root.height + 10px * Theme.ui-scale) {
                        hops = floor(
                            ((self.mouse-x - root.grab-offset) + root.hop-unit / 2)
                                / root.hop-unit);
                        if (hops != 0) {
                            root.reorder(root.grab-id, hops);
                            root.grab-offset += hops * root.hop-unit;
                        }
                    }
                }
            }
        }
        double-clicked => {
            if (root.info.kind != "welcome") { root.duplicated(); }
        }
        scroll-event(ev) => {
            // Prefer genuine horizontal deltas; otherwise map vertical wheel to
            // horizontal pan (typical mouse wheel on a tab strip).
            root.wheel(abs(ev.delta-x) > abs(ev.delta-y) ? ev.delta-x : ev.delta-y);
            return accept;
        }
    }

    // Connection-type icon (left of the status dot).
    Text {
        x: root.icon-x;
        y: (parent.height - self.preferred-height) / 2;
        text: root.conn-icon;
        font-family: "Material Icons";
        font-size: root.tab-icon-size;
        color: active ? Theme.text-primary : Theme.text-secondary;
    }

    // Status indicator — green when live, amber pulse while connecting,
    // muted on a normal disconnect, red only on failure.
    Rectangle {
        x: root.dot-x;
        y: (parent.height - self.height) / 2;
        width: root.tab-dot-size;
        height: root.tab-dot-size;
        border-radius: root.tab-dot-size / 2;
        background: info.kind == "welcome" ? Theme.text-muted
            : info.conn-state == 1 ? Theme.success
            : info.conn-state == 0 ? Theme.warning
            : info.conn-state == 3 ? Theme.danger
            : Theme.text-muted;
        opacity: info.kind != "welcome" && info.conn-state == 0
            ? (0.35 + 0.65 * abs(sin(360deg * animation-tick() / 1.4s)))
            : 1.0;
    }

    title-box := Rectangle {
        x: root.title-x;
        width: root.title-w;
        height: parent.height;
        clip: true;
        // Natural text height (not height:100%) so FemtoVG won't visually
        // scale glyphs differently for short vs long / elided titles.
        title-text := Text {
            width: parent.width;
            y: (parent.height - self.preferred-height) / 2;
            text: info.title;
            color: active ? Theme.text-primary : Theme.text-secondary;
            font-family: Theme.ui-font-family;
            font-size: Theme.fs-sm;
            wrap: no-wrap;
            overflow: elide;
        }
    }

    if root.show-close: IconButton {
        glyph: "×";
        size: root.tab-close-size;
        x: parent.width - root.tab-pad-right - root.tab-close-size + 1px * Theme.ui-scale;
        y: (parent.height - self.height) / 2;
        clicked => { root.closed(); }
    }
}

// --- Tab context-menu item -------------------------------------------------
component TabMenuItem inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    // When true, `hint` is a Material Icons codepoint (e.g. submenu chevron).
    in property <bool> hint-icon: false;
    // Shared column widths from the parent menu (0 = hug this row's content).
    // Menu width = max(labels) + hint-gap + max(hints), not max(per-row sums).
    in property <length> label-col-width: 0px;
    in property <length> hint-col-width: 0px;
    in property <length> hint-gap: 28px * Theme.ui-scale;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    // Highlight as hovered even when the pointer is over a flyout submenu.
    in property <bool> force-hover: false;
    callback clicked();
    callback hovered(bool);
    // Parent-supplied hint column, or this row has its own shortcut/icon.
    property <bool> has-hint-col: root.hint-col-width > 0px || root.hint != "" || root.hint-icon;
    height: 28px * Theme.ui-scale;
    clip: true;
    border-radius: Theme.radius-sm;
    background: enabled && (ta.has-hover || root.force-hover) ? Theme.bg-hover : transparent;
    HorizontalLayout {
        width: 100%;
        padding-left: 10px * Theme.ui-scale;
        padding-right: 10px * Theme.ui-scale;
        spacing: 0px;
        label-txt := Text {
            text: label;
            color: enabled
                ? (danger ? Theme.danger : Theme.text-primary)
                : Theme.text-muted;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            horizontal-stretch: 0;
            width: root.label-col-width > 0px ? root.label-col-width : self.preferred-width;
        }
        // Fixed gap between the label column and the shortcut/icon column.
        if root.has-hint-col: Rectangle {
            width: root.hint-gap;
            horizontal-stretch: 0;
        }
        if root.has-hint-col: hint-txt := Text {
            text: hint;
            color: Theme.text-muted;
            font-family: root.hint-icon ? "Material Icons" : Theme.ui-font-family;
            font-size: root.hint-icon ? Theme.fs-md : Theme.fs-xs;
            vertical-alignment: center;
            horizontal-alignment: right;
            horizontal-stretch: 0;
            width: root.hint-col-width > 0px
                ? root.hint-col-width
                : max(self.preferred-width, root.hint-icon ? Theme.fs-md : 0px);
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => { root.hovered(self.has-hover); }
    }
}

// --- TabBar ----------------------------------------------------------------
export component TabBar inherits Rectangle {
    in property <[TabInfo]> tabs;
    in property <string> active-id;
    in property <bool> can-merge-pane: false;
    // Optional right inset (toolbar icons are in the title bar now; usually 0).
    in property <length> reserve-right: 0px;
    callback tab-selected(string);
    callback tab-closed(string);
    // Drag-to-reorder: move `tab-id` by `dir` slots (#v0.5).
    callback tab-reorder(string /* tab-id */, int /* dir */);
    // Split this pane, peeling `tab-id` into a new pane on `dir` (#v0.5).
    callback tab-split(string /* tab-id */, string /* dir */);
    // Open another connection to the same session as `tab-id` (#v0.5).
    callback tab-duplicate(string /* tab-id */);
    callback tab-close-others(string /* tab-id */);
    callback tab-close-left(string /* tab-id */);
    callback tab-close-right(string /* tab-id */);
    callback tab-close-all();
    callback tab-find(string /* tab-id */);
    callback tab-clear(string /* tab-id */);
    callback tab-save-output(string /* tab-id */);
    callback tab-set-backspace-mode(string /* tab-id */, string /* mode */);
    callback merge-pane();
    // Drag-to-split (#v0.5): cursor moved / dropped while dragging `tab-id`, in
    // absolute (window) coordinates.
    callback tab-drag-move(string /* tab-id */, length /* abs-x */, length /* abs-y */);
    callback tab-drag-drop(string /* tab-id */, length /* abs-x */, length /* abs-y */);

    // Right-click context-menu state.
    property <length> menu-x;
    property <length> menu-y;
    property <string> menu-target;
    property <int> menu-target-index;
    property <bool> can-close-left:
        root.menu-target-index > 0
        && (root.menu-target-index > 1 || root.tabs[0].id != "welcome");
    property <bool> can-close-right:
        root.menu-target-index < root.tabs.length - 1
        && (root.menu-target-index < root.tabs.length - 2
            || root.tabs[root.tabs.length - 1].id != "welcome");
    property <bool> can-close-others:
        root.menu-target != "welcome"
        && (root.tabs.length > 2
            || (root.tabs.length == 2 && root.tabs[0].id != "welcome"
                && root.tabs[1].id != root.menu-target));
    property <bool> can-close-all:
        root.tabs.length > 1
        || (root.tabs.length == 1 && root.tabs[0].id != "welcome");
    // Current Backspace mode of the right-clicked tab (for submenu checkmarks).
    property <string> menu-backspace-mode:
        root.menu-target-index >= 0 && root.menu-target-index < root.tabs.length
            ? root.tabs[root.menu-target-index].backspace-mode
            : "auto";
    // Flyout submenu: stay open while the trigger OR the panel is hovered
    // (classic context-menu behavior; no second PopupWindow). A short close
    // timer bridges the gap when the pointer travels trigger → panel.
    property <bool> bs-trigger-hover: false;
    property <bool> bs-panel-hover: false;
    property <bool> bs-submenu-armed: false;
    property <bool> backspace-submenu-open:
        root.menu-target != "welcome" && root.bs-submenu-armed;
    // Tab currently being drag-reordered (highlight + id for drag-move/drop).
    property <string> drag-id;

    function arm-backspace-submenu() {
        bs-close-timer.running = false;
        root.bs-submenu-armed = true;
    }

    function dismiss-backspace-submenu() {
        bs-close-timer.running = false;
        root.bs-trigger-hover = false;
        root.bs-panel-hover = false;
        root.bs-submenu-armed = false;
    }

    function schedule-dismiss-backspace-submenu() {
        if (root.bs-trigger-hover || root.bs-panel-hover) {
            bs-close-timer.running = false;
            return;
        }
        bs-close-timer.running = false;
        bs-close-timer.running = true;
    }

    bs-close-timer := Timer {
        interval: 150ms;
        running: false;
        triggered => {
            self.running = false;
            if (!root.bs-trigger-hover && !root.bs-panel-hover) {
                root.bs-submenu-armed = false;
            }
        }
    }

    height: 36px * Theme.ui-scale;
    background: Theme.bg-panel-alt;

    // True when tabs are wider than the flickable strip (#122).
    // 34px ≈ all-tabs button + padding/spacing. Overlay chrome must not sit in
    // the layout tree or it feeds back into width / preferred-size.
    property <bool> tab-overflow:
        strip.preferred-width > root.width - root.reserve-right - 34px * Theme.ui-scale;
    property <length> tab-scroll-range:
        max(0px, flick.viewport-width - flick.width);

    // Pan the strip horizontally. Vertical mouse-wheel deltas are treated as
    // horizontal so a normal wheel can move the overflow scrollbar thumb.
    function scroll-strip(delta: length) {
        if (root.tab-scroll-range <= 0px || delta == 0px) { return; }
        flick.viewport-x = clamp(
            flick.viewport-x + delta, -root.tab-scroll-range, 0px);
    }

    HorizontalLayout {
        padding-bottom: 3px * Theme.ui-scale;
        padding-top: 3px * Theme.ui-scale;
        padding-left: 2px * Theme.ui-scale;
        padding-right: 3px * Theme.ui-scale;
        spacing: 2px * Theme.ui-scale;
        cross-axis-alignment: center;

        // Horizontally-scrollable strip; overflow uses the overlay scrollbar
        // (and mouse-wheel / trackpad scroll). `interactive: false` so pressing
        // a tab drags the tab, not the viewport — only the scrollbar thumb
        // pans by pointer-drag; wheel is handled explicitly below (#122).
        flick := Flickable {
            interactive: false;
            horizontal-stretch: 1;
            viewport-height: self.height;
            viewport-width: max(self.width, strip.preferred-width);
            // Behind the tabs: wheel over empty strip padding still pans.
            TouchArea {
                width: flick.viewport-width;
                height: 100%;
                scroll-event(ev) => {
                    root.scroll-strip(
                        abs(ev.delta-x) > abs(ev.delta-y) ? ev.delta-x : ev.delta-y);
                    return accept;
                }
            }
            strip := HorizontalLayout {
                spacing: 2px * Theme.ui-scale;
                alignment: start;
                for tab[i] in tabs: SingleTab {
                    info: tab;
                    active: tab.id == root.active-id;
                    drag-highlight: tab.id == root.drag-id;
                    selected => { root.tab-selected(tab.id); }
                    closed => { root.tab-closed(tab.id); }
                    duplicated => { root.tab-duplicate(tab.id); }
                    reorder(id, dir) => { root.tab-reorder(id, dir); }
                    drag-began(id) => { root.drag-id = id; }
                    drag-ended => { root.drag-id = ""; }
                    context-requested(ax, ay) => {
                        root.menu-target = tab.id;
                        root.menu-target-index = i;
                        root.menu-x = ax - root.absolute-position.x;
                        root.menu-y = ay - root.absolute-position.y;
                        root.dismiss-backspace-submenu();
                        tab-menu.show();
                    }
                    // Prefer the frozen drag-id so move/drop stay on the grabbed
                    // tab after in-place row swaps change this repeater's `tab`.
                    drag-moved(ax, ay) => {
                        root.tab-drag-move(root.drag-id != "" ? root.drag-id : tab.id, ax, ay);
                    }
                    drag-dropped(ax, ay) => {
                        root.tab-drag-drop(root.drag-id != "" ? root.drag-id : tab.id, ax, ay);
                    }
                    wheel(delta) => { root.scroll-strip(delta); }
                }
            }
        }

        // A stable right-edge entry point for finding any open session when
        // the tab strip is crowded (#340).
        // Match SingleTab height (30px) so the layout cross-axis fills evenly;
        // IconButton centers its glyph internally (y on a layout child is ignored).
        IconButton {
            glyph: all-tabs-menu.is-open ? "\u{E316}" : "\u{E313}";
            font-family: "Material Icons";
            size: 25px * Theme.ui-scale;
            clicked => {
                if (all-tabs-menu.is-open) {
                    all-tabs-menu.close();
                } else {
                    all-tabs-menu.show();
                }
            }
        }

        // Optional right inset from the parent (toolbar icons are in the title bar).
        Rectangle {
            width: root.reserve-right;
        }
    }

    // Horizontal scrollbar overlay along the bottom of the flickable — matches
    // the terminal scrollbar colors; stays thin like ScrollView until hovered so
    // it does not cover tab titles or change TabBar height. Only this track
    // pans the strip; tab bodies keep their own TouchArea for drag-reorder.
    if root.tab-overflow: sb := Rectangle {
        x: flick.absolute-position.x - root.absolute-position.x + 4px * Theme.ui-scale;
        width: max(0px, flick.width - 8px * Theme.ui-scale);
        property <bool> expanded: track-ta.has-hover || track-ta.pressed;
        // Idle: slim like std ScrollView; hover: terminal-scrollbar thickness.
        height: self.expanded ? 8px * Theme.ui-scale : 3px * Theme.ui-scale;
        y: root.height - self.height - 1px * Theme.ui-scale;
        animate height { duration: 100ms; }
        property <length> thumb-w:
            max(28px * Theme.ui-scale, self.width * flick.width / max(1px * Theme.ui-scale, flick.viewport-width));
        property <length> usable: max(1px * Theme.ui-scale, self.width - self.thumb-w);
        track-ta := TouchArea {
            mouse-cursor: default;
            moved => {
                if (self.pressed && root.tab-scroll-range > 0px) {
                    flick.viewport-x = -clamp(
                        (self.mouse-x - sb.thumb-w / 2) / sb.usable, 0.0, 1.0)
                        * root.tab-scroll-range;
                }
            }
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left
                    && root.tab-scroll-range > 0px) {
                    flick.viewport-x = -clamp(
                        (self.mouse-x - sb.thumb-w / 2) / sb.usable, 0.0, 1.0)
                        * root.tab-scroll-range;
                }
            }
            scroll-event(ev) => {
                root.scroll-strip(
                    abs(ev.delta-x) > abs(ev.delta-y) ? ev.delta-x : ev.delta-y);
                return accept;
            }
        }

        Rectangle {
            x: root.tab-scroll-range > 0px
                ? (parent.width - self.width) * (-flick.viewport-x / root.tab-scroll-range)
                : 0px;
            y: (parent.height - self.height) / 2;
            width: sb.thumb-w;
            height: sb.expanded ? 6px * Theme.ui-scale : 2px * Theme.ui-scale;
            border-radius: sb.expanded ? 3px * Theme.ui-scale : 1px * Theme.ui-scale;
            background: sb.expanded
                ? Theme.text-secondary : Theme.border-strong;
            animate height { duration: 100ms; }
            animate background { duration: 100ms; }
        }
    }

    all-tabs-menu := PopupWindow {
        x: max(4px * Theme.ui-scale, root.width - root.reserve-right - self.width - 4px * Theme.ui-scale);
        y: root.height;
        width: 230px * Theme.ui-scale;
        height: min(308px * Theme.ui-scale, root.tabs.length * 29px * Theme.ui-scale + 8px * Theme.ui-scale);
        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px * Theme.ui-scale;
            border-color: Theme.border-strong;
            drop-shadow-blur: 12px * Theme.ui-scale;
            drop-shadow-color: #00000060;
            clip: true;
            Flickable {
                x: 4px * Theme.ui-scale;
                y: 4px * Theme.ui-scale;
                width: parent.width - 8px * Theme.ui-scale;
                height: parent.height - 8px * Theme.ui-scale;
                viewport-width: self.width;
                viewport-height: max(self.height, all-tabs-list.preferred-height);
                all-tabs-list := VerticalLayout {
                    width: parent.width;
                    spacing: 1px * Theme.ui-scale;
                    for tab in root.tabs: TabMenuItem {
                        width: parent.width;
                        label: (tab.id == root.active-id ? "●  " : "    ") + tab.title;
                        clicked => {
                            root.tab-selected(tab.id);
                            all-tabs-menu.close();
                        }
                    }
                }
            }
        }
    }

    // Right-click context menu (v0.5): split this pane by peeling the clicked tab
    // into a new pane. Splitting needs at least two tabs so the source pane survives.
    // Backspace mode uses an in-popup flyout (hover to open) — not a second
    // PopupWindow — so the parent menu stays open like a normal OS/context menu.
    tab-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        // Column widths: max(labels) + gap + max(hints). Grow right only when
        // the Backspace flyout opens so the primary card does not shift.
        property <length> flyout-overlap: 4px * Theme.ui-scale;
        property <length> menu-hint-gap: 28px * Theme.ui-scale;
        property <length> menu-label-w: max(m-l-close.preferred-width,
            max(m-l-close-others.preferred-width,
            max(m-l-close-left.preferred-width,
            max(m-l-close-right.preferred-width,
            max(m-l-close-all.preferred-width,
            max(m-l-find.preferred-width,
            max(m-l-save.preferred-width,
            max(m-l-clear.preferred-width,
            max(m-l-bs.preferred-width,
            max(m-l-dup.preferred-width,
            max(m-l-split-r.preferred-width,
            max(m-l-split-d.preferred-width,
                m-l-merge.preferred-width))))))))))));
        property <length> menu-hint-w: max(m-h-find.preferred-width, m-h-chevron.preferred-width);
        property <length> bs-label-w: max(m-bs-l-auto.preferred-width,
            max(m-bs-l-del.preferred-width, m-bs-l-bs.preferred-width));
        property <length> bs-hint-w: m-bs-h-check.preferred-width;
        width: tab-menu-card.width
            + (root.backspace-submenu-open
                ? max(0px, bs-panel.width - self.flyout-overlap)
                : 0px);
        height: tab-menu-card.preferred-height;

        // Off-screen probes for locale-aware column widths.
        Rectangle {
            x: -10000px;
            y: -10000px;
            width: 0px;
            height: 0px;
            clip: true;
            VerticalLayout {
                m-l-close := Text { text: @tr("Close tab"); font-size: Theme.fs-sm; }
                m-l-close-others := Text { text: @tr("Close other tabs"); font-size: Theme.fs-sm; }
                m-l-close-left := Text { text: @tr("Close tabs to the left"); font-size: Theme.fs-sm; }
                m-l-close-right := Text { text: @tr("Close tabs to the right"); font-size: Theme.fs-sm; }
                m-l-close-all := Text { text: @tr("Close all tabs"); font-size: Theme.fs-sm; }
                m-l-find := Text { text: @tr("Find in terminal"); font-size: Theme.fs-sm; }
                m-l-save := Text { text: @tr("Save terminal output"); font-size: Theme.fs-sm; }
                m-l-clear := Text { text: @tr("Clear screen"); font-size: Theme.fs-sm; }
                m-l-bs := Text { text: @tr("Backspace mode"); font-size: Theme.fs-sm; }
                m-l-dup := Text { text: @tr("Duplicate connection"); font-size: Theme.fs-sm; }
                m-l-split-r := Text { text: @tr("Split right"); font-size: Theme.fs-sm; }
                m-l-split-d := Text { text: @tr("Split down"); font-size: Theme.fs-sm; }
                m-l-merge := Text { text: @tr("Cancel split"); font-size: Theme.fs-sm; }
                m-h-find := Text {
                    text: Theme.is-mac ? "⌘⇧F" : "Ctrl+Shift+F";
                    font-size: Theme.fs-xs;
                    font-family: Theme.ui-font-family;
                }
                m-h-chevron := Text {
                    text: "\u{E5CC}";
                    font-family: "Material Icons";
                    font-size: Theme.fs-md;
                }
                m-bs-l-auto := Text { text: @tr("Auto"); font-size: Theme.fs-sm; }
                m-bs-l-del := Text { text: @tr("DEL (0x7F)"); font-size: Theme.fs-sm; }
                m-bs-l-bs := Text { text: @tr("BS (0x08)"); font-size: Theme.fs-sm; }
                m-bs-h-check := Text {
                    text: "\u{E5CA}";
                    font-family: "Material Icons";
                    font-size: Theme.fs-md;
                }
            }
        }

        tab-menu-card := Rectangle {
            x: 0px;
            width: tab-menu-list.preferred-width;
            background: Theme.popup-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px * Theme.ui-scale;
            border-color: Theme.border-strong;
            drop-shadow-blur: 12px * Theme.ui-scale;
            drop-shadow-color: #00000060;
            tab-menu-list := VerticalLayout {
                padding: 4px * Theme.ui-scale;
                spacing: 1px * Theme.ui-scale;
                TabMenuItem {
                    label: @tr("Close tab");
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    enabled: root.menu-target != "welcome";
                    hovered(h) => { if (h) { root.dismiss-backspace-submenu(); } }
                    clicked => { root.tab-closed(root.menu-target); tab-menu.close(); }
                }

                TabMenuItem {
                    label: @tr("Close other tabs");
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    enabled: root.can-close-others;
                    hovered(h) => { if (h) { root.dismiss-backspace-submenu(); } }
                    clicked => { root.tab-close-others(root.menu-target); tab-menu.close(); }
                }

                TabMenuItem {
                    label: @tr("Close tabs to the left");
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    enabled: root.can-close-left;
                    hovered(h) => { if (h) { root.dismiss-backspace-submenu(); } }
                    clicked => { root.tab-close-left(root.menu-target); tab-menu.close(); }
                }

                TabMenuItem {
                    label: @tr("Close tabs to the right");
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    enabled: root.can-close-right;
                    hovered(h) => { if (h) { root.dismiss-backspace-submenu(); } }
                    clicked => { root.tab-close-right(root.menu-target); tab-menu.close(); }
                }

                TabMenuItem {
                    label: @tr("Close all tabs");
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    danger: true;
                    enabled: root.can-close-all;
                    hovered(h) => { if (h) { root.dismiss-backspace-submenu(); } }
                    clicked => { root.tab-close-all(); tab-menu.close(); }
                }

                Rectangle {
                    height: 1px * Theme.ui-scale;
                    background: Theme.border-subtle;
                }

                TabMenuItem {
                    label: @tr("Find in terminal");
                    hint: Theme.is-mac ? "⌘⇧F" : "Ctrl+Shift+F";
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    enabled: root.menu-target != "welcome";
                    hovered(h) => { if (h) { root.dismiss-backspace-submenu(); } }
                    clicked => { root.tab-find(root.menu-target); tab-menu.close(); }
                }

                TabMenuItem {
                    label: @tr("Save terminal output");
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    enabled: root.menu-target != "welcome";
                    hovered(h) => { if (h) { root.dismiss-backspace-submenu(); } }
                    clicked => { root.tab-save-output(root.menu-target); tab-menu.close(); }
                }

                TabMenuItem {
                    label: @tr("Clear screen");
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    danger: true;
                    enabled: root.menu-target != "welcome";
                    hovered(h) => { if (h) { root.dismiss-backspace-submenu(); } }
                    clicked => { root.tab-clear(root.menu-target); tab-menu.close(); }
                }

                Rectangle {
                    height: 1px * Theme.ui-scale;
                    background: Theme.border-subtle;
                }

                bs-trigger := TabMenuItem {
                    label: @tr("Backspace mode");
                    hint: "\u{E5CC}";
                    hint-icon: true;
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    enabled: root.menu-target != "welcome";
                    force-hover: root.backspace-submenu-open;
                    hovered(h) => {
                        if (root.menu-target == "welcome") { return; }
                        root.bs-trigger-hover = h;
                        if (h) {
                            root.arm-backspace-submenu();
                        } else {
                            root.schedule-dismiss-backspace-submenu();
                        }
                    }
                    // Click still opens (touch / accessibility); hover is primary.
                    clicked => { root.arm-backspace-submenu(); }
                }

                Rectangle {
                    height: 1px * Theme.ui-scale;
                    background: Theme.border-subtle;
                }

                TabMenuItem {
                    label: @tr("Duplicate connection");
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    enabled: root.menu-target != "welcome";
                    hovered(h) => { if (h) { root.dismiss-backspace-submenu(); } }
                    clicked => { root.tab-duplicate(root.menu-target); tab-menu.close(); }
                }

                Rectangle {
                    height: 1px * Theme.ui-scale;
                    background: Theme.border-subtle;
                }

                TabMenuItem {
                    label: @tr("Split right");
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    enabled: root.tabs.length > 1;
                    hovered(h) => { if (h) { root.dismiss-backspace-submenu(); } }
                    clicked => { root.tab-split(root.menu-target, "right"); tab-menu.close(); }
                }

                TabMenuItem {
                    label: @tr("Split down");
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    enabled: root.tabs.length > 1;
                    hovered(h) => { if (h) { root.dismiss-backspace-submenu(); } }
                    clicked => { root.tab-split(root.menu-target, "down"); tab-menu.close(); }
                }

                TabMenuItem {
                    label: @tr("Cancel split");
                    label-col-width: tab-menu.menu-label-w;
                    hint-col-width: tab-menu.menu-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    enabled: root.can-merge-pane;
                    hovered(h) => { if (h) { root.dismiss-backspace-submenu(); } }
                    clicked => { root.merge-pane(); tab-menu.close(); }
                }
            }
        }

        // Flyout always exists so the popup can bind its width; visibility
        // tracks `backspace-submenu-open`. Overlaps the primary card so the
        // pointer can travel from trigger → panel without closing.
        bs-panel := Rectangle {
            x: tab-menu-card.width - tab-menu.flyout-overlap;
            y: bs-trigger.y;
            width: bs-panel-list.preferred-width;
            height: bs-panel-list.preferred-height;
            visible: root.backspace-submenu-open;
            background: Theme.popup-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px * Theme.ui-scale;
            border-color: Theme.border-strong;
            drop-shadow-blur: 12px * Theme.ui-scale;
            drop-shadow-color: #00000060;

            // Underlay first so menu items (drawn later) still receive clicks;
            // has-hover stays true while the pointer is anywhere on the panel.
            TouchArea {
                enabled: root.backspace-submenu-open;
                changed has-hover => {
                    root.bs-panel-hover = self.has-hover;
                    if (self.has-hover) {
                        root.arm-backspace-submenu();
                    } else {
                        root.schedule-dismiss-backspace-submenu();
                    }
                }
            }

            bs-panel-list := VerticalLayout {
                padding: 4px * Theme.ui-scale;
                spacing: 1px * Theme.ui-scale;
                TabMenuItem {
                    label: @tr("Auto");
                    hint: root.menu-backspace-mode == "auto" ? "\u{E5CA}" : "";
                    hint-icon: true;
                    label-col-width: tab-menu.bs-label-w;
                    hint-col-width: tab-menu.bs-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    hovered(h) => {
                        root.bs-panel-hover = h;
                        if (h) {
                            root.arm-backspace-submenu();
                        } else {
                            root.schedule-dismiss-backspace-submenu();
                        }
                    }
                    clicked => {
                        root.tab-set-backspace-mode(root.menu-target, "auto");
                        root.dismiss-backspace-submenu();
                        tab-menu.close();
                    }
                }

                TabMenuItem {
                    label: @tr("DEL (0x7F)");
                    hint: root.menu-backspace-mode == "del" ? "\u{E5CA}" : "";
                    hint-icon: true;
                    label-col-width: tab-menu.bs-label-w;
                    hint-col-width: tab-menu.bs-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    hovered(h) => {
                        root.bs-panel-hover = h;
                        if (h) {
                            root.arm-backspace-submenu();
                        } else {
                            root.schedule-dismiss-backspace-submenu();
                        }
                    }
                    clicked => {
                        root.tab-set-backspace-mode(root.menu-target, "del");
                        root.dismiss-backspace-submenu();
                        tab-menu.close();
                    }
                }

                TabMenuItem {
                    label: @tr("BS (0x08)");
                    hint: root.menu-backspace-mode == "bs" ? "\u{E5CA}" : "";
                    hint-icon: true;
                    label-col-width: tab-menu.bs-label-w;
                    hint-col-width: tab-menu.bs-hint-w;
                    hint-gap: tab-menu.menu-hint-gap;
                    hovered(h) => {
                        root.bs-panel-hover = h;
                        if (h) {
                            root.arm-backspace-submenu();
                        } else {
                            root.schedule-dismiss-backspace-submenu();
                        }
                    }
                    clicked => {
                        root.tab-set-backspace-mode(root.menu-target, "bs");
                        root.dismiss-backspace-submenu();
                        tab-menu.close();
                    }
                }
            }
        }
    }
}
