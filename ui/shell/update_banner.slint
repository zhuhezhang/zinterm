import { Theme } from "../shared/theme.slint";

export component UpdateBanner inherits Rectangle {
    callback open-update-url();
    in-out property <bool> update-available: false;
    in property <string> update-version;

    // --- Update-available banner (#48) ------------------------------------
    // A dismissible top-centre banner; the app stays usable on the current
    // version. "Download" opens the GitHub release page in the browser.
    if root.update-available: Rectangle {
        x: (parent.width - 384px) / 2;
        y: 8px;
        width: 384px;
        height: 38px;
        background: Theme.accent;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000060;
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 5px;
            HorizontalLayout {
                spacing: 2px;
                Text {
                    text: "\u{E004}";
                    font-family: "Material Icons";
                    color: #ffffff;
                    font-size: Theme.fs-lg;
                    vertical-alignment: center;
                }

                Text {
                    text: @tr("Update available:") + " " + root.update-version;
                    color: #ffffff;
                    font-size: Theme.fs-sm;
                    font-family: Theme.ui-font-family;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            Rectangle {
                width: 68px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-sm;
                background: upd-dl-ta.has-hover ? #ffffff45 : #ffffff28;
                upd-dl-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-update-url(); }
                }

                Text {
                    text: @tr("Download");
                    color: #ffffff;
                    font-size: Theme.fs-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // close update panel button
            Rectangle {
                width: 26px;
                height: 26px;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius-sm;
                background: upd-cl-ta.has-hover ? #ffffff45 : transparent;
                upd-cl-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.update-available = false; }
                }

                Text {
                    text: "\u{E5CD}";
                    font-family: "Material Icons";
                    color: #ffffff;
                    font-size: Theme.fs-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
