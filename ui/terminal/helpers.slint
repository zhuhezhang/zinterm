import { Theme } from "../shared/theme.slint";
import { TooltipArea } from "../shared/widgets.slint";

// --- MenuItem --------------------------------------------------------------
// One row of the terminal right-click context menu (MDL2 icon + label).
export component MenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked();

    height: 28px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.bg-hover : transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.icon;
            font-family: "Material Icons";
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.fs-md;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// Compact on/off chip used by the floating find bar (Aa / W / .* ).
export component FindToggle inherits Rectangle {
    in-out property <bool> on: false;
    in property <string> label;
    in property <string> tip;
    callback toggled(bool);

    width: 24px;
    height: 24px;
    border-radius: 3px;
    background: root.on
        ? Theme.accent.with-alpha(0.35)
        : (ta.has-hover ? Theme.bg-hover : transparent);
    border-width: root.on ? 1px : 0;
    border-color: Theme.accent.with-alpha(0.7);

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        color: root.on ? Theme.text-primary : Theme.text-secondary;
        font-size: Theme.fs-sm;
        font-weight: root.on ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TooltipArea {
        mouse-cursor: pointer;
        tooltip-text: root.tip;
        anchor-width: root.width;
        anchor-height: root.height;
        activate => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}
