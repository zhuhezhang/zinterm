import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { QuickCmd } from "../types/terminal.slint";

// Persistent, resizable quick-command panel (#215). It deliberately shares the
// same model/actions as the command-bar popup; docking only adds another view.
export component QuickDockPanel inherits Rectangle {
    in property <[QuickCmd]> commands;
    in property <string> dock-edge: "right";
    callback fill(string /* command */);
    callback run(string /* command */);
    callback edit(int /* orig-index */);
    callback toggle-group(string);
    callback rename-group(string /* group */);
    callback delete-group(string /* group */);
    callback new-group();
    callback manage();
    callback close();
    callback undock();
    callback dock-drag-move(length, length);
    callback dock-drag-end();

    background: Theme.bg-panel;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: 34px;
            background: Theme.bg-panel-alt;
            drag-area := TouchArea {
                mouse-cursor: grab;
                moved => {
                    if (self.pressed) {
                        root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                    }
                }
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.up) { root.dock-drag-end(); }
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 4px;
                spacing: 6px;
                Text {
                    text: "\u{E25D}";
                    font-family: "Material Icons";
                    color: Theme.text-muted;
                    font-size: Theme.fs-md;
                    vertical-alignment: center;
                }

                Text {
                    text: @tr("Quick commands");
                    color: Theme.text-primary;
                    font-size: Theme.fs-sm;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    height: 25px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-sm;
                    background: manage-ta.has-hover ? Theme.bg-hover : Theme.bg-panel-alt;
                    manage-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.manage(); }
                    }

                    Text {
                        text: @tr("Manage…");
                        color: Theme.accent;
                        font-size: Theme.fs-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Close docked panel → restore the command-bar Quick popup
                // without clearing the "as sidebar" setting.
                Rectangle {
                    width: 25px;
                    height: 25px;
                    y: (parent.height - self.height) / 2;
                    background: undock-ta.has-hover ? Theme.bg-hover : transparent;
                    border-radius: Theme.radius-sm;
                    undock-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.undock(); }
                    }

                    Text {
                        text: "\u{E5CD}";
                        font-family: "Material Icons";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 25px;
                    height: 25px;
                    y: (parent.height - self.height) / 2;
                    background: close-ta.has-hover ? Theme.bg-hover : transparent;
                    border-radius: Theme.radius-sm;
                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close(); }
                    }

                    Text {
                        text: root.dock-edge == "right" ? "\u{EAC9}"
                            : root.dock-edge == "top" ? "\u{EACF}"
                            : root.dock-edge == "bottom" ? "\u{EAD0}"
                            : "\u{EAC3}";
                        font-family: "Material Icons";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-md;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ScrollView (not bare Flickable) so a scrollbar appears when the list overflows.
        quick-scroll := ScrollView {
            vertical-stretch: 1;
            viewport-width: self.visible-width;
            scroll-content := VerticalLayout {
                min-height: quick-scroll.visible-height;
                alignment: start;
                height: root.commands.length == 0
                    ? self.min-height
                    : max(self.min-height, list.preferred-height);
                if root.commands.length == 0: VerticalLayout {
                    min-height: scroll-content.min-height;
                    alignment: center;
                    Text {
                        text: @tr("No quick commands yet");
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                list := VerticalLayout {
                    visible: root.commands.length > 0;
                    padding: 6px;
                    spacing: 0px;
                    alignment: start;
                // Pin list height to content so ScrollView does not stretch rows
                // apart when the panel is taller than the command list (#215).
                height: self.preferred-height;
                    for q in root.commands: VerticalLayout {
                        alignment: start;
                        spacing: 0px;
                        property <length> row-h: (q.group-header != "" ? 32px : 0px)
                            + (!q.collapsed && q.orig-index >= 0 ? 32px : 0px);
                        height: row-h > 0px ? row-h + 1px : 0px;
                        if q.group-header != "": Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-sm;
                            background: group-ta.has-hover || dock-grp-menu.is-open ? Theme.bg-hover : transparent;
                            property <length> gmx;
                            property <length> gmy;
                            group-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-group(q.group); }
                                pointer-event(e) => {
                                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                        gmx = self.mouse-x;
                                        gmy = self.mouse-y;
                                        dock-grp-menu.show();
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 4px;
                                Text {
                                    text: q.collapsed ? "\u{E5CC}" : "\u{E5CF}";
                                    font-family: "Material Icons";
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "\u{E2C7}";
                                    font-family: "Material Icons";
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: q.group;
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-sm;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }

                            dock-grp-menu := PopupWindow {
                                x: gmx;
                                y: gmy;
                                width: 150px;
                                height: (q.orig-index == -1 ? 3 : 2) * 30px + 9px;
                                Rectangle {
                                    background: Theme.popup-bg;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.border-strong;
                                    drop-shadow-blur: 10px;
                                    drop-shadow-color: #00000050;
                                    VerticalLayout {
                                        padding: 4px;
                                        spacing: 1px;
                                        Rectangle {
                                            height: 30px;
                                            border-radius: Theme.radius-sm;
                                            background: dg-ren-ta.has-hover ? Theme.bg-hover : transparent;
                                            dg-ren-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.rename-group(q.group); }
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                spacing: 8px;
                                                Text {
                                                    text: "\u{E3C9}";
                                                    font-family: "Material Icons";
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.fs-sm;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: @tr("Rename group");
                                                    color: Theme.text-primary;
                                                    font-size: Theme.fs-md;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }

                                        if q.orig-index == -1: Rectangle {
                                            height: 30px;
                                            border-radius: Theme.radius-sm;
                                            background: dg-del-ta.has-hover ? #cc333320 : transparent;
                                            dg-del-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.delete-group(q.group); }
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                spacing: 8px;
                                                Text {
                                                    text: "\u{E872}";
                                                    font-family: "Material Icons";
                                                    color: #cc3333;
                                                    font-size: Theme.fs-sm;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: @tr("Delete group");
                                                    color: #cc3333;
                                                    font-size: Theme.fs-md;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            height: 30px;
                                            border-radius: Theme.radius-sm;
                                            background: dg-new-ta.has-hover ? Theme.bg-hover : transparent;
                                            dg-new-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.new-group(); }
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                spacing: 8px;
                                                Text {
                                                    text: "\u{E2CC}";
                                                    font-family: "Material Icons";
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.fs-sm;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: @tr("New group");
                                                    color: Theme.text-primary;
                                                    font-size: Theme.fs-md;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if !q.collapsed && q.orig-index >= 0: Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-sm;
                            background: q-fill-ta.has-hover || q-run.has-hover || q-edit.has-hover
                                ? Theme.bg-hover : transparent;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 6px;
                                spacing: 4px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    q-fill-ta := TouchArea {
                                        width: parent.width;
                                        height: parent.height;
                                        mouse-cursor: pointer;
                                        clicked => { root.fill(q.command); }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        padding-left: 2px;
                                        Text {
                                            text: q.name;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-sm;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: q.summary;
                                            color: Theme.text-muted;
                                            font-size: Theme.fs-xs;
                                            overflow: elide;
                                            font-family: Theme.ui-font-family;
                                        }
                                    }
                                }

                                // Run (▶) — execute immediately.
                                Rectangle {
                                    width: 24px;
                                    y: (parent.height - self.height) / 2;
                                    height: 28px;
                                    border-radius: Theme.radius-sm;
                                    background: q-run.has-hover ? Theme.accent.with-alpha(0.25) : transparent;
                                    q-run := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.run(q.command); }
                                    }

                                    Text {
                                        text: "\u{E037}";
                                        font-family: "Material Icons";
                                        color: Theme.accent;
                                        font-size: Theme.fs-md;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Edit (✎) — open this command in the editor.
                                Rectangle {
                                    width: 24px;
                                    y: (parent.height - self.height) / 2;
                                    height: 28px;
                                    border-radius: Theme.radius-sm;
                                    background: q-edit.has-hover ? Theme.bg-elevated : transparent;
                                    q-edit := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.edit(q.orig-index); }
                                    }

                                    Text {
                                        text: "\u{E3C9}";
                                        font-family: "Material Icons";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-sm;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            viewport-height: max(self.visible-height, scroll-content.preferred-height);
        }
    }
}
